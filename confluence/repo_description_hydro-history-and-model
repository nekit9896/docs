   ```sql
   UPDATE watermarks
   SET state_json = ?, lease_until = ?, updated_at = now()
   WHERE service_name = ?
     AND resource_key = ?
     AND owner_node_id = ?
     AND epoch = ?
     AND lease_until >= now()
   ```
