@Service
@Slf4j
public class DataServiceV2 extends DataServiceBase<AnswerItem, TagValueDto> {
    private static final ObjectMapper objectMapper = new ObjectMapper();
    @Autowired
    public DataServiceV2(Evo evo) {
        super(evo);
    }

    @Override
    protected String answerTagName(String normalized, Attributes attribute) {
        return normalized + ":" + attribute;
    }

    @Override
    protected TagValueDto tagValueToValueDto(TagValue tagValue) {
        return HotlinkSessionV2.tagValueToDto(tagValue);
    }

    @Override
    protected AnswerItem constructMsgDto(String tag, Object valueObj) {
        if(valueObj instanceof ConfigurationAttribute metadata) {
            return new AnswerItem(tag, AttributeMapper.mapFromConfigDto(metadata, false), null);
        }

        if(valueObj instanceof TagValue tagValue) {
            return new AnswerItem(tag, tagValueToValueDto(tagValue), null);
        }

        return emptyMsgDto(tag);
    }

    @Override
    protected TagValueDto valueDtoFromMsgDto(AnswerItem msg) {
        return msg.getData() instanceof TagValueDto tagValueDto ? tagValueDto : null;
    }

    @Override
    protected ConfigurationAttribute metaDataFromMsgDto(AnswerItem msg) {
        return msg.getData() instanceof ConfigurationAttribute attribute ? attribute : null;
    }

    @Override
    protected AnswerItem emptyMsgDto(String tag) {
        return new AnswerItem(tag, new TagValueDto(null, 0, 0, true, null, null, 0, 0), null);
    }

    @Override
    protected String getTag(AnswerItem msg) {
        return msg.getTag();
    }

    @Override
    protected long getTs(AnswerItem msg) {
        return valueDtoFromMsgDto(msg).getTs();
    }

    @Override
    protected TnMsg.ValueMsg valueDtoToValueMsg(Tag tag, TagValueDto tagValueDto) {
        return TnMsgConverter.convertToValueMsg(tag, tagValueDto.getValue(), tagValueDto.getTs2(), tagValueDto.isInvalid());
    }

    public static Object deserializeData(String tagName, JsonNode data) {
        try {
            return switch (TagImpl.normalizeTagName(tagName).getValue()) {
                case Value, OutOfService, DefaultValue, ExplicitlyDefault -> parseIncomingTagValueData(data);
                case Address -> objectMapper.treeToValue(data, Address.class);
                case AlertHdl -> objectMapper.treeToValue(data, AlarmHdl.class);
                case General -> objectMapper.treeToValue(data, General.class);
                case Route -> objectMapper.treeToValue(data, Route.class);
                case ViewNode -> objectMapper.treeToValue(data, ViewNode.class);
                case Area -> objectMapper.treeToValue(data, Area.class);
                case MsgConverter -> objectMapper.treeToValue(data, MsgConverter.class);
                case PvRange -> objectMapper.treeToValue(data, PvRange.class);
                default -> throw new UnsupportedOperationException();
            };
        }
        catch (JsonProcessingException e) {
            throw new RuntimeException(e);
        }
    }

    private static Object parseIncomingTagValueData(JsonNode data) throws JsonProcessingException {

        TagValueRawDto tagValueRawDto = objectMapper.treeToValue(data, TagValueRawDto.class);
        TagValueDto dto = new TagValueDto();
        dto.setValue(tagValueRawDto.getValue());

        Long ts = getMillisFromObject(tagValueRawDto.getTs());
        if (ts != null) {
            dto.setTs(ts);
        }

        Long ts2 = getMillisFromObject(tagValueRawDto.getTs2());
        if (ts2 != null) {
            dto.setTs2(ts2);
        }

        Boolean invalid = objectToBoolean(tagValueRawDto.getInvalid());
        if (invalid != null) {
            dto.setInvalid(invalid);
        }

        String service = Objects.toString(tagValueRawDto.getService());
        dto.setService(service);

        String user = Objects.toString(tagValueRawDto.getUser());
        dto.setUser(user);

        Long status = getStatus(tagValueRawDto.getStatus());
        if (status != null) {
            dto.setStatus(status);
        }

        String quality = Objects.toString(tagValueRawDto.getQuality());
        dto.setQuality(quality);

        dto.setValue(tagValueRawDto.getValue());
        return dto;
    }

    private static Long getMillisFromObject(Object rawTs) {
        if (rawTs == null) {
            return null;
        }
        if (rawTs instanceof String str && str.isBlank()) {
            return null;
        }
        Long ts = objectToTimeInMillis(rawTs);
        if (ts == null) {
            throw new BadRequestException("Cannot cast to timestamp: " + rawTs);
        }
        return ts;
    }

    private static Long getStatus(Object status) {
        if (status == null) {
            return null;
        }
        if (status instanceof String str && str.isBlank()) {
            return null;
        }
        Long ts = objectToLong(status);
        if (ts == null) {
            throw new BadRequestException("Cannot cast to timestamp: " + status);
        }
        return ts;
    }
}


