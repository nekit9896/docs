package tnt.tnscada.hmi.controller;

import com.google.gson.Gson;
import com.google.gson.JsonArray;
import com.google.gson.JsonSyntaxException;
import jakarta.servlet.http.HttpServletRequest;
import org.apache.commons.lang3.StringUtils;
import tnt.tnscada.hmi.errors.BadRequestException;
import tnt.tnscada.hmi.utils.RequestUtils;

import java.net.URLDecoder;
import java.util.HashSet;
import java.util.Set;

public class ControllerUtils {
    public static String getUser(String user, HttpServletRequest request) {
        if (!StringUtils.isEmpty(user)){
            return URLDecoder.decode(user);
        } else {
            return RequestUtils.getAnyUserIdentity(request);
        }
    }

    /**
     * null -> null <br>
     *      -> null <br>
     * []   -> empty Set <br>
     * abc  -> BadRequest <br>
     * ["abc","def"] -> OK, non empty Set
     * @param jsonArrayAsString
     * @return
     */
    public static Set<String> getNullableStringsSet(String jsonArrayAsString) {
        if (StringUtils.isBlank(jsonArrayAsString)) {
            return null;
        }
        Set<String> resultSet = new HashSet<>();
        try {
            JsonArray jsonArray = new Gson().fromJson(jsonArrayAsString, JsonArray.class);
            if (jsonArray != null) {
                jsonArray.forEach(e -> resultSet.add(e.getAsString()));
            }
        } catch (JsonSyntaxException e) {
            var parserMessage = e.getCause() != null ? e.getCause().getMessage() : e.getMessage();
            throw new BadRequestException(String.format("Ошибка синтаксиса для массива JSON: %s; Строка для разбора: %s", parserMessage, jsonArrayAsString), e);
        }
        return resultSet;
    }
}



