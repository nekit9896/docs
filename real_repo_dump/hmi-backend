<fieldset id="historyData" class="collapsed"><legend>Просмотр истории, сырые данные</legend>
    <label>Интервал от <input type="datetime-local" id="datetimeHistoryDataStart" step="1"  value="2024-11-21T16:00:00.00" size="40"></label>
    <label>до <input type="datetime-local" id="datetimeHistoryDataFinish" step="1"  value="2024-11-21T19:59:00.00" size="40"></label>
    <button onclick="setHistoryDatesLastMinutes(prompt('Число минут', 30))">⌖ Установить интервал на последние N минут</button><br/>
    <label>Загрузка по <input type="number" step="50" value="100"  id="datetimeHistoryDataStep"> записей</label></br>
    <button onclick="historyDataInitialLoad()">Инициировать просмотр интервала для TagName из таблицы состояний</button>
    <div id="historyDataState"></div>
    <div id="historyDataOutput"></div>
    <button id="historyDataLoadPart" onclick="loadHistoryData()" disabled>Подгрузить порцию</button>
    <button id="historyDataExport" onclick="historyDataExportLoadedToCSV()" disabled>Сохранить видимую часть в CSV</button>
</fieldset>
<div id="togglerPlayer" onclick="toggleFieldset('togglerPlayer', 'historyPlayer')">+</div>
<fieldset id="historyPlayer" class="collapsed"><legend>Плеер истории</legend>
    <button id="switchToHistoryBtn" onclick="switchToHistory()">Переключить в History</button> <button id="switchToLiveBtn" onclick="switchToLive()">Вернуть в Live</button> <span id="historyExtControl" onclick="historyExtControl()">*</span><br/>
    <label>От <input type="datetime-local" id="datetimeStart" step="1"  value="2024-11-21T16:00:00.00" size="40"></label>
    <label>до <input type="datetime-local" id="datetimeFinish" step="1"  value="2024-11-21T19:59:00.00" size="40"></label><br/>
    <label onchange="setMillisPerTick()">Скорость <select id="playbackSpeed" >
        <option value="100" >x0.1</option>
        <option value="200" >x0.2</option>
        <option value="300" >x0.3</option>
