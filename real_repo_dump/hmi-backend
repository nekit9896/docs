RUN curl https://$EVOSCADA_NEXUS_RAW_LOGIN_RO:$EVOSCADA_NEXUS_RAW_PASSWORD_RO@artifacts.tn.tngrp.ru/repository/evoscada-devops-raw/opentelemetry/opentelemetry-javaagent-$OTEL_VERSION.jar --output /usr/local/app/opentelemetry-javaagent.jar

WORKDIR "/usr/local/app/"

ENTRYPOINT ["java", "-XX:MaxRAMPercentage=70.0", "-javaagent:/usr/local/app/opentelemetry-javaagent.jar", "-jar", "ARTIFACT_NAME.ARTIFACT_TYPE"]



