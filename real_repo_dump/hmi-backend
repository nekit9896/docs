package tnt.tnscada.hmi.proto;

import com.google.protobuf.InvalidProtocolBufferException;
import com.google.protobuf.Message;
import com.google.protobuf.MessageOrBuilder;
import com.google.protobuf.util.JsonFormat;
import tnt.tnscada.hmi.errors.ValueConversionException;

public class ProtoConverter {
    private final static JsonFormat.Printer printer = JsonFormat.printer();
    private final static JsonFormat.Parser parser =  JsonFormat.parser();

    public static String toJson(MessageOrBuilder msg){
        try {
            return printer.print(msg);
        } catch (InvalidProtocolBufferException e) {
            throw new ValueConversionException(e.getMessage());
        }
    }

    public static Message.Builder toMsg(String json, Message.Builder builder) {
        try {
            parser.merge(json, builder);
        } catch (InvalidProtocolBufferException e) {
            throw new ValueConversionException(e.getMessage());
        }

        return builder;
    }
}



