package tnt.tnscada.hmi.modelling;

import java.util.concurrent.atomic.AtomicReference;
import lombok.val;
import org.apache.kafka.clients.producer.Callback;
import org.apache.kafka.clients.producer.Producer;
import org.apache.kafka.clients.producer.ProducerRecord;
import org.apache.kafka.clients.producer.RecordMetadata;
import org.jetbrains.annotations.NotNull;
import tnt.tnscada.core.kafkamanager.kafka.KafkaTnMsgSender;
import tnt.tnscada.core.kafkamanager.sorting.IndexBuilder;
import tnt.tnscada.core.message.protobuf.TnMsg;
import tnt.tnscada.core.tag.TagInfo;

public class ModellingKafkaTnMsgSender extends KafkaTnMsgSender {
    private final Producer<TnMsg.Key, TnMsg.Msg> producer;
    private final boolean enableCompact;
    private final IndexBuilder indexBuilder = new IndexBuilder();

    private String overriddenKafkaTopic;

    public ModellingKafkaTnMsgSender(
            String overriddenKafkaTopic,
            Producer<TnMsg.Key, TnMsg.Msg> producer,
            boolean enableCompact
    ) {
        super(producer, enableCompact);
        this.producer = producer;
        this.enableCompact = enableCompact;
        this.overriddenKafkaTopic = overriddenKafkaTopic;
    }

    private String resolveTopic(String topic) {
        return overriddenKafkaTopic == null ? topic : overriddenKafkaTopic;
    }

    private String resolveTopicCompact(String topicCompact) {
        return overriddenKafkaTopic == null ? topicCompact : overriddenKafkaTopic + "-compact";
    }

    public void send(String topic, TnMsg.Key key, TnMsg.Msg msg) {
        var resolvedTopic = resolveTopic(topic);
        msg = setIndex(resolvedTopic, msg);
        producer.send(new ProducerRecord<>(resolvedTopic, key, msg));
    }

    public void send(
            String topic,
            TnMsg.Key key,
            TnMsg.Msg msg,
            Callback callback
    ) {
        var resolvedTopic = resolveTopic(topic);
        msg = setIndex(resolvedTopic, msg);
        producer.send(new ProducerRecord<>(resolvedTopic, key, msg), callback);
    }

    public void send2c(
            String topic1,
            String topic2,
            TnMsg.Key key,
            TnMsg.Msg msg,
            Callback callback
    ) {
        var resolvedTopic = resolveTopic(topic1);
        msg = setIndex(resolvedTopic, msg);
        producer.send(new ProducerRecord<>(resolvedTopic, key, msg), callback);

        if (enableCompact) {
            var resolvedCompactTopic = resolveTopicCompact(topic2);
            producer.send(new ProducerRecord<>(resolvedCompactTopic, key, msg), callback);
        }
    }

    public void send(TagInfo tagInfo, TnMsg.Msg msg) {
        TnMsg.Key key = tagInfo.getKey();
        var resolvedTopic = resolveTopic(tagInfo.getTopic());
        msg = setIndex(resolvedTopic, msg);
        producer.send(new ProducerRecord<>(resolvedTopic, key, msg));

        if (enableCompact) {
            var resolvedCompactTopic = resolveTopicCompact(tagInfo.getCompactTopic());
            producer.send(new ProducerRecord<>(resolvedCompactTopic, key, msg));
        }
    }

    public void send(TagInfo tagInfo, TnMsg.Msg msg, Callback callback) {
        TnMsg.Key key = tagInfo.getKey();
        var resolvedTopic = resolveTopic(tagInfo.getTopic());
        msg = setIndex(resolvedTopic, msg);

        AtomicReference<Object> result = new AtomicReference<>(null);

        try {
            producer.send(
                    new ProducerRecord<>(
                            resolvedTopic,
                            null,
                            System.currentTimeMillis(),
                            key,
                            msg
                    ),
                    (r, e) -> joiningCallback(r, e, result, callback)
            );
        } catch (Exception e) {
            joiningCallback(null, e, result, callback);
        }

        if (enableCompact) {
            var resolvedCompactTopic = resolveTopicCompact(tagInfo.getCompactTopic());
            try {
                producer.send(
                        new ProducerRecord<>(resolvedCompactTopic, key, msg),
                        (r, e) -> joiningCallback(r, e, result, callback)
                );
            } catch (Exception e) {
                joiningCallback(null, e, result, callback);
            }
        }
    }

    private void joiningCallback(
            RecordMetadata data, Exception exception,
            AtomicReference<Object> resultHolder, Callback callback
    ) {
        if (!enableCompact) {
            callback.onCompletion(data, exception);
            return;
        }

        if (resultHolder.getAndUpdate(prev -> {
            if (prev == null) {
                return exception != null ? exception : data;
            }

            if (exception != null) {
                if (!(prev instanceof Exception prevException)) {
                    return exception;
                }

                val mid = new Exception(exception.getMessage(), prevException);
                mid.setStackTrace(exception.getStackTrace());
                return new Exception("Send failed for both normal and compact topics", mid);
            }

            return prev instanceof Exception prevException ? prevException : data;
        }) == null) {
            return;
        }

        val result = resultHolder.get();
        callback.onCompletion(result instanceof RecordMetadata r ? r : null, result instanceof Exception e ? e : null);
    }

    private TnMsg.Msg setIndex(String topic, TnMsg.Msg msg) {
        return msg.
                toBuilder()
                .setMsgData(
                        indexBuilder.apply(topic, msg.getMsgData().toBuilder())
                                .build()
                )
                .build();
    }

    public void destroy() {
        producer.flush();
        producer.close();
    }
}


