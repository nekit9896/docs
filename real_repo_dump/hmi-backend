public class HotlinkWebSocketHandlerV2Routed extends AbstractWebSocketHandler {
    private final HotlinkWebSocketHandlerV2 normalHandler;
    private final HotlinkWebSocketHandlerV2Modelling modellingHandler;

    private static HotlinkWebSocketHandlerBase<?> resolveHandler(WebSocketSession session) {
        var handler = (HotlinkWebSocketHandlerBase<?>) session.getAttributes().get("routedHandler");
        return handler;
    }

    @Override
    public void afterConnectionEstablished(WebSocketSession session) throws Exception {
        var queryParameterMap = (Map<String, String[]>) session.getAttributes().get("queryParameterMap");
       if (queryParameterMap != null && queryParameterMap.containsKey("modelSessionId")) {
           session.getAttributes().put("routedHandler", modellingHandler);
       } else {
           session.getAttributes().put("routedHandler", normalHandler);
       }
        resolveHandler(session).afterConnectionEstablished(session);
    }
    @Override
    protected void handleTextMessage(WebSocketSession session, TextMessage message) throws Exception {
        resolveHandler(session).handleTextMessage(session, message);
    }

