    function stringToTimeVar(str) {
        return {millis: new Date(str).valueOf()};
    }
    function timeVarToString(timeVar) {
        if (timeVar == null || timeVar == undefined) return "";
        return new Date(Number(timeVar.millis)).toISOString();
    }
    function stringToJSON(value, dataType) {
        if (dataType==="stringVar") {
            return value;
        } else if (dataType==="timeVar") {
            return stringToTimeVar(value);
        } else if (dataType === 'dynTimeVar') {
            return {values: JSON.parse(value).map(s => stringToTimeVar(s))};
        } else if (dataType.startsWith("dyn")) {
            return {values: JSON.parse(value)};
        } else if (dataType === "boolVar") {
            return value === "1" ? true : value === "0" ? false : JSON.parse(value);
        } else {
            return JSON.parse(value);
        }
    }

    function JSONtoString(value, dataType) {
        if (dataType === 'stringVar') {
            return value;
        } else if (dataType === 'timeVar') {
            return timeVarToString(value);
        } else if (dataType === 'dynTimeVar') {
            return value != null ? JSON.stringify(value.values.map(v => timeVarToString(v)), null, 2) : JSON.stringify([]);
        } else if (dataType.startsWith('dyn')) {
            return value != null ? JSON.stringify(value.values, null, 2) : JSON.stringify([]);
        }else {
            return JSON.stringify(value, null, 2);
        }
    }

