    async function callBySocket(callBody, timeout) {
        if (!websocketConnected) {
            throw new Error("Для работы нужна активная сессия");
        }
        let callId = String(++callIdSequense);
        callBody.id = callId;
        let waitTill = new Date().getTime() + timeout;
        callId2Result.set(callId, waitTill);
        socket.send(JSON.stringify(callBody));
        await delay(50);
        do {
            let result = callId2Result.get(callId);
            if (result != null && typeof result !== "number") {
                callId2Result.delete(callId);
                if (result.message_type === "CALL_ERROR") {
                    throw new Error(result.message);
                }
                return result.message
            }
            console.log("Ждём ответа callId", callBody.id ,callBody.cmd);
            await delay(500);
        } while (new Date().getTime() < waitTill)
        callId2Result.delete(callId);
        throw new Error("Не дождались ответа callId "+ callBody.id + " " + callBody.cmd, + " за " + timeout + "мс");
    }

