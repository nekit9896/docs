        }
    }

    @Override
    public void acceptValuesWithDeleteFlag(List<Pair<TagValue, Boolean>> tagValuesWithDeleteFlag) {
        // для v1 не используем признак удаления сигнала (снятие топика)
        acceptValues(tagValuesWithDeleteFlag.stream().map(Pair::getLeft).toList());
    }

    @Override
    public void acceptAlarms(List<TagAlarm> tagAlarms) {
    }

