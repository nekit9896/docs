    public void acceptAttribute(ConfigurationAttribute attribute) {
    }

    private void doOnFoundTags(Set<String> tags, Consumer<Set<Pair<Tag, Attributes>>> consumer, boolean checkGetAccess) {
        Set<String> missingTags = new HashSet<>();
        Set<String> forbiddenTags = new HashSet<>();
        Set<Pair<Tag, Attributes>> foundTags = new HashSet<>();
        tags.forEach(tagName -> {
            try {
                if(checkGetAccess && !DataServiceBase.hasTagNameAccess(tagName, allowGetPatterns, forbiddenGetPatterns)) {
                    forbiddenTags.add(tagName);
                    return;
                }

                val tag = evo.findTag(tagName);
                val normalized = TagImpl.normalizeTagName(tagName);
                foundTags.add(Pair.of(tag, normalized.getRight()));
            } catch (TagNotFoundException | StringIndexOutOfBoundsException ignored) {
                missingTags.add(tagName);
            }
        });

        if (missingTags.size() > 0) {
            var message = String.format("Не нашли %d из %d тегов", missingTags.size(), tags.size());
            sendErrorToSession(message, Map.of("missing_tags", missingTags));
        }

        if (forbiddenTags.size() > 0) {
            var message = String.format("Нет доступа к %d из %d тегов", forbiddenTags.size(), tags.size());
            sendErrorToSession(message, Map.of("missing_tags", forbiddenTags));
        }

        if(foundTags.size() > 0) {
            consumer.accept(foundTags);
        }
    }

    private void subscribe(Set<String> tags) {
        doOnFoundTags(tags, foundTags ->
            streamProviders.forEach(sp -> sp.valueSubscribe(foundTags)), true);
    }

    private void unsubscribe(Set<String> tags) {
        doOnFoundTags(tags, foundTags ->
            streamProviders.forEach(sp -> sp.valueUnsubscribe(foundTags)), false);
    }

    private void unsubscribeAll() {
        streamProviders.forEach(DataStreamProvider::unsubscribeAll);
    }

    @Override
    public void close(CloseStatus status) throws IOException {
        unsubscribeAll();
        super.close(status);
    }

    @Override
    protected void handlePayload(String payload) {
        Command mappedCmd = null;
        if (payload == null) {
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), null, "EMPTY", "empty payload", null);
            }
            return;
        }
        if (payload.startsWith(CMD_SUBSCRIBE)) {
            var tags = parseStringIds(CMD_SUBSCRIBE.length(), payload);
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), null, "SUBSCRIBE",
                        "tagsCount=" + tags.size() + ", tagsSample=" + HotlinkMessageLogger.summarizeCollection(tags, 3), payload);
            }
            subscribe(tags);
            mappedCmd = Command.SUBSCRIBE;
        } else if (payload.startsWith(CMD_UNSUBSCRIBE)) {
            var tags = parseStringIds(CMD_UNSUBSCRIBE.length(), payload);
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), null, "UNSUBSCRIBE",
                        "tagsCount=" + tags.size() + ", tagsSample=" + HotlinkMessageLogger.summarizeCollection(tags, 3), payload);
            }
            unsubscribe(tags);
            mappedCmd = Command.UNSUBSCRIBE;
        } else if (payload.startsWith(CMD_UNSUBSCRIBE_ALL)) {
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), null, "UNSUBSCRIBE_ALL", "all", payload);
            }
            unsubscribeAll();
            mappedCmd = Command.UNSUBSCRIBE_ALL;
        } else if (payload.startsWith("PLAY")) {
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), null, "PLAY", "play", payload);
            }
            streamProviders.forEach(DataStreamProvider::play);
            mappedCmd = Command.PLAY;
        } else if (payload.startsWith("STOP")) {
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), null, "STOP", "stop", payload);
            }
            streamProviders.forEach(DataStreamProvider::stop);
            mappedCmd = Command.STOP;
        } else if (payload.startsWith(CMD_STREAM_SWITCH_HISTORY)) {
            var args = parseArgs(CMD_STREAM_SWITCH_HISTORY.length(), payload);
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), null, "STREAM SWITCH HISTORY",
                        "start=" + (args.size() > 0 ? args.get(0) : "null")
                                + ", finish=" + (args.size() > 1 ? args.get(1) : "null")
                                + ", millisPerTick=" + (args.size() > 2 ? args.get(2) : "null"), payload);
            }
            switchToHistory(Instant.ofEpochMilli(Long.parseLong(args.get(0))),
                    Instant.ofEpochMilli(Long.parseLong(args.get(1))),
                    Long.parseLong(args.get(2)));
            mappedCmd = Command.SWITCH;
        } else if (payload.startsWith(CMD_STREAM_SWITCH_LIVE)) {
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), null, "STREAM SWITCH LIVE", "live", payload);
            }
            switchToLive();
            mappedCmd = Command.SWITCH;
        } else if (payload.startsWith(CMD_MILLIS_PER_TICK)) {
            var args = parseArgs(CMD_MILLIS_PER_TICK.length(), payload);
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), null, "MILLIS PER TICK",
                        "millisPerTick=" + (args.size() > 0 ? args.get(0) : "null"), payload);
            }
            streamProviders.forEach(sp -> sp.setSpeed(Long.parseLong(args.get(0))));
            mappedCmd = Command.SET_MILLIS_PER_TICK;
        } else if (payload.startsWith(CMD_SEEK)) {
            var args = parseArgs(CMD_SEEK.length(), payload);
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), null, "SEEK",
                        "timestamp=" + (args.size() > 0 ? args.get(0) : "null"), payload);
            }
            streamProviders.forEach(sp -> sp.seek(Instant.ofEpochMilli(Long.parseLong(args.get(0)))));
            mappedCmd = Command.SEEK;
        } else if (payload.startsWith(CMD_CONTROL_OTHER_HISTORY)) {
            // экспериментальное в V1
            var args = parseArgs(CMD_CONTROL_OTHER_HISTORY.length(), payload);
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), null, "CONTROL OTHER HISTORY",
                        "streamId=" + (args.size() > 0 ? args.get(0) : "null"), payload);
            }
            controlOtherHistory(UUID.fromString(args.get(0)));
        } else if (payload.startsWith(CMD_PING)) {
            var args = parseArgs(CMD_PING.length(), payload);
            var pingId = args.size() > 0 ? args.get(0) : "";
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), pingId, "PING", "pingId=" + pingId, payload);
            }
            sendPongToSession(pingId);
            mappedCmd = Command.PING;
        } else {
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), null, "UNKNOWN", "length=" + payload.length(), payload);
            }
        }
        if (mappedCmd != null) {
            commandsCount.computeIfAbsent(mappedCmd.name(), k -> new AtomicLong(0l)).incrementAndGet();
        }
    }


    private static Set<String> parseStringIds(int offset, String receivedString) {
        return Arrays.stream(receivedString.substring(offset).split("([\\s,])+"))
                .map(StringUtils::trimToEmpty)
                .filter(StringUtils::isNotEmpty)
                .collect(Collectors.toSet());
    }

    private static List<String> parseArgs(int offset, String receivedString) {
        return Arrays.stream(receivedString.substring(offset).split("([\\s,])+"))
                .map(StringUtils::trimToEmpty)
                .filter(StringUtils::isNotEmpty)
                .collect(Collectors.toList());
    }

    @Override
    public int getVersion() {
        return 1;
    }

    @Override
    protected Map<String, Long> getCommandsCount() {
        var result = new HashMap<String, Long>();
        commandsCount.forEach( (k, v) -> result.put(k, v.get()));
        return result;
    }
}



