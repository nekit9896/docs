package tnt.tnscada.hmi.service;

import jakarta.annotation.PostConstruct;
import jakarta.validation.constraints.NotEmpty;
import jakarta.validation.constraints.NotNull;
import jakarta.validation.constraints.Pattern;
import lombok.Setter;
import lombok.extern.slf4j.Slf4j;
import org.apache.commons.lang3.builder.ToStringBuilder;
import org.apache.commons.lang3.builder.ToStringStyle;
import org.springframework.boot.context.properties.ConfigurationProperties;
import org.springframework.validation.annotation.Validated;
import tnt.evoscada.api.constants.DescentRule;
import tnt.evoscada.api.internal.dto.RouteDto;
import tnt.tnscada.hmi.errors.BadRequestException;

import java.util.Map;
import java.util.Objects;
import java.util.Set;
import java.util.stream.Collectors;

@Slf4j
@ConfigurationProperties(prefix = "tn-scada.cspa.topic-route")
@Setter
@Validated
public class TopicRouteConfig {
    private static final String ROOT_PARAMETER_NAME = ".";

    public record ProjectRoute(
            @NotNull Route root,
            Map<String, Map<@Pattern(regexp = "\\.[.\\w]*") String, Route>> type) {
    }

    public record Route(@NotEmpty String topic,
                        @NotNull DescentRule descentRule) {
    }

    public record ProjectQualifier(String project, String shortName) {
        public static ProjectQualifier ofFullName(String fullName) {
            String[] splitProject = fullName.split(":", 2);
            if (splitProject.length == 2 && !splitProject[0].isEmpty()) {
                return new ProjectQualifier(splitProject[0], splitProject[1]);
            }

            return new ProjectQualifier(null, fullName);
        }
    }

    @NotNull
    private Route root;
    private Map<String, ProjectRoute> project;

    public Set<RouteDto> getRoutes(String objectName, String objectTypeName) {

        ProjectQualifier object = ProjectQualifier.ofFullName(objectName);
        ProjectQualifier objectType = ProjectQualifier.ofFullName(objectTypeName);

        // Проверка, что проекты у объекта и типа совпадают
        if (!Objects.equals(object.project(), objectType.project())) {
            throw new BadRequestException("Project for object and objectType not equal");
        }

        // Если проекты не заданы или такого проекта нет в списке -> общий топик
        String typeShortName = objectType.shortName();
        if (this.project == null || !this.project.containsKey(objectType.project())) {
            return Set.of(getRouteDto(objectName, ROOT_PARAMETER_NAME, this.root));
        }

        // Проект найден
        ProjectRoute projectRoute = this.project.get(objectType.project());

        // Если objectTypeRoute не заданы или типа нет в списке -> общий топик для проекта
        if (projectRoute.type() == null ||
                !projectRoute.type().containsKey(typeShortName)) {
            return Set.of(getRouteDto(objectName, ROOT_PARAMETER_NAME, projectRoute.root));
        }

        // Объект найден
        Map<String, Route> objectTypeRoutes = projectRoute.type().get(typeShortName);

        // Собираем все маршруты для типа
        return getRoutes(objectName, objectTypeRoutes);
    }

    private Set<RouteDto> getRoutes(String objectName, Map<String, Route> objectTypeRoutes) {
        return objectTypeRoutes
                .entrySet()
                .stream()
                .map(entry -> getRouteDto(objectName, entry.getKey(), entry.getValue()))
                .collect(Collectors.toSet());
    }


    private RouteDto getRouteDto(String objectName, String parameterName, Route route) {
        return new RouteDto(objectName, parameterName, route.descentRule(), route.topic());
    }

    @Override
    public String toString() {
        return new ToStringBuilder(this, ToStringStyle.SHORT_PREFIX_STYLE)
                .append("root", root)
                .append("project", project)
                .toString();
    }

    @PostConstruct
    private void logProperties() {
        log.info("Routing configuration: " + this);
    }
}



