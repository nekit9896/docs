    function getStrongHash(str) {
        let hash = 1789;
        for (let i = 0; i < str.length; i++) {
            hash = Math.imul(hash ^ str.charCodeAt(i), 3432918353);
            hash = (hash << 15) | (hash >>> 17);
        }
        hash ^= hash >>> 16;
        hash = Math.imul(hash, 2246822507);
        hash ^= hash >>> 13;
        return Math.abs(hash ^ (hash >>> 16));
    }

    function calcHashedBgColor(el) {
        var allRowTd = el.parentElement.getElementsByTagName("td");
        if (!useHashColors) {
            for (const k in allRowTd) {
