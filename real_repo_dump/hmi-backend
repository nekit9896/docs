public class AuditFacadeService {

    private final WebClient gaAuditClient;

    private final WebClient alarmServiceClient;

    @Value("${tn-scada.cspa.user-action.alerts.default-tag-name}")
    private String USER_ACTION_TAGNAME;
    @Value("${tn-scada.cspa.user-action.alerts.alert-class}")
    private String USER_ACTION_ALERT_CLASS;

    private final CacheableTagInfoStore tagInfoStore;

    public AuditFacadeService(@Qualifier("GAAuditClient") WebClient gaAuditClient, @Qualifier("AlarmServiceClient") WebClient alarmServiceClient,
                              CacheableTagInfoStore tagInfoStore) {
        this.gaAuditClient = gaAuditClient;
        this.alarmServiceClient = alarmServiceClient;
        this.tagInfoStore = tagInfoStore;
    }

    public boolean processRequest(AuditEventLogApi payload, String userId, String userIP) {
        var requestTime = System.currentTimeMillis();
        if (true) {
            try {
                AuditEventLogApi result = callGaAuditService(payload, userId, userIP);
            } catch (WebClientErrorException e) {
                log.error("Не удалось сделать запись аудита", e);
                return false;
            }
        }

        try {

            if (tagInfoStore.get(USER_ACTION_TAGNAME) == null) {
                throw new RuntimeException(String.format("Не существует такого тэга для создания события (аларма): %s", USER_ACTION_TAGNAME));
            }

            var messageBuilder = new StringBuilder(payload.getMessage());
            if (StringUtils.isNotBlank(payload.getCause())) {
                messageBuilder.append(String.format(", причина: %s", payload.getCause()));
            }
            if (StringUtils.isNotBlank(payload.getOrder())) {
                messageBuilder.append(String.format(", распоряжение: %s", payload.getOrder()));
            }
            var alarmRequest = GenerateAlarmDto.builder()
                    .tagName(USER_ACTION_TAGNAME)
                    .timeStamp(requestTime / 1000)
                    .value("Audit")
                    .text0("")
                    .range(0)
                    .alertClassName(USER_ACTION_ALERT_CLASS)
                    .text(messageBuilder.toString())
                    .build();
            var result = callAlarmService(alarmRequest);
        } catch (Exception e) {
            log.error("Не удалось создать событие (создать alarm): " + e, e);
            return false;
        }

        return true;
    }

    @Nullable
    private AuditEventLogApi callAlarmService(GenerateAlarmDto alarmRequest) {
        return alarmServiceClient.post().uri("/generateAlarm")
                .body(BodyInserters.fromValue(alarmRequest))
                .retrieve()
                .onStatus(status -> status.isError(), response ->
                        response.bodyToMono(ErrorMessage.class)
                                .flatMap(err -> Mono.error(new WebClientErrorException(
                                        "Проблема при обращении к Alarm-service (Сервис событий)", err.getMessage(),
                                        err.getErrorCode())))
                )
                .bodyToMono(AuditEventLogApi.class).block();
    }

    @Nullable
    private AuditEventLogApi callGaAuditService(AuditEventLogApi payload, String userId, String userIP) {
        return gaAuditClient.post().uri("/user_action")
                .header("X-USER-ID", userId)
                .header("X-USER-IP", userIP)
                .body(BodyInserters.fromValue(payload))
                .retrieve()
                .onStatus(status -> status.isError(), response ->
                        response.bodyToMono(ErrorResponseApi.class)
                                .flatMap(err -> Mono.error(new WebClientErrorException(
                                        "Проблема при обращении к GA-audit (ИБ)", err.getErrorMessage(),
                                        err.getErrorCode())))
                )
                .bodyToMono(AuditEventLogApi.class).block();
    }
}



