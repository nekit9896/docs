    function getHeadersObject() {
        var securitySignature = document.getElementById("securitySignature").value.trim();
        var userId = document.getElementById("userId").value;
        var userIp = document.getElementById("userIp").value;
        var allowPatterns = document.getElementById("allowPatterns").value;
        var forbiddenPatterns = document.getElementById("forbiddenPatterns").value;
        var userIdEncoded = encodeURIComponent(userId);

        var headersObject = {
            'Content-Type': 'application/json;charset=utf-8',
            'X-USER-FULLNAME': userIdEncoded
        };
        if (allowPatterns.length > 0) {
            headersObject['X-USER-ALLOW-PATTERNS'] = allowPatterns;
        }
        if (forbiddenPatterns.length > 0) {
            headersObject['X-USER-FORBIDDEN-PATTERNS'] = forbiddenPatterns;
        }
        if (userIp.length > 0) {
            headersObject['X-USER-IP'] = userIp;
        }
        if (securitySignature.length > 0) {
            headersObject["X-SECURITY-SIGNATURE"] = securitySignature;
        }
        return headersObject;
    }

    async function sendValue(tagName, valueAttr, value, invalid){
        if (historyMode) {
            if (!confirm("Сейчас Исторический режим данных, изменения не будут отображены. Продолжить?")===true) {
                return;
            }
        }
        let payload = {
            "tag": tagName,
            "value": {
                "invalid": !!invalid
            }
        };
        try {
            payload.value[valueAttr] = stringToJSON(value, valueAttr);
        } catch (e) {
            return "Ошибка подготовки запроса: " + e.message;
        }

        return fetch(`${wsUrl.value}/tag-set`, {
            method: 'POST',
            headers: getHeadersObject(),
            body: JSON.stringify(payload)
        })
            .then(response => {
                if (!response.ok) {
                    console.log(response);
                    return response.json().then(json => {throw new Error(json.message);});
                } else {
                    return true;
                }
            })
            .catch(reason => {
                console.log(reason);
                return "Ошибка: " + reason.message;
            });
    }

