    private Set<String> parseHandshakeTagAccessHeader(String headerName, Map<String, String> fallBackMap) {
        var headers = webSocketSession.getHandshakeHeaders().get(headerName);
        var header = headers != null ? headers.get(0) : null;
        if (header != null) {
            return ControllerUtils.getNullableStringsSet(header);
        } else if (fallBackMap.get(headerName) != null) {
            return  ControllerUtils.getNullableStringsSet(fallBackMap.get(headerName));
        }
        return null;
    }
    private String parseHandshakeSingleHeader(String headerName, Map<String, String> fallBackMap) {
        var headers = webSocketSession.getHandshakeHeaders().get(headerName);
        var header = headers != null ? headers.get(0) : null;
        if (header != null) {
            return URLDecoder.decode(header, StandardCharsets.UTF_8);
        } else if (fallBackMap.get(headerName) != null) {
            return URLDecoder.decode(fallBackMap.get(headerName), StandardCharsets.UTF_8);
        }
        return null;
    }
    protected HotlinkSessionBase(WebSocketSession webSocketSession, Evo evo, Integer sampleTime) {
        sessionStartTime = System.currentTimeMillis();
        this.webSocketSession = webSocketSession;
        this.evo = evo;

        var queryMap = new HashMap<String, String>();
        var queryParameterMap = (Map<String, String[]>) webSocketSession.getAttributes().get("queryParameterMap");
        if (queryParameterMap != null && !queryParameterMap.isEmpty()) {
            queryParameterMap.forEach((k, v) ->  queryMap.put(k,v[0]));
        }

        monitorHeaders = monitorHeaderNames.stream()
                .filter(hn -> !Objects.isNull(webSocketSession.getHandshakeHeaders().get(hn)))
                .collect(Collectors.toMap(hn -> hn,
                        hn -> webSocketSession.getHandshakeHeaders().get(hn)
                            .stream().map(v -> URLDecoder.decode(v, StandardCharsets.UTF_8)).collect(
                                    Collectors.toSet())
                        ));


        allowGetPatterns = parseHandshakeTagAccessHeader("X-USER-GET-ALLOW-PATTERNS", queryMap);
        forbiddenGetPatterns = parseHandshakeTagAccessHeader("X-USER-GET-FORBIDDEN-PATTERNS", queryMap);
        allowPatterns = parseHandshakeTagAccessHeader("X-USER-ALLOW-PATTERNS", queryMap);
        forbiddenPatterns = parseHandshakeTagAccessHeader("X-USER-FORBIDDEN-PATTERNS", queryMap);
        userIdentity = parseHandshakeSingleHeader("X-USER-FULLNAME", queryMap);
        userIp = parseHandshakeSingleHeader("X-USER-IP", queryMap);

        if (sampleTime > 0) {
            PublishSubject<TDto> publishSubject = PublishSubject.create();
            msgConsumer = publishSubject::onNext;
            this.disposable = publishSubject
                    .window(sampleTime, TimeUnit.MILLISECONDS)
                    .concatMap(this::windowConcatMap)
                    .filter(valueDtoMap -> !valueDtoMap.isEmpty())
                    .map(Map::values)
                    .subscribe(this::batchListener, e -> log.error("Error while sending batched data {}", e.getMessage(), e));
        } else {
            msgConsumer = this::listener;
            this.disposable = null;
        }
        initDataStreams();
        updateLastClientsideActivity();
        log.debug("HotlinkSession monitorHeaders {}", monitorHeaders);
        log.info("HotlinkSession {} created for {}ms", webSocketSession.getId(), System.currentTimeMillis() - sessionStartTime);
    }

    protected void initDataStreams() {
        var liveProvider = new LiveDataStreamProvider(evo, this::acceptValuesWithDeleteFlag, this::acceptAlarms,
                this::acceptAttribute);
        liveProvider.setActive(true);
        var historyProvider =
                new HistoryDataStreamProvider(evo, this::acceptValues, this::acceptAlarms, this::acceptAttribute);
        streamProviders = List.of(liveProvider, historyProvider);
        DataStreamManager.register(historyProvider);
    }

    protected void doSwitchProvider(int index, String name, Instant start, Instant finish, Long millisPerTick) {
        if(activeProvider == index) {
            log.debug("doSwitchProvider: Already in {} mode", name);
            return;
        }

        log.info("Switching stream to {} {} {} {}", name, start, finish, millisPerTick);
        getActiveProvider().setActive(false);
        streamProviders.get(index).initStream(start, finish, millisPerTick);
        streamProviders.get(index).setActive(true);
        activeProvider = index;
        log.info("StreamId {}", streamProviders.get(index).getId().toString());
    }

    public String getActiveDataStreamName() {
        return switch (activeProvider) {
            case LIVE_INDEX -> "LIVE";
            case HISTORY_INDEX -> "HISTORY";
            default -> "";
        };
    }

    public void controlOtherHistory(UUID id) {
        var extStream = DataStreamManager.getBy(id);
        if (extStream == null) {
            var msg = String.format("Datastream with id %s not found", id);
            log.error(msg);
            sendErrorToSession(msg);
            return;
        }
        var curStream = streamProviders.get(HISTORY_INDEX);
        if (curStream == extStream) {
            var msg = String.format("Datastream with id %s already used in this session", id);
            log.error(msg);
            sendErrorToSession(msg);
            return;
        }
        log.info("Switching to external datastream {}", id);
        var prevProviders = streamProviders;
        streamProviders = List.of(prevProviders.get(LIVE_INDEX), extStream);
        DataStreamManager.unregister(curStream);

    }

    public void switchToHistory(Instant start, Instant finish, Long millisPerTick) {
        doSwitchProvider(HISTORY_INDEX, "HISTORY", start, finish, millisPerTick);
