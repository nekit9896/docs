package tnt.tnscada.hmi.modelling.datastream;

import java.io.IOException;
import java.time.Instant;
import java.util.*;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.atomic.AtomicInteger;
import com.google.gson.JsonObject;
import lombok.extern.slf4j.Slf4j;
import lombok.val;
import org.apache.commons.lang3.tuple.Pair;
import tnt.evoscada.api.AttributeCallback;
import tnt.evoscada.api.DataCallback;
import tnt.evoscada.api.Evo;
import tnt.evoscada.api.Subscription;
import tnt.evoscada.api.data.Attributes;
import tnt.evoscada.api.data.Tag;
import tnt.evoscada.api.data.TagAlarm;
import tnt.evoscada.api.data.TagValue;
import tnt.evoscada.api.dto.configuration.ConfigurationAttribute;
import tnt.tnscada.hmi.datastream.DataStreamProvider;
import tnt.tnscada.hmi.modelling.EvoCoreDelegated;
import tnt.tnscada.hmi.modelling.service.SessionManager;

@Slf4j
public class ModelDataStreamProvider implements DataStreamProvider {
    private final SessionManager sessionManager;
    private Evo evo;
    private final DataCallback<TagValue> valueCallback;
    private final DataCallback<TagAlarm> alarmCallback;
    private final AttributeCallback<?> attributeCallback;



    private volatile boolean isActive;

    private final Map<String, Pair<Tag, Attributes>> valueSubPairs = new ConcurrentHashMap<>();
    private final Map<String, Subscription> valueSubscriptions = new ConcurrentHashMap<>();
    private final Map<String, Subscription> alarmSubscriptions = new ConcurrentHashMap<>();
    private final Map<String, Subscription> attributeSubscriptions = new ConcurrentHashMap<>();
    private final Map<Attributes, AtomicInteger> subscriptionsByAttribute = new ConcurrentHashMap<>();

    private final UUID id = UUID.randomUUID();

    private Long modelSessionId;

    public ModelDataStreamProvider(
            SessionManager sessionManager,
            DataCallback<TagValue> valueCallback,
            DataCallback<TagAlarm> alarmCallback,
            AttributeCallback<?> attributeCallback, Long modelSessionId) {
        this.sessionManager = sessionManager;
        this.valueCallback = valueCallback;
        this.alarmCallback = alarmCallback;
        this.attributeCallback = attributeCallback;
        this.modelSessionId = modelSessionId;
    }

    @Override
    public Instant getTime() {
        if (evo == null) {
            return Instant.MIN;
        }
        return ((EvoCoreDelegated) evo).getWallclock();
    }

    @Override
    public void valueSubscribe(Set<Pair<Tag, Attributes>> tags) {
        synchronized (valueSubscriptions) {
            try {
                tags.forEach(t -> {
                    val subscriptionKey = t.getKey().getTagName();
                    val existing = valueSubscriptions.get(subscriptionKey);
                    if (existing != null) {
                        log.debug("Subscription on already subscribed tag {}", valueSubscriptions);
                        return;
                    }

                    valueSubPairs.put(subscriptionKey, t);

                    if (evo != null) {
                        valueSubscriptions.put(subscriptionKey,
                                evo.tagSubscribe(valueCallback, true, t.getKey()));
                    }

                    var counter = subscriptionsByAttribute.computeIfAbsent(t.getValue(), k -> new AtomicInteger(0));
                    counter.incrementAndGet();
                });
            } catch (Exception e) {
                log.error("Подписка на модель", e);
            }
        }
    }

    @Override
    public void alarmSubscribe(Set<Pair<Tag, Attributes>> tags) {
        synchronized (alarmSubscriptions) {
            tags.forEach(t -> {
                val subscriptionKey = t.getKey().getTagName();
                val existing = alarmSubscriptions.get(subscriptionKey);
                if(existing != null) {
                    log.debug("Subscription on already subscribed alarm-tag {}", alarmSubscriptions);
                    return;
                }

                alarmSubscriptions.put(subscriptionKey,
                    evo.tagAlarmSubscribe(this::effectiveAlarmCallback, true, t.getKey()));
                var counter = subscriptionsByAttribute.computeIfAbsent(t.getValue(), k -> new AtomicInteger(0));
                counter.incrementAndGet();
            });
        }
    }

    @Override
    public void attributeSubscribe(Set<Pair<Tag, Attributes>> tags) {
        synchronized (attributeSubscriptions) {
            tags.forEach(t -> {
                val subscriptionKey = t.getKey().getTagName() + ":" + t.getValue();
                val existing = attributeSubscriptions.get(subscriptionKey);
                if(existing != null) {
                    log.debug("Subscription on already subscribed tag " + subscriptionKey);
                    return;
                }

                attributeSubscriptions.put(subscriptionKey, evo.tagConfiguration().subscribeAttribute(
                    t.getRight(), Set.of(t.getKey()), this::effectiveAttributeCallback, ignored -> {}, true));
                var counter = subscriptionsByAttribute.computeIfAbsent(t.getValue(), k -> new AtomicInteger(0));
                counter.incrementAndGet();
            });
        }
    }

    @SuppressWarnings("resource")
    @Override
    public void valueUnsubscribe(Set<Pair<Tag, Attributes>> tags) {
        synchronized (valueSubscriptions) {
            tags.forEach(tag -> {
                try {
                    val subscriptionKey = tag.getKey().getTagName();
                    Subscription subscription = valueSubscriptions.get(subscriptionKey);
                    if (subscription == null) {
                        log.trace("Value unsubscribe attempt on not subscribed tag {}", subscriptionKey);
                        return;
                    }
                    var countBefore = valueSubscriptions.size();
                    evo.tagUnsubscribe(subscription);
                    valueSubscriptions.remove(subscriptionKey);
                    valueSubPairs.remove(subscriptionKey);
                    if (countBefore > valueSubscriptions.size()) {
                        var counter = subscriptionsByAttribute.computeIfAbsent(tag.getValue(), k -> new AtomicInteger(0));
                        counter.decrementAndGet();
                    }
                }
                catch (Exception e) {
                    log.error("Failed to unsubscribe", e);
                }
            });
        }
    }

    @SuppressWarnings("resource")
    @Override
    public void alarmUnsubscribe(Set<Pair<Tag, Attributes>> tags) {
        synchronized (alarmSubscriptions) {
            tags.forEach(t -> {
                val subscriptionKey = t.getKey().getTagName();
                Subscription existing = alarmSubscriptions.get(subscriptionKey);
                if(existing == null) {
                    log.trace("Alarm unsubscribe attempt on not subscribed tag {}", subscriptionKey);
                    return;
                }

                var countBefore = alarmSubscriptions.size();
                evo.alarmUnsubscribe(existing);
                alarmSubscriptions.remove(subscriptionKey);
                if (countBefore > valueSubscriptions.size()) {
                    var counter = subscriptionsByAttribute.computeIfAbsent(t.getValue(), k -> new AtomicInteger(0));
                    counter.decrementAndGet();
                }
            });
        }
    }

    @SuppressWarnings("resource")
    @Override
    public void attributeUnsubscribe(Set<Pair<Tag, Attributes>> tags) {
        synchronized (attributeSubscriptions) {
            tags.forEach(t -> {
                val fullName = t.getKey().getTagName() + ":" + t.getValue();
                Subscription existing = attributeSubscriptions.get(fullName);
                if(existing == null) {
                    log.trace("Attribute unsubscribe attempt on not subscribed tag {}", fullName);
                    return;
                }

                var countBefore = attributeSubscriptions.size();
                try {
                    existing.close();
                }
                catch (Exception ignored) {
                    log.warn("failed to unsubscribe attribute {}, ambiguous ignored", fullName, ignored);
                }
                attributeSubscriptions.remove(fullName);
                if (countBefore > attributeSubscriptions.size()) {
                    var counter = subscriptionsByAttribute.computeIfAbsent(t.getValue(), k -> new AtomicInteger(0));
                    counter.decrementAndGet();
                }
            });
        }
    }

    @Override
    public void unsubscribeAll() {
        synchronized (valueSubscriptions) {
            valueSubscriptions.values().forEach(s -> {
                if (s != null) {
                    evo.tagUnsubscribe(s);
                }
            });
            valueSubscriptions.clear();
        }

        synchronized (alarmSubscriptions) {
            alarmSubscriptions.values().forEach(s -> {
                if (s != null) {
                    evo.alarmUnsubscribe(s);
                }
            });
            alarmSubscriptions.clear();
        }

        synchronized (attributeSubscriptions) {
            attributeSubscriptions.values().forEach(s -> {
                if (s != null) {
                    try {
                        s.close();
                    } catch (Exception ignored) {
                    }
                }
            });
            attributeSubscriptions.clear();
        }
    }

    @Override
    public void initStream(Instant startAnyIgnored, Instant finishAnyIgnored, Long millisPerTickIgnored) {
