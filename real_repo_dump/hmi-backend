import com.google.gson.JsonArray;

import java.util.Collection;
import java.util.List;
import java.util.Objects;
import java.util.Set;

public class JsonUtils {
    public static JsonArray getJsonArray(Collection<?> list) {
        JsonArray arrayVal = new JsonArray();
        for (Object element: list) {
            if (element instanceof List) {
                var val = getJsonArray((List<?>) element);
                arrayVal.add(val);
            } if (element instanceof Set) {
                var val = getJsonArray((Set<?>) element);
                arrayVal.add(val);
            } else if (element instanceof Number) {
                arrayVal.add((Number) element);
            } else if (element instanceof Boolean) {
                arrayVal.add((boolean) element);
            } else {
                arrayVal.add(Objects.toString(element));
            }
        }
        return arrayVal;
    }
}



