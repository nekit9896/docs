@Service
@Slf4j
public class HistoryServiceHmi {
    private final Evo evo;

    public HistoryServiceHmi(Evo evo) {
        this.evo = evo;
    }

    public Map<String, List<TagValue>> tagGetHistory(
            long startTime,
            long endTime,
            List<String> tags,
            int limit,
            int offset,
            boolean returnBounds
    ) {
        var tagsMapped = getTagInfoList(tags);
        var records = evo.tagGetHistory(tagsMapped,
                Date.from(Instant.ofEpochMilli(startTime)), Date.from(Instant.ofEpochMilli(endTime)),
                limit, offset, returnBounds);
        return records.stream()
                    .collect(groupingBy(r -> r.getTag().getTagName()));
    }

    private Set<Tag> getTagInfoList(Collection<String> tags) {
        Set<String> missing = new HashSet<>();
        Set<Tag> tagInfoSet = new HashSet<>();
        for (var tag : tags) {
            try {
                var tagInfo = evo.findTag(tag);
                tagInfoSet.add(tagInfo);
            }
            catch (tnt.evoscada.api.err.TagNotFoundException e) {
                missing.add(tag);
            }
        }

        if (missing.size() > 0) {
            log.debug("Среди запрашиваемых тегов не существовало таких: {}", missing);
        }

        return tagInfoSet;
    }

}



