<script>
    let websocketConnected = false;
    let socket = null;
    let callIdSequense = 0;
    let callId2Result = new Map();
    let tagIndexMap = new Map();
    let tagAwaitsValue = new Set();
    let rowsNumber = 0;
    let aliveTimer = null;
    let reconnectTimer = null;
    let reconnectTryCounter = 0;
    let reconnectSuccessCounter = 0;
    let reconnectDelayMs = 2000;
    let reconnectMaxDelayMs = 10000;
    let tryToReconnect = true;
    let historyMode = false;
    let modelMode = false;
    let isPlaying = false;
    let streamCursorMillis;
    let historyId;
    let lastError;

    let sessionInitRequestTime = null;
    let sessionInitSuccessTime = null;
    let sessionInitAwaitingValues = false;
    let skipApplyingNewValues = false;
    let skipTableInit = false;
    let skipPrintTagLabels = true;
    let useHashColors = false;

    let historyDataState;

    let websocketStatus = document.getElementById("websocketStatus");
    let websocketDetails = document.getElementById("websocketDetails");
    let websocketActivity = document.getElementById("websocketActivity");
    let streamClock = document.getElementById("streamClock");
    let datetimeStart = document.getElementById("datetimeStart");
    let datetimeFinish = document.getElementById("datetimeFinish");
    let datetimeCursor = document.getElementById("datetimeCursor");
    let updateCursorElem = document.getElementById("updateCursor");
    let waitIndicatorElem = document.getElementById("waitIndicator");
    let timeLineBucketsElem = document.getElementById("timeLineBuckets");
    let urlList = document.getElementById("urlList");
    let wsUrl = document.getElementById("wsUrl");

    document.getElementById("urlList").onclick = function(e){
        if(e.target.nodeName=='LI') {
            wsUrl.value = e.target.innerText;
        }
    }

    document.getElementById('head_status').title = 'Набор бит недостоверности справа налево\n>' +
        '- OV (overflow)\n' +
        '- FI (forcibly invalid)\n' +
        '- TI (time invalid)\n' +
        '- CE (config error)\n' +
        '- SB (substituted)\n' +
        '- BL (blocked)\n' +
        '- NT (not-topical)\n' +
        '- IV (invalid)';

    timeLineBucketsElem.onclick = (e) => {
        let rect = e.target.getBoundingClientRect();
        let x = e.clientX - rect.left;
        let factor = x / rect.width;
        let startMillis = getStartDate().getTime();
        let intevalMillis = getFinishDate().getTime() - startMillis;
        let millisAtCursor = Math.round(intevalMillis/1000*factor)*1000 + startMillis;
        seek(millisAtCursor);
    }

    function toggleFieldset(elemId, fieldsetId) {
        let togglerElement = document.getElementById(elemId);
        let state = togglerElement.innerText;
        if(state == "+") {
            document.getElementById(fieldsetId).className = "";
            togglerElement.innerText = "-";
        } else {
            document.getElementById(fieldsetId).className = "collapsed";
            togglerElement.innerText = "+";
        }
    }

    function setVarSkipTableInit(){
        skipTableInit = document.getElementById("skipTableInit").checked;
        if (skipTableInit) {
            document.getElementById("skipApplyingValue").checked = true;
            setVarSkipApply();
        }
    }

    function setVarSkipApply(){
        let checkbox = document.getElementById("skipApplyingValue");
        if (skipTableInit && !checkbox.checked) {
            checkbox.checked = true;
        }
        skipApplyingNewValues = checkbox.checked;
    }

    function setVarSkipTagLabels(){
        let checkbox = document.getElementById("skipTagLabels");
        skipPrintTagLabels = checkbox.checked;
    }


    function setUseHashColors(){
        let checkbox = document.getElementById("useHashColors");
        useHashColors = checkbox.checked;
        let tableRows = document.querySelectorAll("#table-body tr");
        tableRows.forEach(function (row) {
            calcHashedBgColor(row.cells[0]);
        });
    }

    function updateSocketStatusConnecting() {
        if(reconnectTryCounter > 0) {
            websocketStatus.innerText = `Переподключение, попытка №${reconnectTryCounter}`;
        } else {
            websocketStatus.innerText = "Подключение";
        }
        websocketStatus.style.color = "darkorange";
        updateSocketDetails();
    }

    function updateSocketStatus() {
        if (websocketConnected) {
            websocketStatus.innerText = "Соединено";
            websocketStatus.style.color = "green";
        } else {
            websocketStatus.innerText =  "Вне сети";
            websocketStatus.style.color = "darkred";
        }
        triggerActivity();
    }




    function updateSocketDetails(details) {
        if (details === undefined) {
            details = '';
        }
        if (details !== '') {
            console.log(details)
        }
        websocketDetails.innerText = details;
    }

    function triggerActivity(){
        let color = websocketConnected ? "green" : "darkred";
        websocketActivity.animate([{background: color}, {background: "transparent"}], 500);
    }

    function sendAlive() {
        if (websocketConnected) {
            socket.send(JSON.stringify({"cmd":"PING"}));
        }
        triggerActivity();
        restartAliveTimeout();
    }

    function restartAliveTimeout() {
        if (websocketConnected) {
            if (aliveTimer != null) clearTimeout(aliveTimer);
            aliveTimer = setTimeout(sendAlive, 4700);
        }
    }

    function stopAliveTimeout() {
        if (aliveTimer != null) clearTimeout(aliveTimer);
    }

    function startReconnectTryTimeout() {
        reconnectTryCounter++;
        reconnectTimer = setTimeout(initSession, Math.min(reconnectTryCounter*reconnectDelayMs, reconnectMaxDelayMs));
    }

    function stopReconnectionAttemptsIfActive() {
        if (reconnectTimer != null) clearTimeout(reconnectTimer);
        let reconnectionWasActive = reconnectTryCounter > 0;
        reconnectTryCounter = 0;
        return reconnectionWasActive;
    }

    function connect() {
        tryToReconnect = true;
        initSession();
    }

    function applyStreamState(stream_state) {
        if ("start_millis" in stream_state) {
            if (stream_state.start_millis && stream_state.finish_millis) {
                datetimeStart.value = new Date(stream_state.start_millis).toISOString()
                    .replace('Z', '');
                datetimeFinish.value = new Date(stream_state.finish_millis).toISOString()
                    .replace('Z', '');
            }
        }
        if ("paused_till_upload" in stream_state && stream_state.paused_till_upload === true) {
            waitIndicatorElem.className = "";
        } else {
            waitIndicatorElem.className = "inactive";
        }
        if ("timeline_state" in stream_state) {
            timeLineBucketsElem.innerText = stream_state.timeline_state.map(b => b ? "|" : ".").join("");
        }
        if ("is_playing" in stream_state) {
            if (isPlaying !== stream_state.is_playing) {
                isPlaying = stream_state.is_playing;
                actualizePlayerState();
            }
        }
        if (stream_state.type === "history" && "id" in stream_state) {
            if (stream_state.id !== historyId) {
                historyId = stream_state.id;
            }
        }
    }

    function dateToReadable(date) {
        return date.toISOString()
            .replace('T', ' ')
            .replace(/-/g, '.')
            .replace('Z', '');
    }

    function dateForFilename(date) {
        return date.toISOString()
            .replace('T', ' ')
            .replace(/[-:]/g, '.')
            .replace(/\.[0-9]{3}Z/, '');
    }

    function timestampToReadableToggleable(obj, millis) {
        if (millis < 1) {
            obj.innerHTML = " - ";
            obj.removeAttribute("textAlt");
        } else {
            obj.setAttribute("textAlt", millis);
            obj.onclick = function () {toggleAlt(obj);};
            obj.innerHTML = dateToReadable(new Date(millis));
        }
    }

    function timestampToExport(millis){
        if (millis < 1) {
            return "";
        }
        return " " + dateToReadable(new Date(millis));
    }
    function applyStreamTime(millis) {
        streamCursorMillis = millis;
        let streamDate = new Date(streamCursorMillis);
        streamClock.innerText = dateToReadable(streamDate);
        if (historyMode && isPlaying && updateCursorElem.checked) {
            datetimeCursor.value = streamDate.toISOString()
                .replace('Z', '');
        }
        if (historyMode) {
            let startMillis = getStartDate();
            let finishMillis = getFinishDate();
            let relativeCursorMillis = streamCursorMillis - startMillis;
            let intervalMillis = finishMillis - startMillis;
            if (intervalMillis > 0) {
                let progress = (relativeCursorMillis / intervalMillis);
                timeLineBucketsElem.style.backgroundPositionX = (timeLineBucketsElem.clientWidth * progress - 7).toFixed(0) + "px";
            }
        }
    }

    function applyTagValueBatch(batch) {
        let tagsWaitingBefore = tagAwaitsValue.size;
        for (let i = 0; i < batch.length; i++) {
            try {
                applyValue(batch[i]);
            } catch (e) {
                console.log("Ошибка в применении данных из подписки!", e);
            }
        }
        if (sessionInitAwaitingValues
            && tagsWaitingBefore > 0
            && tagAwaitsValue.size === 0) {
            sessionInitAwaitingValues = false;
            console.log(`Полная инициализация значений Тегов за ${Date.now() - sessionInitSuccessTime}мс от установления сессии`)
        }
    }

    function toggleAlt(obj) {
        if (window.event.ctrlKey) {
            var altText = obj.getAttribute("textAlt");
            if (altText !== null && altText != "") {
                if (obj.innerText != altText) {
                    obj.setAttribute("textOrigin", obj.innerText);
                    obj.innerText = altText;
                } else {
                    obj.innerText = obj.getAttribute("textOrigin");
                }
            }
        }
    }

    function actualizeWarn() {
        var elem = document.getElementById("warnIndicator");
        if (lastError == null) {
            elem.className = "inactive";
            elem.title = "";

        } else{
            elem.className = "knowMore";
            elem.title = lastError.error_message;
        }
    }

    truncateLogString = (s, w) => s.length > w ? s.substring(0, w) + "...\n>>> подробнее смотри в консоли" : s;

    function showWarn() {
        if (lastError == null) {
            return;
        }
        let msg = "Последняя ошибка:\n"+lastError.error_message;
        if (lastError.payload != null) {
            msg += "\n\nПодробности:\n"+JSON.stringify(lastError.payload, null, 2);
        }
        let dismiss = confirm(truncateLogString(msg, 700)+"\n\nСбросить ошибку?");
        if (dismiss === true) {
            lastError = null;
            actualizeWarn();
        }
    }

    function initSession() {
        if (socket != null && socket.readyState !== socket.CLOSED) {
            alert("Сначала завершите активную сессию");
            return;
        }
        sessionInitRequestTime = Date.now();
        updateSocketStatusConnecting();
        const params = new URLSearchParams();
        let headersData = getFormHeadersObject();
        for(let k in headersData){
           params.append(k, headersData[k]);
        };

        let modelSessionId = document.getElementById("modelSessionId").value.trim();
        if (modelSessionId != null && modelSessionId.length > 0) {
            params.append("modelSessionId", modelSessionId);
            modelMode = true;
        }
        socket = new WebSocket(`${wsUrl.value.replace("http", "ws")}/v2/hotlink?${params.toString()}`);
        socket.onopen = function () {
            sessionInitSuccessTime = Date.now();
            console.log("Время открытия сессии: " + (sessionInitSuccessTime - sessionInitRequestTime) + "мс");
            websocketConnected = true;
            console.log("Установлена сессия");
            updateSocketStatus();
            restartAliveTimeout();
            if (stopReconnectionAttemptsIfActive()) {
                reconnectSuccessCounter++;
                updateSocketDetails(`Число переподключений: ${reconnectSuccessCounter}`);
            } else {
                updateSocketDetails();
            }
            resumeSubscription();
        };

        socket.onclose = function (event) {
            websocketConnected = false;
            stopAliveTimeout();
            updateSocketStatus();
            let cleanText = event.wasClean ? 'Разъединено штатно' : 'Сетевая проблема';
            let reasonText = event.reason ? ' по причине: ' + event.reason : '';
            let reconnectInfo = reconnectTryCounter > 0 ? `Попытка соединения №${reconnectTryCounter}. ` : '';
            updateSocketDetails(reconnectInfo + 'Код завершения: ' + event.code + '. ' + cleanText + reasonText);
            if (tryToReconnect) {
                startReconnectTryTimeout();
            }
        };

        socket.onerror = function (error) {
            websocketLastError = error;
        };

        socket.onmessage = function (event) {
            triggerActivity();
            if (event.data.trimStart().charAt(0) !== "{") {
                return;
            }
            let data = JSON.parse(event.data);
            let type = 'message_type' in data ? data.message_type : "";
            if (type === 'error') {
                lastError = data;
                actualizeWarn();
                console.log(data.error_message, data);
            } else if (type === 'time') {
                if ("stream_state" in data) {
                    applyStreamState(data.stream_state);
                }
                if ("stream_time_s" in data){
                    applyStreamTime(data.stream_time_s * 1000);
                }
            } else if (type === 'SUB_ANSWER') {
                applyTagValueBatch(data.message);
            } else if (type === 'CALL_ANSWER' || type === 'CALL_ERROR') {
                var callId = data.id;
                if (callId != null) {
                    if (callId2Result.has(callId)) {
                        console.log("received awaited response for callId "+callId);
                        callId2Result.set(callId, data);
                    } else {
                        console.log("received not awaited response for callId "+callId);
                    }
                }
            }
        };
    }

    function disconnect(){
        tryToReconnect = false;
        stopReconnectionAttemptsIfActive();
        socket.close();
