                            @ExampleObject(name = "ASC", description = "В порядке возрастания", value = "ASC"),
                            @ExampleObject(name = "DESC", description = "В порядке убывания", value = "DESC")
                    }),
                    @Parameter(name = "page", description = "Номер страницы, начиная с 0"),
                    @Parameter(name = "size", description = "Число элементов на странице")
            }
    )
    public List<ObjectResponse> getObjects(
            @RequestParam(value = "objectTypeId", required = false) Integer objectTypeId,
            @RequestParam(value = "projectId", required = false) Integer projectId,
            @RequestParam(value = "parentId", required = false) Integer parentId,
            @RequestParam(value = "sort", required = false, defaultValue = "ASC") Sort.Direction sort,
            @RequestParam(value = "page", required = false, defaultValue = "0") Integer page,
            @RequestParam(value = "size", required = false, defaultValue = "1000") Integer size
    ) {
        if(parentId != null) {
            return retrieveObjects(store.getObjectChildren(TnMsg.Key.newBuilder()
                        .setSystemId(projectId == null ? 0 : projectId)
                        .setObjectId(parentId)
                        .setAttrId(Attributes.Object.getAttrId()).build())
                    .filter(o ->
                            (objectTypeId == null || objectTypeId.equals(o.getObjectTypeIdentifier().getId()))
                    ), page, size, parentId, sort);
        }

        return retrieveObjects(store.getObjects()
                .filter(o ->
                        (objectTypeId == null || objectTypeId.equals(o.getObjectTypeIdentifier().getId())) &&
                        (projectId == null || projectId.equals(o.getObjectTypeIdentifier().getProject().getId()))
                ), page, size, null, sort);
    }

    private static List<ObjectResponse> retrieveObjects(
            Stream<ObjectIdentifier> filteredObjects, Integer page, Integer size, Integer parentId, Sort.Direction sort) {
        final var comparator = Comparator.comparing(ObjectIdentifier::getId);

        return paginate(filteredObjects.sorted(sort == Sort.Direction.ASC ? comparator : comparator.reversed()), page, size)
                .map(o -> new ObjectResponse(
                        o.getId(),
                        o.getObjectTypeIdentifier().getProject().getId(),
                        parentId,
                        o.getName(false),
                        o.getLabel(),
                        o.getObjectTypeIdentifier().getName(false))
                )
                .toList();
    }

