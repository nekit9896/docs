        log.trace("set: user={}, item={}", user, item);
        dataService.set(user, new AnswerItem(item.getTag(), deserializeData(item.getTag(), item.getData()), null),
                        ControllerUtils.getNullableStringsSet(allowPatterns),
                        ControllerUtils.getNullableStringsSet(forbiddenPatterns),
                        RequestUtils.getClientIpAddr(request), userIp);
    }

    @Operation(summary = "Записать значения тегов",
            description = """
                    Записать значения тегов
                    - если abortOnError=true(default), сразу бросаем исключение и возврат 500
                    - если abortOnError=false, пытаемся установить каждое новое значение, ошибки возвращаем списком с 200
                    """)
    @PostMapping(path = "/v2/tags-set")
    public List<TagErrorMessage> sets(
            @RequestHeader(value = "X-USER-FULLNAME", required = false) String user,
            @RequestHeader(value = "X-USER-IP", required = false) String userIp,
            @RequestHeader(value = "X-USER-ALLOW-PATTERNS", defaultValue = "[\".*\"]")
            @Schema(format = "Строка, представляющая JSON-массив", defaultValue = "[\".*\"]")
            String allowPatterns,

            @RequestHeader(value = "X-USER-FORBIDDEN-PATTERNS", required = false)
            @Schema(format = "Строка, представляющая JSON-массив", defaultValue = "[]")
            String forbiddenPatterns,

            @Parameter(name = "abortOnError",
                    description = "Выполнение прерывается и кидается 500 при первом же встретившемся исключении")
            @RequestParam(defaultValue = "true") boolean abortOnError,
            @RequestBody @Schema(type = "object", example = BATCHED_VALUE_MESSAGE_EXAMPLE) List<TagSetRequest> items,

            HttpServletRequest request
    ) {
        user = ControllerUtils.getUser(user, request);
        log.trace("sets: user={}, items={}", user, items);
        String remoteAddress = RequestUtils.getClientIpAddr(request);

        List<TagErrorMessage> errorMessages = abortOnError ? null : new ArrayList<>();

        for (TagSetRequest item : items) {
            try {
                AnswerItem tagValue = new AnswerItem(
                        item.getTag(),
                        deserializeData(item.getTag(), item.getData()),
                        null);
                dataService.set(
                        user,
                        tagValue,
                        ControllerUtils.getNullableStringsSet(allowPatterns),
                        ControllerUtils.getNullableStringsSet(forbiddenPatterns),
                        remoteAddress,
                        userIp);
            } catch (Exception e) {
                if (abortOnError) {
                    throw e;
                }
                errorMessages.add(TagErrorMessage.of(item.getTag(), e));
            }
        }

        return errorMessages;
    }


}



