@Service
@Slf4j
public class TagInfoService {
    private volatile List<Tag> allCached;
    private volatile long nextUpdateTime = 0;
    private volatile long cachedTTL = 5000;
    private final Evo evo;

    public TagInfoService(Evo evo) {
        this.evo = evo;
    }

    public List<Tag> getTagInfoCollection() {
        var startTime = System.currentTimeMillis();
        if (nextUpdateTime == 0) {
            fillCache(startTime);
        } else if (System.currentTimeMillis() > nextUpdateTime) {
            nextUpdateTime = Long.MAX_VALUE;
            fillCache(startTime);
        }
        return allCached;
    }

    private void fillCache(long startTime) {
        allCached = evo.tagNames(".*").stream()
                .sorted()
                .map(tn -> evo.findTag(tn))
                .collect(Collectors.toList());
        log.debug("getTagInfoCollection() updated cache in {}ms", System.currentTimeMillis() - startTime);
        if (nextUpdateTime == Long.MAX_VALUE || nextUpdateTime < startTime + cachedTTL) {
            nextUpdateTime = startTime + cachedTTL;
        }
    }

    public List<String> patternSearchTags(String objectPattern, String parameterPattern, Set<String> types, int limit) {
        var p = parameterPattern;
        val normalized = TagImpl.normalizeTagName(p);
        if(normalized.getValue() != Attributes.Value) {
            p = normalized.getKey();
        }
        val effectiveParameterPattern = p;

        var queryBuilder = Query.newBuilder()
                .setObjectPattern(objectPattern)
                .setParameterPattern(effectiveParameterPattern);

        var logInfo = new StringBuilder("types: ");
        if(types != null && !types.isEmpty()) {
            types.forEach(queryBuilder::addObjectTypeName);
            logInfo.append(types);
        }

        logInfo.append("; limit: ");
        if (limit >= 0) {
            logInfo.append(limit);
            queryBuilder.setLimit(limit);
        } else {
            logInfo.append("unlimited");
        }

        var query = queryBuilder.build();
        List<String> result = evo.tagNames(query);

        if (normalized.getValue() != Attributes.Value) {
            result = result.stream().map(s -> s + ":" + normalized.getValue()).toList();
        }
        return result;
    }

    private Pair<Set<Tag>, Set<String>> getFoundAndMissingTags(Collection<String> tags) {
        Set<String> missing = new HashSet<>();
        Set<Tag> tagInfoSet = new HashSet<>();
        for (var tag : tags) {
            try {
                var tagInfo = evo.findTag(tag);
                tagInfoSet.add(tagInfo);
            } catch (Exception e) { missing.add(tag);

            }
        }
        return Pair.of(tagInfoSet, missing);
    }
    public Set<Tag> getTagInfoList(Collection<String> tags, boolean muteIfMissing) {
        var foundAndMissing = getFoundAndMissingTags(tags);
        if (foundAndMissing.getSecond().size() > 0) {
            if (muteIfMissing) {
                log.debug("Ненайденные теги: {}", foundAndMissing.getSecond());
            } else {
                throw new TagNotFoundException(foundAndMissing.getSecond().toString());
            }
        }
        return foundAndMissing.getFirst();
    }

    public Map<String, TagInfoRichDTO> getTagMetaDtoList(Set<String> nameSet){
        var foundAndMissing = getFoundAndMissingTags(nameSet);
        var result =  foundAndMissing.getFirst().stream()
                .map(t -> TagInfoRichDTO.builder()
                        .systemId(t.getTagKey().getSystemId())
                        .name(t.getTagName())
                        .objectTypeName(t.getObjectTypeName())
                        .objectTypeId(null)
                        .objectId(t.getTagKey().getObjectId())
                        .label(t.getParameterDescription())
                        .objectLabel(t.getObjectDescription())
                        .parameterId(t.getTagKey().getParameterId())
                        .valueAttrType(t.getValueType())
                        .valueFieldName(getValueFieldName(t))
                        .build())
                .collect(Collectors.toMap(t -> t.getName(), t -> t));

        foundAndMissing.getSecond().forEach(t -> result.put(t, null));
        return result;
    }

    public static String getValueFieldName(tnt.evoscada.api.data.Tag tagInfo) {
        var valueAttrType = tagInfo.getValueType();
        switch (valueAttrType) {
            case BOOL:
                return "boolVar";
            case INT:
                return "intVar";
            case LONG:
                return "longVar";
            case FLOAT:
                return "floatVar";
            case DOUBLE:
                return "doubleVar";
            case STRING:
                return "stringVar";
            case TIME:
                return "timeVar";
            case BYTES:
                return "bytesVar";
            case DYN_BOOL:
                return "dynBoolVar";
            case DYN_INT:
                return "dynIntVar";
            case DYN_LONG:
                return "dynLongVar";
            case DYN_FLOAT:
                return "dynFloatVar";
            case DYN_DOUBLE:
                return "dynDoubleVar";
            case DYN_STRING:
                return "dynStringVar";
            case DYN_TIME:
                return "dynTimeVar";
            case DYN_BYTES:
                return "dynBytesVar";
            case UNKNOWN:
            case FOLDER:
            default:
                return "";
        }
    }
