    private boolean freeSession(Long sessionId) {
        var evoCoreData = multitoneEvo.get(sessionId);
        if (evoCoreData != null) {
            try {
                evoCoreData.getSecond().run();
            } catch (Exception e) {
                log.error("Не удалось освободить ресурсы от сессии " + sessionId);
                throw new RuntimeException(e);
            }
            multitoneEvo.remove(sessionId);
            log.info("Удалили сущность EvoCore для сессии {}", sessionId);
        } else {
            log.info("Не пришлось удалять EvoCore для сессии {}, уже не существовало", sessionId);
        }
        return true;
    }

    @Override
    public void destroy() {
        multitoneEvo.keySet().forEach(id -> freeSession(id));
