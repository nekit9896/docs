package tnt.tnscada.hmi.datastream;

import tnt.evoscada.api.data.Tag;

import java.util.*;
import java.util.function.Function;
import java.util.stream.Collectors;

public class TimelineBucket<TValue> {
    private final Map<String, TValue> tagNameToValue = new HashMap<>();
    private final Set<String> tagNamesLoaded = new HashSet<>();

    public void acceptValue(TValue newValue, Function<TValue, Tag> getTag, Function<TValue, Date> getTimestamp) {
        if (newValue == null) {
            return;
        }
        var tagName = getTag.apply(newValue).getTagName();
        var existingValue = tagNameToValue.get(tagName);
        if (existingValue != null && getTimestamp.apply(existingValue).after(getTimestamp.apply(newValue))) {
            return;
        }
        tagNameToValue.put(tagName, newValue);
        tagNamesLoaded.add(tagName);
    }

    public void acceptTagValues(Collection<TValue> newValues,
                                Function<TValue, Tag> getTag, Function<TValue, Date> getTimestamp){
        newValues.forEach(v -> acceptValue(v, getTag, getTimestamp));
    }

    public TimelineBucket() {

    }
    public TimelineBucket(Collection<TValue> newValues,
                          Function<TValue, Tag> getTag, Function<TValue, Date> getTimestamp) {
        acceptTagValues(newValues, getTag, getTimestamp);
    }

    public void markTagNamesLoaded(Set<String> tagNames) {
        tagNamesLoaded.addAll(tagNames);
    }

    public boolean isTagsLoaded(Set<String> tagNames) {
        return tagNamesLoaded.containsAll(tagNames);
    }

    public Set<String> getMissingTags(Set<String> tagNames) {
        return tagNames.stream().filter(t -> !tagNamesLoaded.contains(t)).collect(Collectors.toSet());
    }

    public Collection<TValue> getTagValues() {
        return tagNameToValue.values();
    }
}



