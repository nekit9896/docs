    async function sendValue(tagName, valueAttr, value, invalid){
        if (historyMode) {
            if (!confirm("Сейчас Исторический режим данных, изменения не будут отображены. Продолжить?")===true) {
                return;
            }
        }
        let callBody = {
            "cmd": "TAG_SET",
            "args": []
        };

        try {
            callBody.args.push({
                "tag": tagName,
                "data": {
                    "value": stringToJSON(value, valueAttr),
                    "invalid": !!invalid
                }
            });
        } catch (e) {
            return "Ошибка подготовки запроса: " + e.message;
        }

        return await callBySocket(callBody, 5000)
            .then(resp => resp)
            .catch(reason => {
                console.log(reason);
                return "Ошибка: " + reason.message;
        })
    }

