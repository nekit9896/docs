        let tagsCopy = tags.slice();
        while (tagsCopy.length) {
            setVarProgressBar(tags.length - tagsCopy.length, tags.length, 'Загрузка типов');
            let batch = tagsCopy.splice(0, windowWidth);
            await fetchTagsType(batch)
                .then( results => {
                    results.forEach( (v,k) => {
                        out.set(k, v);
                    })
                });
        }
        return out;
