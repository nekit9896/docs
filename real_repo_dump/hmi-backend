    function stringToJSON(value, dataType) {
        if (dataType==="stringVar") {
            return value;
        } else if (dataType==="timeVar") {
            return stringToTimeVar(value);
        } else if (dataType === 'dynTimeVar') {
            return JSON.parse(value).map(s => stringToTimeVar(s));
        } else if (dataType.startsWith("dyn")) {
            return JSON.parse(value);
        } else if (dataType === "boolVar") {
            return value === "1" ? true : value === "0" ? false : JSON.parse(value);
        } else {
            return JSON.parse(value);
        }
    }

    function JSONtoString(data, dataType) {
        if(dataType === null || dataType === '') {
            return JSON.stringify(data);
        }
        let value = data.value;
        if (dataType === 'stringVar') {
            return value;
        } else if (dataType === 'timeVar') {
            return timeVarToString(value);
        } else if (dataType === 'dynTimeVar') {
            return value != null ? JSON.stringify(value.map(v => timeVarToString(v)), null, 2) : JSON.stringify([]);
        } else if (dataType.startsWith('dyn')) {
            return value != null ? JSON.stringify(value, null, 2) : JSON.stringify([]);
        }else {
            return JSON.stringify(value, null, 2);
        }
    }

