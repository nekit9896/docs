    public ModelEvoApiManager(MetadataService metadataService, ConsensusService consensusService,
                              Environment environment, MeterRegistry meterRegistry,
                              DataManagerService dataManagerService, KafkaManagerProperties kafkaManagerProperties,
                              ProducerFactory<TnMsg.Key, TnMsg.Msg> producerFactory,
                              ConcurrentKafkaListenerContainerFactory<TnMsg.Key, TnMsg.Msg> kafkaListenerContainerFactory,
                              ConcurrentKafkaListenerContainerFactory<TnMsg.Key, TnMsg.Msg> kafkaAlarmListenerContainerFactory,
                              CacheableTagInfoStore tagInfoStore, EvoManagerProperties evoManagerProperties
                              ) {
        this.metadataService = metadataService;
        this.consensusService = consensusService;
        this.environment = environment;
        this.meterRegistry = meterRegistry;
        this.dataManagerService = dataManagerService;

        this.producerFactory = producerFactory;
        this.kafkaListenerContainerFactory = kafkaListenerContainerFactory;
        this.kafkaAlarmListenerContainerFactory = kafkaAlarmListenerContainerFactory;
        this.tagInfoStore = tagInfoStore;
