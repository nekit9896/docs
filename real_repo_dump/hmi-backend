                break;
            case FLOAT:
                checkTypes(tagName, valueCase, TnMsg.ValueMsg.ValueCase.FLOATVAR, valueType);
                break;
            case DOUBLE:
                checkTypes(tagName, valueCase, TnMsg.ValueMsg.ValueCase.DOUBLEVAR, valueType);
                break;
            case STRING:
                checkTypes(tagName, valueCase, TnMsg.ValueMsg.ValueCase.STRINGVAR, valueType);
                break;
            case TIME:
                checkTypes(tagName, valueCase, TnMsg.ValueMsg.ValueCase.TIMEVAR, valueType);
                break;
            case BYTES:
                checkTypes(tagName, valueCase, TnMsg.ValueMsg.ValueCase.BYTESVAR, valueType);
                break;
            case DYN_BOOL:
                checkTypes(tagName, valueCase, TnMsg.ValueMsg.ValueCase.DYNBOOLVAR, valueType);
                break;
            case DYN_INT:
                checkTypes(tagName, valueCase, TnMsg.ValueMsg.ValueCase.DYNINTVAR, valueType);
                break;
            case DYN_LONG:
                checkTypes(tagName, valueCase, TnMsg.ValueMsg.ValueCase.DYNLONGVAR, valueType);
                break;
            case DYN_FLOAT:
                checkTypes(tagName, valueCase, TnMsg.ValueMsg.ValueCase.DYNFLOATVAR, valueType);
                break;
            case DYN_DOUBLE:
                checkTypes(tagName, valueCase, TnMsg.ValueMsg.ValueCase.DYNDOUBLEVAR, valueType);
                break;
            case DYN_STRING:
                checkTypes(tagName, valueCase, TnMsg.ValueMsg.ValueCase.DYNSTRINGVAR, valueType);
                break;
            case DYN_TIME:
                checkTypes(tagName, valueCase, TnMsg.ValueMsg.ValueCase.DYNTIMEVAR, valueType);
                break;
            case DYN_BYTES:
                checkTypes(tagName, valueCase, TnMsg.ValueMsg.ValueCase.DYNBYTESVAR, valueType);
                break;
        }
    }

    private static void checkTypes(
            String tagName,
            TnMsg.ValueMsg.ValueCase actual,
            TnMsg.ValueMsg.ValueCase expected,
            TagValueType valueType
    ) {
        if (actual != expected) {
            throw new ValueConversionException(
                    String.format("Tag '%s' has value type: %s, ValueMsg.value expected: %s but was: %s",
                            tagName, valueType, expected, actual)
            );
        }
    }
}



