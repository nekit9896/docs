package tnt.tnscada.hmi.service;


import com.google.protobuf.util.JsonFormat;
import jakarta.annotation.PreDestroy;
import lombok.extern.slf4j.Slf4j;
import lombok.val;
import org.apache.logging.log4j.util.Strings;
import org.jetbrains.annotations.NotNull;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.boot.autoconfigure.web.ServerProperties;
import org.springframework.http.client.reactive.ReactorClientHttpConnector;
import org.springframework.stereotype.Component;
import org.springframework.web.reactive.function.client.WebClient;
import org.springframework.web.reactive.socket.WebSocketHandler;
import org.springframework.web.reactive.socket.WebSocketSession;
import org.springframework.web.reactive.socket.client.ReactorNettyWebSocketClient;
import reactor.core.publisher.Flux;
import reactor.core.publisher.Mono;
import reactor.netty.http.client.HttpClient;
import tnt.evoscada.api.Evo;
import tnt.evoscada.api.Query;
import tnt.evoscada.manager.config.EvoManagerProperties;
import tnt.tnscada.core.kafkamanager.kafka.KafkaManager;
import tnt.tnscada.core.message.protobuf.HmiMsg;
import tnt.tnscada.core.message.protobuf.TnMsg;
import tnt.tnscada.core.name.NameDecorator;

import java.net.URI;
import java.time.Duration;
import java.util.List;
import java.util.Random;
import java.util.concurrent.Executors;
import java.util.concurrent.ScheduledExecutorService;
import java.util.concurrent.TimeUnit;
import java.util.stream.Collectors;

@Slf4j
@Component
public class AppWarmUp {
    private final KafkaManager kafkaManager;
    private final EvoManagerProperties evoManagerProperties;
    private final int serverPort;
    private final String websocketEndpoint;
    private final Evo evo;
    private final String tagNamesPattern;
    private final List<String> findTagList;
    private final int kafkaProducerWarmUpInterval;
    private final ScheduledExecutorService scheduledExecutorService = Executors.newSingleThreadScheduledExecutor();

    public AppWarmUp(
            KafkaManager kafkaManager,
            EvoManagerProperties evoManagerProperties,
            ServerProperties serverProperties,
            @Value("${websockets.endpoint:/hotlink}")
            String websocketEndpoint,
            Evo evo,
            @Value("${tn-scada.hmi-backend.warm-up.tag-names-pattern:}")
            String tagNamesPattern,
            @Value("${tn-scada.hmi-backend.warm-up.find-tag-list:}")
            List<String> findTagList,
            @Value("${tn-scada.hmi-backend.warm-up.producer-interval-ms:2000}")
            Integer kafkaProducerWarmUpInterval
    ) {
        this.kafkaManager = kafkaManager;
        this.evoManagerProperties = evoManagerProperties;
        this.serverPort = serverProperties.getPort();
        this.websocketEndpoint = websocketEndpoint;
        this.evo = evo;
        this.tagNamesPattern = tagNamesPattern;
        this.findTagList = findTagList;
        this.kafkaProducerWarmUpInterval = kafkaProducerWarmUpInterval;
    }

    @PreDestroy
    public void destroy() {
        scheduledExecutorService.shutdown();
    }

    public void warmUp() {
        kafkaProducerWarmUp();
        websocketWarmUp();
        tagSetWarmUp();
        tagInfoStoreWarmUp();
    }

    private void tagInfoStoreWarmUp() {
        if (!Strings.isBlank(tagNamesPattern)) {
            var tags = evo.tagNames(Query.newBuilder().setObjectPattern(tagNamesPattern).setLimit(100).build());
            log.info("tagNames прогревание завершено, получено {} тегов для [{}]", tags.size(), tagNamesPattern);
        }

        if (findTagList != null && !findTagList.isEmpty()) {
            findTagList.forEach(evo::findTag);
            log.info("findTag прогревание завершено");
        }
    }

    public boolean isIgnoreTagSet(Object body) {
        return tagSetBody != null && tagSetBody.equals(body);
    }

    public boolean isIgnoreTagsSet(Object body) {
        return tagsSetBody != null && tagsSetBody.equals(body);
    }

    private Object tagSetBody;
    private Object tagsSetBody;

    private void tagSetWarmUp() {
        String url = "ws://localhost:" + serverPort;
        val httpClient = HttpClient.create();

        var webClient = WebClient.builder()
                .baseUrl(url)
                .clientConnector(new ReactorClientHttpConnector(httpClient))
                .build();

        var tagValueMsg = HmiMsg.TagValueMsg.newBuilder()
                .setTag(randomTagName() + ".")
                .setValue(TnMsg.ValueMsg.newBuilder()
                                  .setInvalid(true)
                                  .setBoolVar(true)
                                  .build())
                .build();

        tagSetBody = tagValueMsg;

        HmiMsg.BatchedTagValueMsg batchedTagValueMsg = HmiMsg.BatchedTagValueMsg.newBuilder()
                .addTagValueBatch(
                        tagValueMsg
                )
                .build();

        tagsSetBody = batchedTagValueMsg;

        try {
            var printer = JsonFormat.printer()
                    .preservingProtoFieldNames()
                    .omittingInsignificantWhitespace();

            String tagValueMsgJson = printer.print(tagValueMsg);
            String batchedTagValueMsgJson = printer.print(batchedTagValueMsg);

            webClient
                    .post()
                    .uri("/tag-set")
                    .header("Content-Type", "application/json;charset=utf-8")
                    .bodyValue(tagValueMsgJson)
                    .retrieve()
                    .bodyToMono(Object.class)
                    .block();

            tagSetBody = null;

            webClient
                    .post()
                    .uri("/tags-set")
                    .header("Content-Type", "application/json;charset=utf-8")
                    .bodyValue(batchedTagValueMsgJson)
                    .retrieve()
                    .bodyToMono(Object.class)
                    .block();
        } catch (Exception ignore) {
        }

        tagsSetBody = null;

        log.info("tags-set прогревание завершено");
    }

    private String randomTagName() {
        String characters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ___abcdefghijklmnopqrstuvwxyz___0123456789";
        Random random = new Random();

        return random.ints(20, 0, characters.length())
                .mapToObj(characters::charAt)
                .map(Object::toString)
                .collect(Collectors.joining());
    }

    private void kafkaProducerWarmUp() {
        scheduledExecutorService.scheduleWithFixedDelay(() -> {
            List<String> hotTopics = evoManagerProperties.getSubscription().getHotTopics();
            if (hotTopics.isEmpty()) return;

            var ts = System.currentTimeMillis();
            var key = TnMsg.Key.newBuilder().setSystemId(0).setObjectId(0).setParameterId(0).setAttrId(0).build();
            var msg = TnMsg.Msg.newBuilder().setMsgData(
                    TnMsg.MsgData.newBuilder()
                            .setTimeStamp(ts)
                            .setService(evoManagerProperties.getAppId())
            ).build();
            for (var topic : hotTopics) {
                var compact = NameDecorator.decorateCompactTopicName(topic);
                kafkaManager.send(topic, key, msg);
                kafkaManager.send(compact, key, msg);
            }
        }, 0, kafkaProducerWarmUpInterval, TimeUnit.MILLISECONDS);


        log.info("KafkaProducer прогревание завершено");
    }

    private void websocketWarmUp() {
        var webSocketClient = new ReactorNettyWebSocketClient();

        try {
            String websocketUrl = "ws://localhost:" + serverPort + websocketEndpoint;
            URI uri = URI.create(websocketUrl);

            webSocketClient
                    .execute(uri, new ReactiveWarmupHandler())
                    .timeout(Duration.ofSeconds(60000))
                    .onErrorResume(e -> {
                        log.info("WebSocket прогревание завершено с ошибкой (нормально): {}", e.getMessage());
                        return Mono.empty();
                    })
                    .block();

            log.info("WebSocket прогревание завершено");
        } catch (Exception e) {
            log.warn("Ошибка при создании URI для прогревания: {}", e.getMessage());
        }
    }

    private static class ReactiveWarmupHandler implements WebSocketHandler {
        @Override
        public @NotNull Mono<Void> handle(WebSocketSession session) {
            Flux<String> pingMessages = Flux.just("PING", "SUBSCRIBE TEST_TAG.VALUE", "PING")
                    .delayElements(Duration.ofMillis(100));

            Mono<Void> sendMessages = session.send(
                    pingMessages.map(session::textMessage)
            );

            Mono<Void> receiveMessages = session.receive()
                    .take(Duration.ofSeconds(1)) // Принимаем сообщения в течение 1 секунды
                    .then();

            return Mono.zip(sendMessages, receiveMessages)
                    .timeout(Duration.ofSeconds(2))
                    .onErrorResume(e -> Mono.empty())
                    .then();
        }
    }
}



