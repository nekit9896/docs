@Slf4j
@Component
@RequiredArgsConstructor
public class HotlinkService {
    private final Evo evo;
    private final Map<String, HotlinkWaitValueSession> waitSessions = new ConcurrentHashMap<>();

    public String initWaitSession(HmiMsg.TagValueMsg tagValueMsg) {
        var waitSession = new HotlinkWaitValueSession(tagValueMsg, evo);
        waitSessions.put(waitSession.getId(), waitSession);
        log.debug("Added waitSession {}, total sessions: {}", waitSession.getId(), waitSessions.size());
