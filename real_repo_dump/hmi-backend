            }
    )
    public List<ProjectResponse> getProjects(
            @RequestParam(value = "page", required = false) Integer page,
            @RequestParam(value = "size", required = false) Integer size
    ) {

        return paginate(store.getProjects().entrySet().stream().sorted(Map.Entry.comparingByKey()), page, size)
                .map(p -> new ProjectResponse(p.getValue(), p.getKey()))
                .toList();
    }

