package tnt.tnscada.hmi.filter;

import io.opentelemetry.api.trace.Span;
import jakarta.servlet.*;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import lombok.extern.slf4j.Slf4j;
import org.apache.commons.lang3.StringUtils;
import org.slf4j.MDC;
import org.springframework.core.annotation.Order;
import org.springframework.stereotype.Component;

import java.io.IOException;
import java.net.URLDecoder;
import java.nio.charset.StandardCharsets;
import java.util.Arrays;
import java.util.List;
import java.util.Objects;
import java.util.UUID;
import java.util.stream.Collectors;

@Component
@Order(1)
@Slf4j
public class RequestInfoFilter implements Filter {

    private static final String requestIdHeader = "X-REQUEST-ID";
    private static final List<String> logHeaders = List.of("X-WB-REQUEST-TS", "X-USER-ID", "X-USER-FULLNAME",
            "X-USER-ALLOW-PATTERNS", "X-USER-FORBIDDEN-PATTERNS", "X-USER-IP",
            "Traceparent", "Baggage", "tracestate", "X-B3-TraceId", "X-B3-SpanId" );
    @Override
    public void doFilter(ServletRequest servletRequest, ServletResponse servletResponse, FilterChain filterChain)
            throws IOException, ServletException {
        var start = System.currentTimeMillis();
        var req = new MultiReadHttpServletRequest((HttpServletRequest) servletRequest);

        String requestId = req.getHeader(requestIdHeader);
        if (StringUtils.isEmpty(requestId)) {
            requestId = UUID.randomUUID().toString().replaceAll("-", "");
        }
        HttpServletResponse httpServletResponse = (HttpServletResponse) servletResponse;
        httpServletResponse.setHeader(requestIdHeader, requestId);

        if (Span.current() != null) {
            httpServletResponse.setHeader("X-Trace-ID", Span.current().getSpanContext().getTraceId());
            httpServletResponse.setHeader("X-Span-ID", Span.current().getSpanContext().getSpanId());
        }

        MDC.put("requestId", requestId);

        String content = req.getReader().lines().collect(Collectors.joining("\n"));
        String logContent = "";
        if (content.length() > 0) {
            if (req.getContentType().contains("zip")) {
                logContent = String.format("    Content-Type: %s    Content-Length: %d", req.getContentType(), content.length());
            } else {
                logContent = String.format("    Content-Type: %s    Content-Length: %d    Content:\n%s", req.getContentType(), content.length(), content);
            }
        }
        var headersInfo = logHeaders.stream()
                .filter(h -> !Objects.isNull(req.getHeader(h))).
                collect(Collectors.toMap(h -> h, h -> URLDecoder.decode(req.getHeader(h), StandardCharsets.UTF_8)));
        var parametersInfo = new StringBuilder();
        req.getParameterMap().entrySet().forEach(e -> {
            parametersInfo.append(e.getKey()).append("=").append(Arrays.toString(e.getValue())).append("; ");
        });
        log.info("Request: {}   {}   {} {} {}: {}{}", req.getMethod(), req.getRequestURI(), parametersInfo, headersInfo, requestIdHeader, requestId, logContent);
        try {
            filterChain.doFilter(req, servletResponse);
        } finally {
            log.info("Response: {} for {}   {}  {}: {}  time: {}ms",  httpServletResponse.getStatus(), req.getMethod(), req.getRequestURI(), requestIdHeader, requestId, System.currentTimeMillis() - start);
            MDC.clear();
        }
    }
}



