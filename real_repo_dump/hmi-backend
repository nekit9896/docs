public class TopologyTestConfig {
    private Integer maxElCount = 100;
    public static String KAFKA_TOPIC = "some-test-topic";

    @Bean("map")
    public Meta map() {
        var meta = new Meta();
        Map<TnMsg.Key, TagInfo> tagIdInfoMap = meta.tagIdInfoMap;
        Map<String, ObjectIdentifier> objectIdentifierMap = meta.objectIdentifierMap;

        var root = new ParameterIdentifier(
                1,
                -1,
                "TEST",
                ValueAttrType.FOLDER.getValueAttrType(),
                "Test structure"
        );
        var parameterFloat = new ParameterIdentifier(
                2,
                1,
                "ValueFloat",
                ValueAttrType.FLOAT.getValueAttrType(),
                "Any Float Data"
        );
        var parameterBool = new ParameterIdentifier(
                3,
                1,
                "ValueBoolean",
                ValueAttrType.BOOL.getValueAttrType(),
                "Any Boolean Data"
        );
        List<ParameterIdentifier> parameterIdentifierList = new ArrayList<>();
        parameterFloat.setParent(root);
        parameterBool.setParent(root);
        parameterIdentifierList.add(root);
        root.makeFullName();

        var childParams = Set.of(parameterFloat, parameterBool);

        for (var c : childParams) {
            root.addChild(c);
            parameterIdentifierList.add(c);
            c.makeFullName();
        }

        Map<Integer, ParameterIdentifier> parameterIdentifierMap = parameterIdentifierList
                .stream()
                .collect(Collectors.toMap(ParameterIdentifier::getId, Function.identity()));

        ProjectIdentifier projectIdentifier = new ProjectIdentifier(1, "TU1");

        var type = new ObjectTypeIdentifier(projectIdentifier, 1, "TEST", parameterIdentifierList, parameterIdentifierMap);

        var topic = new TopicIdentifier(1, KAFKA_TOPIC);

        for (int i = 1; i <= maxElCount; i++) {
            var object = new ObjectIdentifier(i, type, "test_" + i, "label_test_" + i);

            objectIdentifierMap.put(object.getName(), object);

            for (var p : parameterIdentifierList) {
                var attr = new AttributeIdentifier(
                        object,
                        p,
                        Attributes.Value,
                        topic,
                        DescentRule.node
                );

                var key = TnMsg.Key.newBuilder()
                        .setSystemId(0)
                        .setObjectId(object.getId())
                        .setParameterId(p.getId())
                        .setAttrId(Attributes.Value.getAttrId())
                        .build();

                var tagInfo = new TagInfo(key, attr);

                tagIdInfoMap.put(key, tagInfo);
            }
        }

        return meta;
    }

    static {
        ProjectIdentifier.DEFAULT_PROJECT.setOptionalName(true);
        ProjectIdentifier.DEFAULT_PROJECT.setName("");
    }

    @Bean("LowCacheableTagInfoStore")
    @Primary
    public CacheableTagInfoStore tagInfoStore(@Qualifier("map") Meta meta) {
        return new CacheableTagInfoStore() {

            private final Map<TnMsg.Key, TagInfo> tagIdInfoMap = meta.tagIdInfoMap;
            private final Map<String, ObjectIdentifier> objectIdentifierMap = meta.objectIdentifierMap;
            private final Map<String, TagInfo> tagNameInfoMap = tagIdInfoMap.values()
                    .stream()
                    .collect(Collectors.toMap(TagInfo::getTagName, t -> t));
            private final Map<String, ObjectTypeIdentifier> types = objectIdentifierMap.values().stream()
                    .map(oi -> oi.getObjectTypeIdentifier())
                    .collect(Collectors.toMap(ti -> ti.getName(), ti -> ti, (o, o2) -> o));

            @Override
            public ObjectIdentifier getObject(String name) {
                return objectIdentifierMap.get(name);
            }

            @Override
            public ObjectIdentifier getObject(TnMsg.Key key) {
                return objectIdentifierMap.get(tagIdInfoMap.get(key).getTagName());
            }

            @Override
            public Stream<ObjectIdentifier> getObjects() {
                return objectIdentifierMap.values().stream();
            }

//            @Override
//            public Stream<ObjectIdentifier> getObjects(int projectId) {
//                return null;
//            }

            @Override
            public ObjectTypeIdentifier getObjectType(String typeName) {
                return types.get(typeName);
            }

            @Override
