    <label>Курсор <input type="datetime-local" id="datetimeCursor" step="1"></label>
    <button onclick="setCursorAt()" title="Установить курсор в позицию">⌖︎</button> <label><input type="checkbox" id="updateCursor" value="1" checked>Обновлять поле курсора при проигрывании</label> <br/>
    <span id="waitIndicator" class="inactive" title="Вынужденное ожидание">⏳</span> <button id="playBtn" onclick="play()" title="Включить проигрывание">▶︎</button>
