    private void subscribe(
            Map<String, String> cmdHeaders,Set<String> valueArgs, Set<String> alarmArgs, Set<String> attributeArgs) throws Exception {
        if(valueArgs.size() == 0 && alarmArgs.size() == 0 && attributeArgs.size() == 0) {
            throw new Exception("No valid args specified for command SUBSCRIBE");
        }

        if(valueArgs.size() > 0) {
            doOnFoundTags(cmdHeaders, valueArgs, false, foundTags ->
                streamProviders.forEach(sp -> sp.valueSubscribe(foundTags)), Command.SUBSCRIBE.toString(), true);
        }

        if(alarmArgs.size() > 0) {
            doOnFoundTags(cmdHeaders, alarmArgs, true, foundTags ->
                streamProviders.forEach(sp -> sp.alarmSubscribe(foundTags)), Command.SUBSCRIBE.toString(), true);
        }

        if(attributeArgs.size() > 0) {
            doOnFoundTags(cmdHeaders, attributeArgs, true, foundTags ->
                streamProviders.forEach(sp -> sp.attributeSubscribe(foundTags)), Command.SUBSCRIBE.toString(), true);
        }
    }

    private void unsubscribe(
            Map<String, String> cmdHeaders, Set<String> valueArgs, Set<String> alarmArgs, Set<String> attributeArgs) throws Exception {
        if(valueArgs.size() == 0 && alarmArgs.size() == 0 && attributeArgs.size() == 0) {
            throw new Exception("No valid args specified for command UNSUBSCRIBE");
        }

        if(valueArgs.size() > 0) {
            doOnFoundTags(cmdHeaders, valueArgs, false, foundTags ->
                streamProviders.forEach(sp -> sp.valueUnsubscribe(foundTags)), Command.UNSUBSCRIBE.toString(), false);
        }

        if(alarmArgs.size() > 0) {
            doOnFoundTags(cmdHeaders, alarmArgs, true, foundTags ->
                streamProviders.forEach(sp -> sp.alarmUnsubscribe(foundTags)), Command.UNSUBSCRIBE.toString(), false);
        }

        if(attributeArgs.size() > 0) {
            doOnFoundTags(cmdHeaders, attributeArgs, true, foundTags ->
                streamProviders.forEach(sp -> sp.attributeUnsubscribe(foundTags)), Command.UNSUBSCRIBE.toString(), false);
        }
    }

    private void doOnFoundTags(
            Map<String, String> cmdHeaders,
            Set<String> tags,
            boolean normalizeOnFind,
            Consumer<Set<Pair<Tag, Attributes>>> consumer,
            String operation,
            boolean checkGetAccess) {
        Set<String> missingTags = new HashSet<>();
        Set<String> forbiddenTags = new HashSet<>();
        Set<String> notVariableTags = new HashSet<>();
        Set<Pair<Tag, Attributes>> foundTags = new HashSet<>();

        tags.forEach(tagName -> {
            try {
                val normalized = TagImpl.normalizeTagName(tagName);
                val finalTag = normalizeOnFind ? normalized.getKey() : tagName;

                if(checkGetAccess && !DataServiceBase.hasTagNameAccess(
                        finalTag, getAllowGetPatterns(cmdHeaders), getForbiddenGetPatterns(cmdHeaders))) {
                    forbiddenTags.add(finalTag);
                    return;
                }

                val tag = evo.findTag(finalTag);
                if(!tag.getValueType().isVariable() && ! DataServiceBase.FOLDER_ATTRIBUTES.contains(normalized.getValue())) {
                    notVariableTags.add(tagName);
                    return;
                }
                foundTags.add(Pair.of(tag, normalized.getRight()));
            }
            catch (TagNotFoundException ignored) {
                missingTags.add(tagName);
            }
        });

        if (missingTags.size() > 0) {
            missingTags.forEach(t -> msgConsumer.accept(new AnswerItem(t, null,
                    "Tag not found for " + operation)));
        }

        if (forbiddenTags.size() > 0) {
            forbiddenTags.forEach(t -> msgConsumer.accept(new AnswerItem(t, null,
                    "Tag access is forbidden for " + operation)));
        }

        if (notVariableTags.size() > 0) {
            notVariableTags.forEach(t -> msgConsumer.accept(new AnswerItem(t, null,
                                                                         "Tag has non-variable type for " + operation)));
        }

        if(foundTags.size() > 0) {
            consumer.accept(foundTags);
        }
    }

    @Override
