    @Override
    public void setActive(boolean active) {
        isActive = active;
        if (!active) {
            return;
        }

        synchronized (valueSubscriptions) {
            effectiveValueCallback(
                    valueSubscriptions.values().stream().flatMap(c -> c.getTags().stream().map(evo::tagGet)).toList());
        }
    }

    private void effectiveRouteCallback(List<TagValue> tagValues, boolean deleted) {
        if (isActive) {
            valueCallback.accept(tagValues.stream().map(tv -> Pair.of(tv, deleted)).toList());
        }
    }

    private void effectiveValueCallback(List<TagValue> tagValues) {
        if(isActive) {
            valueCallback.accept(tagValues.stream().map(tv -> Pair.of(tv, false)).toList());
        }
    }

    private void effectiveAlarmCallback(List<TagAlarm> tagAlarms) {
        if (isActive) {
            alarmCallback.accept(tagAlarms);
        }
    }

    private void effectiveAttributeCallback(ConfigurationAttribute attribute) {
        if (isActive) {
            attributeCallback.accept(attribute);
        }
    }

