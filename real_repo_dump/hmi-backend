    @Override
    protected void sendDtoCollection(Collection<HmiMsg.TagValueMsg> collection) {
       var json = ProtoConverter.toJson(
               HmiMsg.BatchedTagValueMsg.newBuilder().addAllTagValueBatch(collection).build());
       String summary = HotlinkMessageLogger.isLoggingEnabled()
               ? HotlinkMessageLogger.summarizeTagValueMsgs(collection)
               : null;
       sendToSession(json, "TAG_VALUE_BATCH", null, summary);
       if (collection != null) {
           tagChangeSentTick(collection.size());
       }
    }

    @Override
    public void acceptValues(List<TagValue> tagValues) {
        tagValues.forEach(tagValue -> msgConsumer.accept(TagValueUtils.mapToHmiTagValueMsg(tagValue)));
        if (tagValues != null) {
