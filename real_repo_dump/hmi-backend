package tnt.tnscada.hmi.utils;

import java.util.HashMap;
import java.util.LinkedHashMap;
import java.util.LongSummaryStatistics;
import java.util.concurrent.atomic.AtomicLong;

public class TickCollector {
    private LinkedHashMap<Long, AtomicLong> map;

    public TickCollector(int secondsLimit) {
        this.map = LimitedMap.newInstance(secondsLimit);
    }

    public void tick() {
        var counter = map.computeIfAbsent(System.currentTimeMillis()/1000, k -> new AtomicLong(0));
        counter.incrementAndGet();
    }
    public void tick(long increment) {
        var counter = map.computeIfAbsent(System.currentTimeMillis()/1000, k -> new AtomicLong(0));
        counter.addAndGet(increment);
    }

    public LongSummaryStatistics getStatistics(int windowSeconds) {
        var till = (System.currentTimeMillis()/1000) - 1;
        var from = till - windowSeconds;

        if (!map.isEmpty()) {
            var minimalKey = map.entrySet().iterator().next().getKey();
            if (minimalKey > from) {
                from = minimalKey;
            }
        }
        var timeline = new HashMap<Long, Long>();
        for (var i = from; i <= till; i++) {
            timeline.put(i, map.containsKey(i) ? map.get(i).get() : 0);
        }
        return timeline.values().stream().mapToLong(l -> l).summaryStatistics();
    }
}



