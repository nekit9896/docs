                .forEach(tagValueMsg -> set(user, tagValueMsg, allowPatterns, forbiddenPatterns, remoteAddress, userIp));
    }

    public HmiMsg.BatchedTagValueMsg gets(Collection<String> tagNames, Set<String> allowPatterns,
                                          Set<String> forbiddenPatterns, String auditUserIdentity) {
        var builder = HmiMsg.BatchedTagValueMsg.newBuilder();
        tagNames.stream().map(t -> {
            try {
                return get(t, allowPatterns, forbiddenPatterns, auditUserIdentity);
            }
            catch (ForbiddenException ignored) {
                return null;
            }
        }).filter(Objects::nonNull).forEach(builder::addTagValueBatch);
        return builder.build();
    }
}


