package tnt.tnscada.hmi.data;

import com.google.gson.Gson;
import com.google.gson.JsonElement;
import io.opentelemetry.instrumentation.annotations.WithSpan;
import lombok.extern.slf4j.Slf4j;
import lombok.val;
import org.apache.commons.lang3.tuple.Pair;
import tnt.evoscada.api.Evo;
import tnt.evoscada.api.TagSetResult;
import tnt.evoscada.api.constants.StatusBits;
import tnt.evoscada.api.data.Attributes;
import tnt.evoscada.api.data.Tag;
import tnt.evoscada.api.data.TagValue;
import tnt.evoscada.api.dto.configuration.ConfigurationAttribute;
import tnt.evoscada.manager.data.Resources;
import tnt.evoscada.manager.data.TagImpl;
import tnt.evoscada.manager.mapper.AttributeMapper;
import tnt.tnscada.core.message.protobuf.TnMsg;
import tnt.tnscada.hmi.errors.ForbiddenException;
import tnt.tnscada.hmi.errors.TagSetException;
import tnt.tnscada.hmi.hotlink.dto.TagSetRequest;
import tnt.tnscada.hmi.proto.ProtoValidator;
import tnt.tnscada.hmi.utils.TagValueUtils;

import java.util.ArrayList;
import java.util.List;
import java.util.Set;
import java.util.regex.Pattern;

@Slf4j
public abstract class DataServiceBase<TMsgDto, TValueDto> {
    protected final Evo evo;

    protected DataServiceBase(Evo evo) {
        this.evo = evo;
    }

    protected abstract TValueDto tagValueToValueDto(TagValue tagValue);

    protected abstract TMsgDto constructMsgDto(String tag, Object valueObj);

    protected abstract TValueDto valueDtoFromMsgDto(TMsgDto msg);

    protected abstract ConfigurationAttribute metaDataFromMsgDto(TMsgDto msg);

    protected abstract TMsgDto emptyMsgDto(String tag);

    protected abstract String getTag(TMsgDto msg);

    protected abstract long getTs(TMsgDto msg);

    protected abstract TnMsg.ValueMsg valueDtoToValueMsg(Tag tag, TValueDto valueDto);

    protected String answerTagName(Pair<String, Attributes> pair) {
        return answerTagName(pair.getKey(), pair.getValue());
    }

    protected String answerTagName(String normalized, Attributes attribute) {
        return attribute == Attributes.Value ? normalized : normalized + ":" + attribute;
    }

    public static final List<Attributes> VALUE_ATTRIBUTES = List.of(
            Attributes.Value,
            Attributes.OutOfService,
            Attributes.AlarmPrior,
            Attributes.AlarmAckable,
            Attributes.DefaultValue,
            Attributes.ExplicitlyDefault
    );

    public static final List<Attributes> METADATA_ATTRIBUTES =
            List.of(
                    Attributes.Address,
                    Attributes.AlertHdl,
                    Attributes.General,
                    Attributes.Route,
                    Attributes.ViewNode,
                    Attributes.Area,
                    Attributes.PvRange,
                    Attributes.MsgConverter
            );
    public static final List<Attributes> FOLDER_ATTRIBUTES =
            List.of(
                    Attributes.Area,
                    Attributes.General
            );

    @WithSpan
    public TMsgDto get(String tagName, Set<String> allowPatterns, Set<String> forbiddenPatterns, String auditUserIdentity) {
        log.trace("get: TagName {}, allowed {}, forbidden {}", tagName, allowPatterns, forbiddenPatterns);
        checkTagNameAccess(tagName, allowPatterns, forbiddenPatterns, auditUserIdentity);

        val normalized = TagImpl.normalizeTagName(tagName);

        if(VALUE_ATTRIBUTES.contains(normalized.getValue())) {
            var tagValue = evo.tagGet(tagName);
            if (tagValue != null) {
                return constructMsgDto(answerTagName(normalized), tagValue);
            } else {
                return emptyMsgDto(answerTagName(normalized));
            }
        }

        if(METADATA_ATTRIBUTES.contains(normalized.getValue())) {
            val tag = evo.findTag(normalized.getKey());
            val metadata = evo.tagConfiguration().getAttribute(tag, normalized.getValue());

            return constructMsgDto(answerTagName(normalized), metadata == null
                    ? AttributeMapper.getEmptyAttribute(tag, normalized.getValue())
                    : metadata);
        }

        return emptyMsgDto(answerTagName(normalized));
    }


    @WithSpan
    public void set(String user, TMsgDto msg, Set<String> allowPatterns,
                    Set<String> forbiddenPatterns, String remoteAddress, String userIp) {
        var tagName = getTag(msg);
        log.trace("set: TagName {}, allowed {}, forbidden {}", tagName, allowPatterns, forbiddenPatterns);
        checkTagNameAccess(tagName, allowPatterns, forbiddenPatterns, user);
        val normalized = TagImpl.normalizeTagName(tagName);

        if(VALUE_ATTRIBUTES.contains(normalized.getValue())) {
            val tagValue = makeTagValue(tagName, msg, userIp, user);
            doAudit(user, remoteAddress, tagName, tagValue);
            evo.tagSet(tagValue, true);
        }
        else if(METADATA_ATTRIBUTES.contains(normalized.getValue())) {
            var metadata = metaDataFromMsgDto(msg);
            if(metadata == null) {
                throw new IllegalArgumentException("metadata == null");
            }
            metadata.setTag(evo.findTag(normalized.getKey()));

            evo.tagConfiguration().setAttribute(metadata);
        }
    }

    private TagValue makeTagValue(String tagName, TMsgDto msg, String userIp, String user) {
        var tagInfo = evo.findTag(tagName);
        val valueDto = valueDtoFromMsgDto(msg);
        if(valueDto == null) {
            throw new IllegalArgumentException("valueDto == null");
        }

        var valueMsg = valueDtoToValueMsg(tagInfo, valueDto);
        var status = StatusBits.newBuilder().setSubstituted(true).setInvalid(valueMsg.getInvalid()).build();
        var curTime = System.currentTimeMillis();
        if (valueMsg.getChainTimeStampCount() == 0) {
            valueMsg = valueMsg.toBuilder().addChainTimeStamp(curTime).setStatus(status).build();
        } else {
            valueMsg = valueMsg.toBuilder().setChainTimeStamp(0, curTime).setStatus(status).build();
        }

        long signalTs = getTs(msg);
        if (signalTs == 0) {
            signalTs = curTime;
        }

        if (userIp == null) {
            userIp = "";
        }
        ProtoValidator.validate(tagInfo, valueMsg);
        var newValueMsg = TnMsg.Msg.newBuilder()
                .setMsgData(
                        TnMsg.MsgData.newBuilder()
                                .setService(Resources.APPLICATION_ID)
                                .setUser(user)
                                .setUserArm(userIp)
                                .setTimeStamp(signalTs)
                                .build()
                )
                .setValueMsg(valueMsg)
                .build();

        return TagValueUtils.toTagValue(tagInfo, newValueMsg);
    }

    @WithSpan
    public void setSync(String user, List<TMsgDto> messages, Set<String> allowPatterns,
                    Set<String> forbiddenPatterns, String remoteAddress, String userIp) {
        var tagNames = new ArrayList<>(messages.size());
        List<ConfigurationAttribute> attributes = new ArrayList<>();
        List<TagValue> tagValues = new ArrayList<>();
        for (var msg : messages) {
            var tagName = getTag(msg);
            log.trace("set: TagNames {}, allowed {}, forbidden {}", tagNames, allowPatterns, forbiddenPatterns);
            checkTagNameAccess(tagName, allowPatterns, forbiddenPatterns, user);
            val normalized = TagImpl.normalizeTagName(tagName);

            if(VALUE_ATTRIBUTES.contains(normalized.getValue())) {
                val tagValue = makeTagValue(tagName, msg, userIp, user);
                doAudit(user, remoteAddress, tagName, tagValue, true);
                tagValues.add(tagValue);
            }
            else if(METADATA_ATTRIBUTES.contains(normalized.getValue())) {
                var metadata = metaDataFromMsgDto(msg);
                if(metadata == null) {
                    throw new IllegalArgumentException("metadata == null");
                }
                metadata.setTag(evo.findTag(normalized.getKey()));

                attributes.add(metadata);
            }
        }

        if(!tagValues.isEmpty()) {
            var result = evo.tagSetWait(tagValues, true);
            if(result == TagSetResult.Error) {
                throw new TagSetException(result.getError());
            }
        }

        if(!attributes.isEmpty()) {
            evo.tagConfiguration().setAttribute(attributes);
        }
    }

    private static void checkTagNameAccess(String tagName, Set<String> allowPatterns, Set<String> forbiddenPatterns, String auditUserIdentity) {
        if (!hasTagNameAccess(tagName, allowPatterns, forbiddenPatterns)) {
            log.warn("No access for tagName: {} allowPatterns: {} forbiddenPatterns {}", tagName, allowPatterns, forbiddenPatterns);
            throw new ForbiddenException(String.format("Доступ к тегу %s запрещён, пользователь %s", tagName, auditUserIdentity == null ? "не указан": auditUserIdentity));
        }
    }

    public static boolean hasTagNameAccess(String tagName, Set<String> allowPatterns, Set<String> forbiddenPatterns) {
        if (forbiddenPatterns != null && !forbiddenPatterns.isEmpty()) {
            if(forbiddenPatterns.stream().anyMatch(p -> Pattern.matches(p, tagName))) {
                return false;
            }
        }
        if (allowPatterns != null) {
            var allowingPattern = allowPatterns.stream().filter(p -> Pattern.matches(p, tagName)).findFirst();
            return allowingPattern.isPresent();
        }

        return true;
    }

    protected void doAudit(String user, String remoteAddress, String tagName, TagValue newMsg, boolean sync) {
        var isCommandMessage = false;
        if (tagName.contains("Change") && tagName.endsWith(".Value")){
            try {
                Gson gson = new Gson();
                var json = gson.fromJson((String) newMsg.getValue(), JsonElement.class);

                if (json.isJsonArray() && !json.getAsJsonArray().isEmpty()) {
                    json.getAsJsonArray().forEach(cmd -> {
                        var cmdTag = cmd.getAsJsonObject().get("tag").getAsString();
                        var cmdNewValue = cmd.getAsJsonObject().get("value").getAsString();
                        doAuditForCommand(user, remoteAddress, cmdTag, cmdNewValue, tagName, sync);
                    });
                    isCommandMessage = true;
                }
            } catch (Exception e) {
                log.error("Не удалось разобрать JSON для тега {}: {}. Пример сообщения: {}",
                          tagName,
