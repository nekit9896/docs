    function plural(numeric, texts){
        let twoDigits = numeric % 100;
        if (10 <= twoDigits && twoDigits <= 20) {
            return numeric + " " + texts[2];
        }
        let digit = numeric % 10;
        switch (digit) {
            case 1: return numeric + " " + texts[0];
            case 2:
            case 3:
            case 4:
                return numeric + " " + texts[1];
            default:
                return numeric + " " + texts[2];
        }
    }

