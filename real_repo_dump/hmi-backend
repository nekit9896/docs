    async function loadHistoryData(){
        document.getElementById("historyDataLoadPart").disabled = true;
        let chunkNumToLoad = historyDataState.loadedDataByChunks.length;
        if (chunkNumToLoad > 0) {
            //В случае с LIVE-режимом последний кусок может быть недозаполненым, переподзагрузим
            let verifyChunk = chunkNumToLoad - 1;
            if (historyDataState.loadedDataByChunks[verifyChunk].length < historyDataState.step) {
                chunkNumToLoad = verifyChunk;
            }
        }
        let payload = {
            "startTime": historyDataState.start.getTime(),
            "endTime": historyDataState.finish.getTime(),
            "tags": historyDataState.tags,
            "limit": historyDataState.step,
            "offset": chunkNumToLoad * historyDataState.step,
            "returnBounds": historyDataState.bounds,
            "timeBucketWidth": historyDataState.timeBucketWidth
        };

        return fetch(`${wsUrl.value}/tags-get-history-flat`, {
            method: 'POST',
            headers: getHeadersObject(),
            body: JSON.stringify(payload)
        })
            .then(response => {
                document.getElementById("historyDataLoadPart").disabled = false;
                if (!response.ok) {
                    console.log(response);
                    return response.json().then(json => {throw new Error(json.message)});
                } else {
                    let elem = document.getElementById("historyDataLoadPart");
                    elem.classList.remove("errVal");
                    elem.title = "";
                    response.json().then( json => {applyHistoryData(chunkNumToLoad, json)});
                    return true;
                }
            })
            .catch(reason => {
                let elem = document.getElementById("historyDataLoadPart");
                elem.disabled = false;
                elem.classList.add("errVal");
                elem.title = reason.message;
                console.log(reason);
                return "Ошибка: " + reason.message;
            });
    }

    function subscribe(tagName, rowNum) {
        tagIndexMap.set(tagName, rowNum);
        tagAwaitsValue.add(tagName);
        if (websocketConnected) {
            socket.send(`SUBSCRIBE ${tagName}`);
        }
        restartAliveTimeout();
        triggerActivity();
    }

    function resumeSubscription(){
        if (historyMode) {
            switchToHistory();
            seek(streamCursorMillis);
            if (isPlaying) {
                play();
            }
        } else {
            switchToLive();
        }
        if (tagIndexMap.size > 0) {
            sessionInitAwaitingValues = true;
            let start = Date.now();
            let tags = Array.from(tagIndexMap.keys());
            while (tags.length > 0) {
                let batch = tags.splice(0, 2500);
                batch.forEach(t => tagAwaitsValue.add(t));
                socket.send(`SUBSCRIBE ${(batch.join(' '))}`);
            }
            console.log(`Подписка возобновлена за ${Date.now() - start}мс для ${tagIndexMap.size} элементов, ожидаем данные`);
            restartAliveTimeout();
            triggerActivity();
        }
    }

