            description = "Предоставляет список атрибутов Зоны отвественности по проекту",
            parameters = {
                    @Parameter(name = "project", description = "Имя проекта", required = true),
            }
    )
    public List<ResponsibilityAreaAttrDto> getAreaAttrs(@RequestParam(required = false) String project) {
        final var projectId = project != null ? store.getProjects().get(project) : null;

        return areaStore.getAll().entrySet().stream()
                .filter(p -> project == null || (projectId != null && projectId.equals(p.getKey().getSystemId())))
                .map(p -> {
                    final var areaMsg = p.getValue().getAreaMsg();
                    final var object = store.getObject(TnMsg.Key.newBuilder()
                            .setSystemId(p.getKey().getSystemId())
                            .setObjectId(p.getKey().getObjectId())
                            .setAttrId(Attributes.Object.getAttrId()).build());
                    if(Objects.isNull(object)) {
                        return null;
                    }
                    final var parameter = object.getObjectTypeIdentifier().getParameterIdentifierMap().get(p.getKey().getParameterId());
                    if(Objects.isNull(parameter)) {
                        return null;
                    }

                    return new ResponsibilityAreaAttrDto(
                            object.getName(true),
                            "." + parameter.getName(),
                            areaMsg.getActive(),
                            new HashSet<>(areaMsg.getNameList()));
                })
                .filter(Objects::nonNull)
                .toList();
    }

    @GetMapping("/v1/general_attr/{object}")
    @Operation(
            summary = "Фильтрация General атрибута по имени объекта",
            description = "Предоставляет список General атрибутов объекта по его уникальному имени",
            parameters = {
                    @Parameter(name = "object", description = "Имя объекта", required = true),
            }
    )
    public List<GeneralDto> getGeneralByObject(@PathVariable("object") String objectName) {
        final var object = store.getObject(objectName);
        if(Objects.isNull(object)) {
            return List.of();
        }

        return object.getObjectTypeIdentifier().getParameterIdentifierMap().values().stream()
                .map(pi -> {
                    final var tnMsg = generalStore.get(TnMsg.Key.newBuilder()
                            .setSystemId(object.getObjectTypeIdentifier().getProject().getId())
                            .setObjectId(object.getId())
                            .setParameterId(pi.getId())
                            .setAttrId(Attributes.General.getAttrId()).build());
                    if(Objects.isNull(tnMsg)) {
                        return null;
                    }

                    var result = new GeneralDto(
                            object.getName(true),
                            "." + pi.getName(),
                            tnMsg.getGeneralMsg().getPropertiesMap().entrySet().stream().collect(Collectors.toMap(
                                    Map.Entry::getKey,
                                    entry -> {
                                        TnMsg.Property prop = entry.getValue();
                                        return switch (prop.getKindCase()) {
                                            case BOOL_VALUE -> String.valueOf(prop.getBoolValue());
                                            case INT_VALUE -> String.valueOf(prop.getIntValue());
                                            case LONG_VALUE -> String.valueOf(prop.getLongValue());
                                            case DOUBLE_VALUE -> String.valueOf(prop.getDoubleValue());
                                            case STRING_VALUE -> prop.getStringValue();
                                            case KIND_NOT_SET -> "";
                                        };
                                    }
                            )));
                    result.setActive(tnMsg.getGeneralMsg().getActive());
                    return result;
                })
                .filter(Objects::nonNull)
                .toList();
    }
