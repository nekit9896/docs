    @Override
    protected void handlePayload(String payload) {
        if (payload == null) {
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), null, "EMPTY", "empty payload", null);
            }
            return;
        }
        CommandDto dto;
        try {
            dto = objectMapper.readValue(payload, CommandDto.class);
            if (dto.getCmd() == null) {
                if (HotlinkMessageLogger.isLoggingEnabled()) {
                    HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), "UNKNOWN", "No cmd specified", payload);
                }
                sendErrorToSession("No cmd specified");
                return;
            }
            commandsCount.computeIfAbsent(dto.getCmd().name(), k -> new AtomicLong(0l)).incrementAndGet();
            switch (dto.getCmd()) {
                case TAG_GET -> performTagGet(dto, payload);
                case TAG_SET -> performTagSet(dto, payload);
                case TAG_FIND -> performTagFind(dto, payload);
                case TAG_NAMES -> performTagNames(dto, payload);
                case OBJECT_TYPES -> performObjectTypes(dto, payload);
                case SUBSCRIBE, UNSUBSCRIBE -> performSubUnsub(dto, payload);
                case SEEK -> {
                    val value = objectMapper.treeToValue(dto.getArgs(), Long.class);
                    if (HotlinkMessageLogger.isLoggingEnabled()) {
                        HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), "SEEK", "timestamp=" + value, payload);
                    }
                    streamProviders.forEach(sp -> sp.seek(Instant.ofEpochMilli(value)));
                }
                case SET_MILLIS_PER_TICK -> {
                    val value = objectMapper.treeToValue(dto.getArgs(), Long.class);
                    if (HotlinkMessageLogger.isLoggingEnabled()) {
                        HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), "SET_MILLIS_PER_TICK", "speed=" + value, payload);
                    }
                    streamProviders.forEach(sp -> sp.setSpeed(value));
                }
                case SWITCH -> {
                    val args = objectMapper.treeToValue(dto.getArgs(), SwitchArgs.class);
                    if (HotlinkMessageLogger.isLoggingEnabled()) {
                        String summary = "target=" + args.getTarget() + (args.getTarget() == SwitchTarget.HISTORY
                                ? String.format(", start=%d, finish=%d, millisPerTick=%s", args.getStart(), args.getFinish(), args.getMillisPerTick())
                                : "");
                        HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), "SWITCH", summary, payload);
                    }
                    if(args.getTarget() == SwitchTarget.LIVE) {
                        switchToLive();
                    }
                    else if (args.getTarget() == SwitchTarget.HISTORY) {
                        switchToHistory(Instant.ofEpochMilli(args.getStart()), Instant.ofEpochMilli(args.getFinish()),
                                args.getMillisPerTick());
                    } else {
                        throw new NotImplementedException("not supported switch target: " + args.getTarget());
                    }
                }
                case PING -> {
                    val pingArgs = dto.getArgs() != null ? objectMapper.treeToValue(dto.getArgs(), PingArgs.class) : new PingArgs();
                    if (HotlinkMessageLogger.isLoggingEnabled()) {
                        HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), "PING", "pingId=" + pingArgs.getId(), payload);
                    }
                    sendPongToSession(pingArgs.getId());
                }
                case PLAY -> {
                    if (HotlinkMessageLogger.isLoggingEnabled()) {
                        HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), "PLAY", "play", payload);
                    }
                    streamProviders.forEach(DataStreamProvider::play);
                }
                case STOP -> {
                    if (HotlinkMessageLogger.isLoggingEnabled()) {
                        HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), "STOP", "stop", payload);
                    }
                    streamProviders.forEach(DataStreamProvider::stop);
                }
                case UNSUBSCRIBE_ALL -> {
                    if (HotlinkMessageLogger.isLoggingEnabled()) {
                        HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), "UNSUBSCRIBE_ALL", "all", payload);
                    }
                    unsubscribeAll();
                }
                default -> {
                    if (HotlinkMessageLogger.isLoggingEnabled()) {
                        HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), dto.getCmd().name(), "cmd=" + dto.getCmd(), payload);
                    }
                    throw new NotImplementedException(dto.getCmd() + " is not supported");
                }
            }
        }
        catch (Exception e) {
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), null, "INVALID", "error=" + e.getMessage(), payload);
            }
            sendErrorToSession(e);
        }
    }

    private void performSubUnsub(CommandDto dto, String payload) throws Exception {
        val args = dto.getArgs() == null
                ? new ArrayList<String>()
                : objectMapper.treeToValue(dto.getArgs(), new TypeReference<ArrayList<String>>() { });

        if (HotlinkMessageLogger.isLoggingEnabled()) {
            String summary = String.format("argsCount=%d, argsSample=%s",
                    args.size(), HotlinkMessageLogger.summarizeCollection(args, 3));
            HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), dto.getCmd().name(), summary, payload);
        }

        val valueArgs = new HashSet<String>();
        val alarmArgs = new HashSet<String>();
        val attributeArgs = new HashSet<String>();

        args.forEach(a -> {
            if (!a.contains(".")) {
                msgConsumer.accept(new AnswerItem(a, null, "Tag name must contain dot"));
                return;
            }

            val normalized = TagImpl.normalizeTagName(a);
            if(DataServiceBase.VALUE_ATTRIBUTES.contains(normalized.getValue())) {
                valueArgs.add(a);

            }
            else if(DataServiceBase.METADATA_ATTRIBUTES.contains(normalized.getValue())) {
                attributeArgs.add(a);
            }
            else if(normalized.getValue() == Attributes.Alarm) {
                alarmArgs.add(a);
            }
            else {
                msgConsumer.accept(
                        new AnswerItem(a, null, normalized.getValue() + " attribute is not supported"));
            }
        });

        if(dto.getCmd() == Command.SUBSCRIBE) {
            subscribe(dto.getHeaders(), valueArgs, alarmArgs, attributeArgs);
        }
        else {
            unsubscribe(dto.getHeaders(), valueArgs, alarmArgs, attributeArgs);
        }
    }

    private void performTagFind(CommandDto dto, String payload) {
        boolean logged = false;
        try {
            var tagNames = objectMapper.readValue(dto.getArgs().traverse(), new TypeReference<Set<String>>() {});
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                String summary = String.format("tagsCount=%d, tagsSample=%s",
                        tagNames.size(), HotlinkMessageLogger.summarizeCollection(tagNames, 3));
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), "TAG_FIND", summary, payload);
                logged = true;
            }
            var result = tagInfoService.getTagMetaDtoList(tagNames);
            sendCallResponse(dto.getId(), result);
        } catch (Throwable t) {
            if (!logged && HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), "TAG_FIND", "error=" + t.getMessage(), payload);
            }
            log.error("Ошибка при вызове {}", dto.getCmd(), t);
            sendCallError(dto.getId(), t.getMessage());
        }
    }

    private void performTagNames(CommandDto dto, String payload) {
        boolean logged = false;
        try {
            var queryArgs = objectMapper.treeToValue(dto.getArgs(), TagQueryArgs.class);
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                String summary = String.format("objectPattern=%s, parameterPattern=%s, types=%s, limit=%s",
                        queryArgs.getObjectPattern(), queryArgs.getParameterPattern(), queryArgs.getTypes(), queryArgs.getLimit());
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), "TAG_NAMES", summary, payload);
                logged = true;
            }
            var result = tagInfoService.patternSearchTags(
                    queryArgs.getObjectPattern(),
                    queryArgs.getParameterPattern(),
                    queryArgs.getTypes(),
                    queryArgs.getLimit());
            if (queryArgs.isSorted()) {
                result = result.stream().sorted().collect(Collectors.toList());
            }
            sendCallResponse(dto.getId(), result);
        } catch (Throwable t) {
            if (!logged && HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), "TAG_NAMES", "error=" + t.getMessage(), payload);
            }
            log.error("Ошибка при вызове {}", dto.getCmd(), t);
            sendCallError(dto.getId(), t.getMessage());
        }
    }
    private void performObjectTypes(CommandDto dto, String payload) {
        boolean logged = false;
        try {
            var queryArgs = objectMapper.treeToValue(dto.getArgs(), ObjectTypeQueryArgs.class);
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                String summary = "typePattern=" + queryArgs.getTypePattern();
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), "OBJECT_TYPES", summary, payload);
                logged = true;
            }
            var result = evo.objectTypes(queryArgs.getTypePattern());
            if (queryArgs.isSorted()) {
                result = result.stream().sorted().collect(Collectors.toList());
            }
            sendCallResponse(dto.getId(), result);
        } catch (Throwable t) {
            if (!logged && HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), "OBJECT_TYPES", "error=" + t.getMessage(), payload);
            }
            log.error("Ошибка при вызове {}", dto.getCmd(), t);
            sendCallError(dto.getId(), t.getMessage());
        }
    }

    private void performTagSet(CommandDto dto, String payload) {
        boolean logged = false;
        try {
            String identity = getUserIdentity(dto.getHeaders());
            String ip = getUserIp(dto.getHeaders());
            Set<String> allow = getAllowPatterns(dto.getHeaders());
            Set<String> forbidden = getForbiddenPatterns(dto.getHeaders());

            if (allow == null || allow.isEmpty()) {
                throw new RuntimeException("Для вызова обязателен заголовок X-USER-ALLOW-PATTERNS");
            }
            if (Strings.isBlank(identity)) {
                throw new RuntimeException("Для вызова обязателен заголовок X-USER-FULLNAME");
            }
            var items = objectMapper.readValue(dto.getArgs().traverse(), new TypeReference<List<TagSetRequest>>() {});
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                String summary = HotlinkMessageLogger.summarizeTagSetRequests(items);
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), "TAG_SET", summary, payload);
                logged = true;
            }
            for(TagSetRequest item : items) {
                dataService.set(identity,
                        new AnswerItem(item.getTag(),
                                deserializeData(item.getTag(), item.getData()),
                                null),
                        allow, forbidden, ip, ip);
            }
            sendCallResponse(dto.getId(), true);
        } catch (Throwable t) {
            if (!logged && HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), "TAG_SET", "error=" + t.getMessage(), payload);
            }
            log.error("Ошибка при вызове {}", dto.getCmd(), t);
            sendCallError(dto.getId(), t.getMessage());
        }
    }

    private void performTagGet(CommandDto dto, String payload) {
        boolean logged = false;
        try {
            Set<String> allow = getAllowGetPatterns(dto.getHeaders());
            if (allow == null || allow.isEmpty()) {
                throw new RuntimeException("Для вызова обязателен заголовок X-USER-GET-ALLOW-PATTERNS");
            }
            var result = new HashSet<AnswerItem>();
            var tagNames = objectMapper.readValue(dto.getArgs().traverse(), new TypeReference<Set<String>>() {});
            if (HotlinkMessageLogger.isLoggingEnabled()) {
                String summary = String.format("tagsCount=%d, tagsSample=%s",
                        tagNames.size(), HotlinkMessageLogger.summarizeCollection(tagNames, 3));
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), "TAG_GET", summary, payload);
                logged = true;
            }
            for (String tn : tagNames) {
                try {
                    var item = dataService.get(
                            tn, allow, getForbiddenGetPatterns(dto.getHeaders()), getUserIdentity(dto.getHeaders()));
                    result.add(item);
                } catch (Throwable t) {
                    result.add(new AnswerItem(tn, null, t.getMessage()));
                }
            }
            sendCallResponse(dto.getId(), result);
        } catch (Throwable t) {
            if (!logged && HotlinkMessageLogger.isLoggingEnabled()) {
                HotlinkMessageLogger.logIncoming(getVersion(), getId(), dto.getId(), "TAG_GET", "error=" + t.getMessage(), payload);
            }
            log.error("Ошибка при вызове {}", dto.getCmd(), t);
            sendCallError(dto.getId(), t.getMessage());
        }
    }

    @Override
    public int getVersion() {
        return 2;
    }

    @Override
    protected Map<String, Long> getCommandsCount() {
        var result = new HashMap<String, Long>();
        commandsCount.forEach( (k, v) -> result.put(k, v.get()));
        return result;
    }
}



