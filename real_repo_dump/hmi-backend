    private CacheableTagInfoStore tagInfoStore;

    @Autowired
    private Evo evo;


    @Test
    public void subscriptionTest() throws Exception {
        long time = System.currentTimeMillis();
        var tagName1 = "TU1:test_1.ValueBoolean";
        Tag tag1 = TagImpl.of(tagInfoStore.get(tagName1));
        var msg1 = MsgHelper.buildMsg(true, time);
        lastValueService.put(MsgHelper.buildKey(tag1), msg1);

        var tagName2 = "TU1:test_1.ValueFloat";
        Tag tag2 = TagImpl.of(tagInfoStore.get(tagName2));
        var msg2 = MsgHelper.buildMsg(1.23f, time);
        lastValueService.put(MsgHelper.buildKey(tag2), msg2);

        var tagName3 = "TU1:test_2.ValueFloat";

        WebSocketSession mockSession = getMockSession();
        List<String> sessionReceivedMessages = connectAndCollectMessages(mockSession);

        // Подписка на два тега с заданными значениями, на один без значения
        processCommand(mockSession, String.format("SUBSCRIBE %s, %s %s", tagName1, tagName2, tagName3), 10000);
        //log.info("Sent to client: {}", sessionReceivedMessages);
        // При подписке сразу должны отдаться последние значения на то, на что подписались.
        // Теоретически нет гарантии, что все сообщения попадут в одно пакетное сообщение
        assertEquals( true, findResultBoolean(tagName1, sessionReceivedMessages));
        assertEquals( 1.23f, findResultFloat(tagName2, sessionReceivedMessages));
        verifyResultFloatExistsAndNotSet(tagName3, sessionReceivedMessages);

        sessionReceivedMessages.clear();
        evo.tagSet(tagName1, false);
        pause(1000);

        //log.info("Sent to client: {}", sessionReceivedMessages);
        assertEquals( false, findResultBoolean(tagName1, sessionReceivedMessages));

        sessionReceivedMessages.clear();
        processCommand(mockSession, String.format("UNSUBSCRIBE %s, %s", tagName1, tagName3), 100);
        evo.tagSet(tagName1, true);
        evo.tagSet(tagName2, 4.56f);
        pause(1000);
        verifyNoTagValueMessageWithTagName(tagName1, sessionReceivedMessages);
        assertEquals( 4.56f, findResultFloat(tagName2, sessionReceivedMessages));

        sessionReceivedMessages.clear();
        processCommand(mockSession, "UNSUBSCRIBE_ALL", 100);
        evo.tagSet(tagName2, 7.89f);
        pause(1000);
        verifyNoTagValueMessageWithTagName(tagName2, sessionReceivedMessages);
    }

    private static void verifyResultFloatExistsAndNotSet(String tagName, List<String> sessionReceivedMessages) {
        DocumentContext json = findResponseTagValueMessageWithTagName(tagName, sessionReceivedMessages);
        JSONArray result1 = json.read(JsonPath.compile(String.format("$.tagValueBatch[?(@.tag=='%s')].value.floatVar",
                tagName)));
        assertEquals(0, result1.size());
        JSONArray result2 = json.read(JsonPath.compile(String.format("$.tagValueBatch[?(@.tag=='%s')].value.invalid",
                tagName)));
        assertEquals(1, result2.size());
        assertEquals( true, result2.get(0));
    }

    private static Float findResultFloat(String tagName, List<String> sessionReceivedMessages) {
        DocumentContext json = findResponseTagValueMessageWithTagName(tagName, sessionReceivedMessages);
        JSONArray result = json.read(JsonPath.compile(String.format("$.tagValueBatch[?(@.tag=='%s')].value.floatVar", tagName)));
        assertEquals(1, result.size());
        return ((Double) result.get(0)).floatValue();
    }

    private static Boolean findResultBoolean(String tagName, List<String> sessionReceivedMessages) {
        DocumentContext json = findResponseTagValueMessageWithTagName(tagName, sessionReceivedMessages);
        JSONArray result = json.read(JsonPath.compile(String.format("$.tagValueBatch[?(@.tag=='%s')].value.boolVar", tagName)));
        assertEquals(1, result.size());
        return (Boolean) result.get(0);
    }

    @Test
    public void tickerTest() throws IOException {
        WebSocketSession mockSession = getMockSession();
        List<String> sessionReceivedMessages = connectAndCollectMessages(mockSession);
        pause(2000);
        log.info("Sent to client: {}", sessionReceivedMessages);
        DocumentContext json = findTickerMessage(sessionReceivedMessages);
        assertEquals( "time", json.read(JsonPath.compile("$.message_type")));
        assertEquals( "live", json.read(JsonPath.compile("$.stream_state.type")));
        assertTrue((int) json.read(JsonPath.compile("$.current_time_s")) > 0);
        assertTrue((int) json.read(JsonPath.compile("$.stream_time_s")) > 0);
    }

    private static DocumentContext findResponseTagValueMessageWithTagName(String tagName, List<String> sentMessages) {
        var msgToCheck = sentMessages.stream().filter(s -> s.contains(tagName) && s.contains("tagValueBatch")).findFirst().get();
        Assertions.assertNotNull(msgToCheck);
        var json  = JsonPath.parse(msgToCheck);
        return json;
    }

    private static void verifyNoTagValueMessageWithTagName(String tagName, List<String> sentMessages) {
        var msgToCheck = sentMessages.stream().filter(s -> s.contains(tagName) && s.contains("tagValueBatch")).findFirst();
        Assertions.assertTrue(msgToCheck.isEmpty());
    }

    private static DocumentContext findTickerMessage(List<String> sentMessages) {
        var msgToCheck = sentMessages.stream().filter(s -> s.contains("\"time\"") && s.contains("stream_state")).findFirst().get();
        Assertions.assertNotNull(msgToCheck);
        var json  = JsonPath.parse(msgToCheck);
        return json;
    }

    private void processCommand(WebSocketSession mockSession, String command, int millisWaitAfter) {
        var msg = new TextMessage(command, true);
        handler.handleTextMessage(mockSession, msg);
        pause(millisWaitAfter);
    }

    @NotNull
    private List<String> connectAndCollectMessages(WebSocketSession mockSession) throws IOException {
        List<String> sentMessages = new ArrayList<>();
        doAnswer(new Answer<Void>() {
            public Void answer(InvocationOnMock invocation) {
                Object[] args = invocation.getArguments();
                //System.out.println("called with arguments: " + Arrays.toString(args));
                sentMessages.add(((TextMessage)args[0]).getPayload());
                return null;
            }
        }).when(mockSession).sendMessage(any());
        handler.afterConnectionEstablished(mockSession);
        return sentMessages;
    }

    @NotNull
    private static WebSocketSession getMockSession() {
        var mockSession = mock(WebSocketSession.class);

        Map attrs = new HashMap<String, Object>();
        attrs.put("msg-buffer", new StringBuilder());
        attrs.put("IP", "1.2.3.4");
        attrs.put("x-user-fullname", "Ivan Ivanov");

