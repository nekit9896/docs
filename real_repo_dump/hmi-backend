package tnt.tnscada.hmi.service;

import io.opentelemetry.instrumentation.annotations.WithSpan;
import org.jetbrains.annotations.NotNull;
import org.springframework.stereotype.Service;
import tnt.evoscada.api.data.Tag;
import tnt.tnscada.core.database.provider.DbProvider;
import tnt.tnscada.core.database.type.Record;
import tnt.tnscada.core.database.type.RecordKey;
import tnt.tnscada.core.database.type.RecordValue;
import tnt.tnscada.core.database.type.TimeRange;
import tnt.tnscada.hmi.dto.HistoryRecordShortNameDTO;

import java.sql.SQLException;
import java.util.*;
import java.util.stream.Collectors;

import static java.util.stream.Collectors.groupingBy;

@Service public class HistoryServiceLegacy {

    private final DbProvider<RecordKey, RecordValue> dbProvider;
    private final TagInfoService tagInfoService;

    public HistoryServiceLegacy(
            DbProvider<RecordKey, RecordValue> dbProvider,
            TagInfoService tagInfoService) {
        this.dbProvider = dbProvider;
        this.tagInfoService = tagInfoService;
    }

    @WithSpan
    public Map<String, List<RecordValue>> tagGetHistoryGroupedByTag(
            long startTime,
            long endTime,
            List<String> tags,
            int limit,
            int offset,
            boolean returnBounds,
            Integer timeBucketWidth
    ) throws SQLException {
        var tagInfoList = tagInfoService.getTagInfoList(tags, true);
        Map<RecordKey, String> queryKeysToName = getQueryKeysToTagName(tagInfoList);
        var records = fetchRecords(queryKeysToName.keySet(),
                startTime, endTime,
                limit, offset,
                returnBounds, timeBucketWidth);
        return records.stream()
                .collect(groupingBy(r -> queryKeysToName.get(r.getKey())))
                .entrySet().stream()
                .collect(Collectors.toMap(e -> e.getKey(),
                        e -> e.getValue().stream()
                                .map(r -> r.getValue()).collect(Collectors.toList())));
    }

    @WithSpan
    public List<HistoryRecordShortNameDTO> tagGetHistoryFlat(
            long startTime,
            long endTime,
            List<String> tags,
            int limit,
            int offset,
            boolean returnBounds,
            Integer timeBucketWidth
    ) throws SQLException {
        var tagInfoList = tagInfoService.getTagInfoList(tags, true);
        Map<RecordKey, String> queryKeysToName = getQueryKeysToTagName(tagInfoList);
        var records = fetchRecords(queryKeysToName.keySet(),
                startTime, endTime,
                limit, offset,
                returnBounds, timeBucketWidth);
        return records.stream()
                .map(r -> HistoryRecordShortNameDTO.of(queryKeysToName.get(r.getKey()),r.getValue()))
                .collect(Collectors.toList());

    }

    @NotNull
    private static Map<RecordKey, String> getQueryKeysToTagName(Set<Tag> tagInfoList) {
        return tagInfoList.stream().collect(Collectors.toMap(t -> RecordKey.of(
                        t.getTagKey().getSystemId(),
                        t.getTagKey().getObjectId(),
                        t.getTagKey().getParameterId(),
                        t.getTagKey().getAttrId()
                ),
                t -> t.getTagName()));
    }


    protected List<Record<RecordKey, RecordValue>> fetchRecords(
            Set<RecordKey> keys,
            long startTime,
            long endTime,
            int limit,
            int offset,
            boolean returnBounds,
            Integer timeBucketWidth
    ) throws SQLException {

        var result = new ArrayList<Record<RecordKey, RecordValue>>();

        var maxBatchSize = 10000; //Стандартное ограничение Clickhouse на весь SQL запрос: 256 KiB
        List<Set<RecordKey>> batchedKeys = new ArrayList<>();
        var iterator = keys.iterator();
        while (iterator.hasNext()) {
            Set<RecordKey> batch = new HashSet<>();
            while (iterator.hasNext() && batch.size() < maxBatchSize) {
                batch.add(iterator.next());
            }
            batchedKeys.add(batch);
        }

        for (var batch : batchedKeys) {
            result.addAll(dbProvider.getHistory(
                    batch,
                    TimeRange.of(startTime, endTime),
                    returnBounds ? 1 : 0,
                    limit,
                    offset,
                    timeBucketWidth == null ? 0 : timeBucketWidth
            ));
        }

        return result;
    }
}



