                td.style.backgroundColor = ``;
                td.style.borderColor     = ``;
            }
            return;
        }
        const text = el.innerText.trim();
        const matchObjectName = text.match(/^([^.]*).*/);
        if (matchObjectName && matchObjectName[1]) {
            const objectName = matchObjectName[1];
            const hash = getStrongHash(objectName);
            const hue = Math.floor((hash * 137.5) % 360);
            for (const k in allRowTd) {
                td = allRowTd.item(k);
                td.style.backgroundColor = `hsla(${hue}, 40%, 75%, 60%)`;
