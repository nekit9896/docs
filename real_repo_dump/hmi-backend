            valueCallback.accept(tagValues);
        }
    }

    private void uploadDataAsync(Instant fromTime, Instant tillTime) {
        if (isUploadRunning()) {
            var prevTimeout = 3;
            try {
                uploader.get(prevTimeout, TimeUnit.SECONDS);
            } catch (Exception e) {
                log.error("Previous upload did not respond for {} secs. Canceling and launch new one", prevTimeout, e);
                uploader.cancel(true);
            }
        }
        uploader = backgroundExecutor.submit(() -> {
            uploadData(fromTime, tillTime);
        });
    }

    private boolean isUploadRunning() {
        return uploader != null && !uploader.isDone();
    }

    private void cancelUpload() {
        if (isUploadRunning()) {
            uploader.cancel(true);
            log.info("Cancelled upload");
        }
    }

    private void uploadData(Instant fromTime, Instant tillTime) {
        log.debug("Upload({} - {})", fromTime, tillTime);
        freeMemory();
        var currentTagNames = Set.copyOf(tags.keySet());
        var keyFrameWasReadyBefore = keyFrameBucket.isTagsLoaded(currentTagNames);
        var skippedBucketCase = false;
        if (forceLoadBoundsFrom > 0 ) {
            if (forceLoadBoundsFrom <= fromTime.toEpochMilli()) {
                skippedBucketCase = true;
                forceLoadBoundsFrom = 0;
                log.debug("Будет принудительная подгрузка данных");
            } else {
                log.debug("Заказана подгрузка граничных данных с {}, но тик с {}", Instant.ofEpochMilli(forceLoadBoundsFrom), fromTime);
            }
        }
        uploadAndRegisterIntoBuckets(currentTagNames, fromTime, tillTime, false, skippedBucketCase);
        if (skippedBucketCase) {
            sendKeyFrame(false);
        }
        var tagNamesToLoadForKeyframe = keyFrameBucket.getMissingTags(currentTagNames);
        if (!tagNamesToLoadForKeyframe.isEmpty()) {
            uploadAndRegisterIntoBuckets(currentTagNames, startTime, startTime, true, false);
            keyFrameBucket.markTagNamesLoaded(currentTagNames);
        }
        if (!keyFrameWasReadyBefore) {
            sendKeyFrame(false);
        }
    }

    private void uploadAndRegisterIntoBuckets(Set<String> tagNames, Instant fromTime, Instant tillTime, boolean forKeyframe,
                                              boolean forSkippedBucketCase) {
        log.debug("uploadAndRegisterIntoBuckets({} - {}), forKeyframe {}, forSkippedBucketCase {}", fromTime, tillTime, forKeyframe, forSkippedBucketCase);
        try {
            var start = System.currentTimeMillis();
            var bounds = false;
            Set<String> tagNamesToLoad = new HashSet<>();
            if (forKeyframe || forSkippedBucketCase) {
                //Для ключевого кадра будет подгрузка первого бакета полностью, независимо от готовности
                //ради bounds более ранних значений
                bounds = true;
                tagNamesToLoad.addAll(tagNames);
            }
            var timeBucketKeysToLoad = getTimeBucketKeysForRange(fromTime, tillTime);
            int offset = 0;
            int limit = 1000;
            var bucketFrom = -1L;
            var bucketTill = -1L;

            for (var tbk : timeBucketKeysToLoad) {
                var bucket = timelineBuckets.computeIfAbsent(tbk, k -> new TimelineBucket<>());
                if (bucket != null) {
                    var missingTagNames = bucket.getMissingTags(tagNames);
                    if (!missingTagNames.isEmpty() || forSkippedBucketCase) {
                        if (bucketFrom == -1) {
                            bucketFrom = tbk;
                        }
                        bucketTill = tbk;
                        tagNamesToLoad.addAll(missingTagNames);
                    }
                }
            }

            List<TValue> allData = new ArrayList<>();
            if (!tagNamesToLoad.isEmpty()) {
                log.debug("Need to upload data for {} tagNames", tagNamesToLoad.size());
                if ((bucketFrom == -1L || bucketTill == -1L)) {
                    if (forKeyframe) {
                        log.info("Fixing bucket pointer for keyframe");
                        bucketFrom = getTimeBucketKey(Date.from(startTime));
                        bucketTill = bucketFrom;
                    }
                }
                List<TValue> chunk;
                var uploadFrom = Instant.ofEpochMilli(bucketFrom - timeBucketWidthMillis);
                var uploadTill = Instant.ofEpochMilli(bucketTill);
                do {
                    HashSet<Tag> tagsToLoad = new HashSet<>();
                    tagNamesToLoad.forEach(t -> {
                        Tag tag = tags.get(t);
                        if (tag != null) {
                            tagsToLoad.add(tag);
                        }
                    });
                    log.debug("getHistory {}, {}, {}, {}, {}, {}", tagsToLoad,
                            Date.from(uploadFrom),
                            Date.from(uploadTill),
                            limit, offset, bounds);
                    chunk = getHistory(
                            tagsToLoad,
                            Date.from(uploadFrom),
                            Date.from(uploadTill),
                            limit, offset, bounds);
                    allData.addAll(chunk);
                    offset += limit;
                } while (!chunk.isEmpty());
            }
            allData.forEach(tv -> {
                        if (startTime.toEpochMilli() < getTimestamp(tv).getTime() &&
                                getTimestamp(tv).getTime() <= finishTime.toEpochMilli()) {
                            var timeBucketKey = getTimeBucketKey(getTimestamp(tv));
                            var bucket = timelineBuckets.computeIfAbsent(timeBucketKey, anyKey -> new TimelineBucket<>());
                            bucket.acceptValue(tv, this::getTag, this::getTimestamp);
                        }
                        if (getTimestamp(tv).getTime() <= startTime.toEpochMilli()) {
                            keyFrameBucket.acceptValue(tv, this::getTag, this::getTimestamp);
                        }
                    }
            );
            registerLoadedTagsToBuckets(tagNames, timeBucketKeysToLoad);
            lastUploadedTime = tillTime;
            log.info("Loaded {} records in {} ms till {}", allData.size(), System.currentTimeMillis() - start,
                    tillTime);
            //log.info("Timeline states for {} buckets: {}", timelineBuckets.size(), Arrays.stream(getStreamTimelineBucketStates(70)).map(b -> b?"■":"▢").collect(Collectors.joining()));
        } catch (Exception e) {
            log.error("Не удалось подгрузить исторические данные: {}", e.getMessage(), e);
        }
    }

    private void registerLoadedTagsToBuckets(Set<String> tagNames, long[] timeBucketKeys) {
        for (var tbk: timeBucketKeys) {
            var bucket = timelineBuckets.computeIfAbsent(tbk, anyKey -> new TimelineBucket<TValue>());
            bucket.markTagNamesLoaded(tagNames);
        }
    }

    private Long getTimeBucketKey(Date date) {
        //Время ячейки - время среза (конец среза), а не время начала ячейки (начала среза)
        return date.toInstant().truncatedTo(ChronoUnit.SECONDS).toEpochMilli() + timeBucketWidthMillis;
    }

    private long[] getTimeBucketKeysForRange(Instant start, Instant finish) {
       return getTimeBucketKeysForRange(start, finish, -1);
    }
    private long[] getTimeBucketKeysForRange(Instant fromTime, Instant tillTime, int limit) {
        if (fromTime.compareTo(startTime) < 0) {
            fromTime = startTime;
        }
        if (tillTime.compareTo(finishTime) > 0) {
            tillTime = finishTime;
        }
        // число ячеек на основе интервала времени
        var from = fromTime.truncatedTo(ChronoUnit.SECONDS).toEpochMilli();
        var to = tillTime.truncatedTo(ChronoUnit.SECONDS).toEpochMilli() + timeBucketWidthMillis;
        int size = Math.max((int) ((to-from)/timeBucketWidthMillis), 1); //хотя бы одна ячейка
        if (limit > -1) {
            size = Math.min(limit, size);
        }
        var result = new long[size];

        // именования ячеек по последней милисекунде каждой
        int pointer = 0;
        for (long ms = from + timeBucketWidthMillis;
             ms <= to && pointer < size;
             ms += timeBucketWidthMillis, pointer++) {
            result[pointer] = ms;
        }
        return result;
    }

    private void freeMemory() {
        log.info("freeMemory()");
        // Если данные скорее всего не потребуются, выгрузить из памяти
        // - огромный интервал окна плеера, ушли вперёд
        // - отписались от тегов, вернётся ли к ним потребитель скоро снова? Мапу с временем отписки, чистить по времени
        // При очистке старых данных, надо пересобрать ключевой кадр в ближайший оставшийся

        // кусок про очистку данных позади курсора. Если перемотали сильно назад, не ясно, надо ли чистить
        var millisToLeave = 600*1000;
        if ((cursorLast - startTime.toEpochMilli()) > millisToLeave) {
            var buckets = getTimeBucketKeysForRange(startTime, Instant.ofEpochMilli(cursorLast).minusMillis(millisToLeave));
            if (buckets.length > 0) {
                var acceptor = buckets[buckets.length - 1];
                log.info("Merging {} buckets into {} while cursor at {}", buckets.length,
                        Instant.ofEpochMilli(acceptor), Instant.ofEpochMilli(cursorLast));
                var mergedBucket = getMergedKeyframe(buckets);
                for (var tbk : buckets) {
                    if(acceptor == tbk) {
                        timelineBuckets.put(tbk, mergedBucket);
                    }
                    else {
                        timelineBuckets.remove(tbk);
                    }
                }
            }
        }
    }

    private boolean isDataUploaded(Instant tillTime) {
        // проверить доступность данных по текущему списку тегов от курсора и далее
        // по каждому тегу должна быть ясно, что или есть данные за интервал (без пустых окон внутри)
        // либо знание, что уже загружали данные, но ничего не было найдено
        var tagNamesToCheck = Set.copyOf(tags.keySet());
        //if (!keyFrameBucket.isTagsLoaded(tagNamesToCheck)) {
       //     return false;
        //}
        var bucketKeys = getTimeBucketKeysForRange(Instant.ofEpochMilli(cursorLast), tillTime);
        for (var tbk: bucketKeys) {
            var bucket = timelineBuckets.get(tbk);
            if (bucket == null || !bucket.isTagsLoaded(tagNamesToCheck)) {
                return false;
            }
        }
        return true;
    }

    public Boolean[] getStreamTimelineBucketStates(int maxNewLength) {
        var tagsToCheck = Set.copyOf(tags.keySet());
        var allKeys = getTimeBucketKeysForRange(startTime, finishTime);
        var result = Arrays.stream(allKeys).mapToObj(tbk -> {
            var bucket = timelineBuckets.get(tbk);
            return bucket == null ? false : bucket.isTagsLoaded(tagsToCheck);
        }).toArray(Boolean[]::new);
        if (maxNewLength > 0 && result.length > maxNewLength) {
            var remapped = new Boolean[maxNewLength];
            float spanPerOutBucket = (float)result.length/maxNewLength;
            var lastTaken = 0;
            for (var i = 0; i < maxNewLength; i++) {
                var recalc = true;
                for (var p = (int)(i * spanPerOutBucket); p < (int)(i*spanPerOutBucket + spanPerOutBucket); p += spanPerOutBucket) {
                    recalc = recalc && result[p];
                    lastTaken = p;
                }
                remapped[i] = recalc;
            }
            // Если из-за округлений в последнюю свёртку не попали все данные, добираем их тоже
            for (var p = lastTaken + 1; p < result.length; p++) {
                remapped[maxNewLength-1] = remapped[maxNewLength-1] && result[p];
            }
            result = remapped;
        }
        return result;
    }

    private void sendKeyFrame(boolean sendMissingTags) {
        var bucketKeys = getTimeBucketKeysForRange(startTime, Instant.ofEpochMilli(cursorLast));
        TimelineBucket<TValue> enrichedKeyFrame = getMergedKeyframe(bucketKeys);
        val toSend = new ArrayList<>(enrichedKeyFrame.getTagValues());
        if(sendMissingTags) {
            enrichedKeyFrame.getMissingTags(tags.keySet()).forEach(t ->
                    toSend.add(getEmptyValue(tags.get(t))));
        }
        effectiveValueCallback(toSend);
    }

    @NotNull
    private TimelineBucket<TValue> getMergedKeyframe(long[] bucketKeys) {
        var enrichedKeyFrame = new TimelineBucket<>(keyFrameBucket.getTagValues(), this::getTag, this::getTimestamp);
        for (long tbk: bucketKeys){
            var bucket = timelineBuckets.get(tbk);
            if (bucket != null) {
                enrichedKeyFrame.acceptTagValues(bucket.getTagValues(), this::getTag, this::getTimestamp);
            }
        }
        return enrichedKeyFrame;
    }

    public boolean tick() {
        var tickWindowTill = Instant.ofEpochMilli(cursorLast + tickWindowMillis);
        // Про суперсрочную подгрузку данных
        if (!isDataUploaded(tickWindowTill)) {
            log.warn("Tick at {} {} data not ready", cursorLast, Instant.ofEpochMilli(cursorLast));
            var uploadIsTooLong = (awaitFromTime > 0 && isUploadRunning() && System.currentTimeMillis() > (awaitFromTime + 15000));
            if(!isUploadRunning() || uploadIsTooLong) {
                log.info("Force load triggered");
                cancelUpload();
                uploadNearestIfNeeded(10);
            }
            if (awaitFromTime == 0 ) {
                awaitFromTime = System.currentTimeMillis();
            }
            return false;
        }
        if (tickWindowTill.plusSeconds(10 * tickWindowMillis / 1000).compareTo(lastUploadedTime) > 0) {
            log.info("Preload triggered");
            uploadNearestIfNeeded(30);
        }
        awaitFromTime = 0;
        log.debug("Tick at {} {}", cursorLast, Instant.ofEpochMilli(cursorLast));
        var bucketKeys = getTimeBucketKeysForRange(Instant.ofEpochMilli(cursorLast), tickWindowTill);
        var tickRecords = new ArrayList<TValue>();
        for(long tbk: bucketKeys){
            if (tbk==bucketKeyLast) {
                continue;
            }
            var bucket = timelineBuckets.get(tbk);
            if (bucket != null) {
                tickRecords.addAll(bucket.getTagValues());
            }
        }
        sendSmoother(tickRecords);
        bucketKeyLast = bucketKeys[bucketKeys.length-1];
        return true;
    }

    private void sendSmoother(List<TValue> records) {
        var historyTimeInTickFactor = tickWindowMillis / tickDelayMillis;
        var subLengthInRealTimeMillis = subPlayerIntervalMillis;
        var subLengthInHistoryTime = Math.max(subLengthInRealTimeMillis, subLengthInRealTimeMillis * historyTimeInTickFactor);
        var subs = new ArrayList<List<TValue>>();
        var subsThresholds = new ArrayList<Long>();
        subs.add(new ArrayList<>());
        subsThresholds.add(cursorLast);
        var limitTime = cursorLast + tickWindowMillis;
        for (int i = 1; i < 1000 ; i++) {
            var threshold = subsThresholds.get(i - 1) + subLengthInHistoryTime;
            if (threshold >= limitTime) {
                break;
            }
            subsThresholds.add(threshold);
            subs.add(new ArrayList<>());
        }
        for (var record: records) {
            var time = getTimestamp(record).getTime();
            var subIndex = 0;
            for (int i = 0; i<subs.size(); i++) {
                if (time >= subsThresholds.get(i)) {
                    subIndex = i;
                }
            }
            subs.get(subIndex).add(record);
        }

        log.trace("initiating subPlayer for {} subs, subNextCursor was {}", subs.size(), subNextCursor);
        subIntervals = subs;
        subNextCursor = 0;

    }

    public void startSubplayer() {
        if(subPlayerFuture == null) {
            subPlayerFuture = subsPlayer.scheduleAtFixedRate(() -> subPlayerTick(), 0, subPlayerIntervalMillis,
                    TimeUnit.MILLISECONDS);
        }
    }

    public void stopSubplayer() {
        if (subPlayerFuture != null) {
            subPlayerFuture.cancel(true);
            subPlayerFuture = null;
        }
    }

    private void subPlayerTick() {
        if (subNextCursor >= 0) {
            if (subIntervals != null && subIntervals.size() > subNextCursor) {
                effectiveValueCallback(subIntervals.get(subNextCursor));
                subNextCursor++;
            } else {
                subNextCursor = -1;
            }
        }
    }

    private boolean isInitiated() {
        return startTime != null && finishTime != null && cursorLast > 0;
    }

    public boolean isPausedTillUpload() {
        return awaitFromTime > 0;
    }

    public void subscribe(Set<Tag> tags) {
        tags.forEach(t -> this.tags.put(t.getTagName(), t));
        if (isInitiated()) {
            uploadNearestIfNeeded(20);
        }
    }

    public void unsubscribeAll() {
        tags.clear();
    }

    private void uploadNearestIfNeeded(int ticks) {
        var fromTime = Instant.ofEpochMilli(cursorLast);
        var tillTime = Instant.ofEpochMilli(cursorLast).plusSeconds(ticks * tickWindowMillis / 1000);
        if (!isDataUploaded(tillTime)) {
            uploadDataAsync(fromTime, tillTime);
        }
    }

    public void unsubscribe(Set<Tag> tags) {
        tags.forEach(tag -> this.tags.remove(tag.getTagName()));
    }

    public Integer[] getTimelineState() {
        return Arrays.stream(getStreamTimelineBucketStates(100)).map(b -> b?1:0).toArray(Integer[]::new);
    }

    public void setCursorLast(long cursorLast) {
        this.cursorLast = cursorLast;
    }

    public void setForceLoadBoundsFrom(long cursorFrom) {
        this.forceLoadBoundsFrom = cursorFrom;
    }

    public void close() {
        if (subPlayerFuture != null) {
            subPlayerFuture.cancel(true);
        }
        subsPlayer.shutdown();
    }

    public void sendSnapshot() {
        sendKeyFrame(true);
        uploadNearestIfNeeded(1);
        sendKeyFrame(false);
    }

    public int getTagCount() {
        return tags.size();
    }


}



