            webSocketSession.close();
        }
    }

    public boolean sendToSession(String msg) {
        return sendToSession(msg, null, null, null);
    }

    public boolean sendToSession(String msg, String msgType, String msgId, String summary) {
        if (webSocketSession == null || !webSocketSession.isOpen()) {
            return false;
        }
        synchronized (webSocketSession) {
            try {
                webSocketSession.sendMessage(new TextMessage(msg));
                lastTagDataSent = Instant.now().getEpochSecond();
                sentToClientMessages++;
                sendStats.tick();
                HotlinkMessageLogger.logOutgoing(getVersion(), getId(), msgId, msgType, summary, msg);
                return true;
            } catch (Exception e) {
                log.error(e.getMessage());
            }
        }
        return false;
    }

    public void sendErrorToSession(Throwable t) {
        var cause = t.getCause() != null ? String.format(
                "; Причина %s: %s",
                t.getCause().getClass().getName(),
                t.getCause().getMessage()
        ) : "";
        var errorMessageText = String.format("%s: %s%s", t.getClass().getName(), t.getMessage(), cause);
        sendErrorToSession(errorMessageText);
    }

    protected void sendErrorToSession(String errorMessage) {
        sendErrorToSession(errorMessage, null);
    }

    protected void sendErrorToSession(String errorMessage, Map<String, Object> payload) {
        JsonObject jsonObject = new JsonObject();
        jsonObject.addProperty("message_type", "error");
        jsonObject.addProperty("error_message", errorMessage);
        if (payload != null && payload.size() > 0) {
            var attrs = new JsonObject();
            payload.forEach((key, value) -> {
                            if (value != null) {
                                if (value instanceof Collection) {
                                    attrs.add(key, JsonUtils.getJsonArray((Collection<?>) value));
                                } else {
                                    attrs.addProperty(key, Objects.toString(value));
                                }
                            }
                        });
            jsonObject.add("payload", attrs);
        }
        jsonObject.addProperty("hmiToSessionTime", System.currentTimeMillis());
        sendToSession(jsonObject.toString(), "ERROR", null, "errorMessage=" + errorMessage);
    }

    public void sendTimeStateToSession() {
        try {
