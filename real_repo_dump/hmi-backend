            padding: 8px;
            position: absolute;
            z-index: 100;
            bottom: 125%; /* над иконкой */
            left: 50%;
            transform: translateX(-50%);
            transition: opacity 0.3s;
            font-size: 12px;
            line-height: 1.4;
        }

        .info-icon .tooltip::after {
            content: "";
            position: absolute;
            top: 100%;
            left: 50%;
