package tnt.tnscada.hmi.hotlink;

import lombok.extern.slf4j.Slf4j;
import tnt.evoscada.api.DataCallback;
import tnt.evoscada.api.Evo;
import tnt.evoscada.api.Subscription;
import tnt.evoscada.api.data.TagValue;
import tnt.tnscada.core.message.protobuf.HmiMsg;
import tnt.tnscada.hmi.utils.TagValueUtils;

import java.util.List;
import java.util.UUID;

@Slf4j
public class HotlinkWaitValueSession {
    private HmiMsg.TagValueMsg target;
    private long initTime;
    private final String id;
    private final Evo evo;
    private boolean triggered;
    private Subscription subscription;
    private DataCallback<TagValue> acceptorCallback;

    public HotlinkWaitValueSession(HmiMsg.TagValueMsg target, Evo evo) {
        this.target = target;
        this.evo = evo;
        this.id = UUID.randomUUID().toString();
        this.initTime = System.currentTimeMillis();
        var session = this;
        acceptorCallback = new DataCallback<TagValue>() {
            @Override
            public void call(List<TagValue> tagValues) {
                session.accept(tagValues);
            }
        };
        var tagInfo = evo.findTag(target.getTag());
        subscription = evo.tagSubscribe(acceptorCallback, false, tagInfo);
    }

    public void accept(List<TagValue> tagValues) {
        tagValues.forEach(tv -> {if (!triggered && TagValueUtils.tagValueEqual(TagValueUtils.mapToHmiTagValueMsg(tv), target)) {
            triggered = true;
            log.debug("triggered: {}, curval: {}, target: {}, await time: {} ms", triggered, TagValueUtils.mapToHmiTagValueMsg(tv), target, System.currentTimeMillis() - initTime);
        }});
    }

    public boolean isTriggered() {
        return triggered;
    }

    public String getId() {
        return id;
    }

    public String getTagName() {
        return target.getTag();
    }

    public void close() {
        evo.tagUnsubscribe(subscription);
    }
}


