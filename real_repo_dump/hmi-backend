package tnt.tnscada.hmi.service;

import io.netty.handler.timeout.ReadTimeoutException;
import io.opentelemetry.instrumentation.annotations.WithSpan;
import jakarta.servlet.http.HttpServletRequest;
import lombok.extern.slf4j.Slf4j;
import org.apache.commons.lang3.StringUtils;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;
import org.springframework.web.reactive.function.BodyInserters;
import org.springframework.web.reactive.function.client.WebClient;
import org.springframework.web.reactive.function.client.WebClientRequestException;
import org.springframework.web.reactive.function.client.WebClientResponseException;
import reactor.core.publisher.Mono;
import tnt.evoscada.api.internal.dto.ObjectDto;
import tnt.evoscada.api.internal.dto.RouteDto;
import tnt.tnscada.core.meta.CacheableTagInfoStore;
import tnt.tnscada.hmi.errors.BadRequestException;
import tnt.tnscada.hmi.errors.NotFoundException;

import java.util.Arrays;
import java.util.function.BooleanSupplier;
import java.util.stream.Collectors;


@Service
@Slf4j
public class TagInfoEditService {
    @Autowired
    @Qualifier("DataManagerClient")
    private WebClient webClient;
    @Value("${tn-scada.data-manager.url}")
    private String DATAMANAGER_URL_ROOT;
    @Value("${tn-scada.web-client.timeout}")
    private int NETWORK_TIMEOUT_MS;
    @Autowired
    private TopicRouteConfig topicRouteRules;
    @Autowired
    private CacheableTagInfoStore tagInfoStore;

    public ObjectDto createObjectWithRouting(ObjectDto dto, String user) {
        var message =  new StringBuilder(String.format("Запрос на создание объекта '%s' от пользователя '%s'", dto.getName(), user));
        ObjectDto persistedObjectDto;
        try {
            verifyConfiguration();
            var neededRoutes = topicRouteRules.getRoutes(dto.getName(), dto.getType());
            try {
                var start = System.currentTimeMillis();
                persistedObjectDto = webClient.post().uri("/v1/object")
                        .body(BodyInserters.fromValue(dto)).retrieve()
                        .bodyToMono(ObjectDto.class).block();
                message.append(String.format(". Объект создан за %dмс", System.currentTimeMillis() - start));
            } catch (WebClientRequestException e) {
                if (e.getRootCause() instanceof ReadTimeoutException) {
                    throw new RuntimeException(
                            String.format("Создание объекта в сервисе DataManager не успевает отработать за %dмс", NETWORK_TIMEOUT_MS), e.getRootCause());
                } else {
                    throw new RuntimeException(
                            String.format("Не удаётся соединиться с сервисом DataManager: %s", e.getMessage()), e);
                }
            } catch (WebClientResponseException.NotFound e) {
                throw new NotFoundException(
                        String.format("В реестре не нашлись идентификаторы для создания объекта %s", dto), e);
            } catch (WebClientResponseException.BadRequest e) {
                message.append(". Возможно, объект уже существует");
                persistedObjectDto = webClient.get().uri("/v1/object/name/" + dto.getName())
                        .retrieve()
                        .bodyToMono(ObjectDto.class).block();
                if (!persistedObjectDto.equals(dto)) {
                    throw new BadRequestException(
                            String.format("В реестре уже существует объект с именем %s но с другими свойствами %s",
                                    dto.getName(), persistedObjectDto));
                }

                Mono<RouteDto[]> routesMono = webClient.get().uri(uriBuilder -> uriBuilder
                                .path("/v1/route_attr/{object}")
                                .build(dto.getName()))
                        .retrieve()
                        .bodyToMono(RouteDto[].class);
                var persistedRoutes = Arrays.stream(routesMono.block()).collect(Collectors.toSet());
                if (!persistedRoutes.isEmpty()) {
                    neededRoutes.stream().filter(persistedRoutes::contains).forEach(r ->
                            message.append(String.format(". Объект %s и маршрут для %s в топик %s уже существовали",
                                    r.getObject(), r.getParameter(), r.getTopic()))
                    );
                    neededRoutes.removeAll(persistedRoutes);
                    if (neededRoutes.size() == 0) {
                        return persistedObjectDto;
                    }
                }
                var neededParameters = neededRoutes.stream().map(RouteDto::getParameter).collect(Collectors.toSet());
                message.append(String.format(". Объект %s существовал, нужно добавить маршруты для %s",
                        dto.getName(), neededParameters));

                var conflictingRoutes =
                        persistedRoutes.stream().filter(pr -> neededParameters.contains(pr.getParameter())).collect(
                                Collectors.toSet());
                if (!conflictingRoutes.isEmpty()) {
                    throw new IllegalStateException(
                            String.format("Уже существуют маршруты, но с другими параметрами: %s",
                                    conflictingRoutes.stream()
                                            .map(this::serializeForLog)
                                            .collect(Collectors.joining())));
                }
            }

            neededRoutes.forEach(r -> {
                try {
                    var newRoute = webClient.post().uri("/v1/route_attr")
                            .body(BodyInserters.fromValue(r)).retrieve()
                            .bodyToMono(RouteDto.class).block();
                    if (newRoute == null) {
                        throw new Exception("POST DATA-MANAGER:/v1/route_attr вернул ответ NULL");
                    } else {
                        message.append(String.format(". Создан маршрут %s", serializeForLog(newRoute)));
                    }
                } catch (Exception e) {
                    throw new NotFoundException(String.format("В реестре не нашлись идентификаторы для построения маршрутизации %s", r), e);
                }
            });

        } catch (Throwable t) {
                message.append(". Ошибка: ").append(t.getMessage());
                throw t;
        }
        finally {
            log.info(message.toString());
        }
        return persistedObjectDto;
    }

    public String deleteObjectByName(String objectName, String user, HttpServletRequest request) {
        var message =  new StringBuilder(String.format("Запрос на удаление объекта '%s' от пользователя '%s'", objectName, user));
        try {
            verifyConfiguration();
            var object = tagInfoStore.getObject(objectName);
            if (object == null) {
                throw new NotFoundException(String.format("Не найден объект с именем '%s'", objectName));
            }
            message.append(String.format(". Найден объект id=%d;name=%s;label=%s", object.getId(), object.getName(),
                    object.getLabel()));
            var newRequest = webClient.delete()
                    .uri(uriBuilder -> uriBuilder.path("/v1/configurator/object/{object_id}").build(object.getId()));
            passHeaders(newRequest, request);
            newRequest.retrieve().bodyToMono(Boolean.class).block();
            message.append(". Удалён успешно");
        } catch (Throwable t) {
            message.append(". Ошибка: ").append(t.getMessage());
            throw t;
        } finally {
            log.info(message.toString());
        }
        return message.toString();
    }

    private void passHeaders(WebClient.RequestHeadersSpec<? extends WebClient.RequestHeadersSpec<?>> newRequest, HttpServletRequest parentRequest) {
        newRequest.header("x-user-groups", StringUtils.defaultIfEmpty(parentRequest.getHeader("x-user-groups"), "ta"))
                .header("x-user-fullname", StringUtils.defaultIfEmpty(parentRequest.getHeader("x-user-fullname"), "system"))
                .header("x-user-ip", StringUtils.defaultIfEmpty(parentRequest.getHeader("x-user-ip"), "0.0.0.0"))
                .header("x-user-id", StringUtils.defaultIfEmpty(parentRequest.getHeader("x-user-id"), "00000000-0000-0000-0000-000000000000"));
    }

    private void verifyConfiguration() {
        if (StringUtils.isEmpty(DATAMANAGER_URL_ROOT)) {
            throw new RuntimeException("Не настроена переменная окружения DATAMANAGER_URL_ROOT");
        }
    }

    private boolean objectExistsInLocalCache(String objectName) {
        return tagInfoStore.getObject(objectName) != null;
    }
    public ObjectDto createObjectWithRoutingAndWaitForApply(ObjectDto dto, String user) {
        var result = createObjectWithRouting(dto, user);
        if (objectExistsInLocalCache(dto.getName())) {
            log.info("Новые данные об объекте {} уже попали по рассылке, ожидание не требуется", dto.getName());
            return result;
        } else {
            long waitedTime = getWaitedTime(() -> objectExistsInLocalCache(dto.getName()), 5000);
            if (objectExistsInLocalCache(dto.getName())) {
                log.info("Новые данные об объекте {} появились по рассылке за {}мс", dto.getName(), waitedTime);
            } else {
                throw new IllegalStateException(String.format("Данные по объекту %s существуют, но не появились через рассылку в приложении в течение %sмс",
                        dto.getName(), waitedTime));
            }
        }
        return result;

    }

    @WithSpan
    private long getWaitedTime(BooleanSupplier tillCondition, int waitTime) {
        var start = System.currentTimeMillis();
        var pollInterval = 500;
        var maxWait = start + waitTime;
        while (!tillCondition.getAsBoolean() && System.currentTimeMillis() <= maxWait) {
            try {
                Thread.sleep(pollInterval);
            } catch (InterruptedException ignored) {
            }
        }
        return System.currentTimeMillis() - start;
    }

    private String serializeForLog(RouteDto r) {
        if (r == null) {
            return "NULL";
        } else {
            return String.format("(%s,%s,%s,%s)",
                    r.getObject(), r.getParameter(), r.getDescentRule(), r.getTopic());
        }
    }
}



