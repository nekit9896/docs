import tnt.evoscada.api.Evo;
import tnt.tnscada.hmi.modelling.dto.SessionToServiceDTO;
import tnt.tnscada.hmi.errors.ApplicationLogicException;

@Service
@Slf4j
@RequiredArgsConstructor
public class SessionManager {
    private final ModelEvoApiManager modelEvoApiManager;
    private Map<Long, SessionToServiceDTO> sessions = new ConcurrentHashMap<>();

    public Map<Long, String> getExistingSessions() {
        return sessions.entrySet().stream()
                .collect(Collectors.toMap( e -> e.getKey(), e -> e.getValue().getMode()));
    }

    public Evo getEvoForSession(Long id) {
        if (!sessions.containsKey(id)) {
            throw new ApplicationLogicException("Нет данных о модельной/исторической сессии с ID " + id);
        }
        return modelEvoApiManager.getEvo(sessions.get(id));
    }

    @Transactional
    public void createSession(SessionToServiceDTO dto) {
        if (sessions.containsKey(dto.getSessionId()) ) {
            log.warn("Попытка создать сессию, которая уже существует с id={}", dto.getSessionId());
            if (!sessions.get(dto.getSessionId()).equals(dto)) {
                throw new ApplicationLogicException("Уже есть сессия с id " + dto.getSessionId() + ", но с другими параметрами: " + sessions.get(dto.getSessionId()).toString());
            }
        }
        try {
            // убеждаемся, что evoApi инициализировано и/или инициализируем.
            modelEvoApiManager.getEvo(dto);
            sessions.put(dto.getSessionId(), dto);
        } catch (Exception e) {
            throw new ApplicationLogicException("Не удалось создать сессию " + dto.getSessionId() + " : " + e.getMessage());
        }

    }

    @Transactional
    public void destroySession(Long id) {
        modelEvoApiManager.freeSession(sessions.get(id));
        sessions.remove(id);
    }

    public SessionToServiceDTO getSessionInfo(Long id) {
        return sessions.get(id);
    }
}



