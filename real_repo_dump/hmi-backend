package tnt.tnscada.hmi.hotlink;

import java.io.IOException;
import java.io.PrintWriter;
import java.io.StringWriter;
import java.time.Instant;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.Executors;
import java.util.concurrent.ScheduledExecutorService;
import java.util.concurrent.TimeUnit;
import java.util.function.Consumer;
import java.util.stream.Collectors;
import jakarta.annotation.PostConstruct;
import lombok.extern.slf4j.Slf4j;
import org.apache.commons.lang3.StringUtils;
import org.jetbrains.annotations.NotNull;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.web.socket.CloseStatus;
import org.springframework.web.socket.TextMessage;
import org.springframework.web.socket.WebSocketSession;
import org.springframework.web.socket.handler.AbstractWebSocketHandler;
import tnt.evoscada.api.Evo;
import tnt.tnscada.hmi.data.DataServiceV2;
import tnt.tnscada.hmi.dto.HotlinkDiagDTO;
import tnt.tnscada.hmi.dto.SummaryIntervalsStatDTO;
import tnt.tnscada.hmi.errors.ApplicationLogicException;
import tnt.tnscada.hmi.service.TagInfoService;

@Slf4j
public abstract class HotlinkWebSocketHandlerBase<TSession extends HotlinkSessionBase<?>> extends AbstractWebSocketHandler {
    protected final Evo evo;

    @Value("${tn-scada.hmi.sample-time}")
    protected Integer sampleTime;

    @Value("${tn-scada.hmi.clientside-stale-time-s}")
    protected int clientsideStaleSecs;

    @Value("${tn-scada.hmi.clientside-wake-time-s}")
    protected int clientsideWakeSecs;

    protected final Map<String, TSession> sessions = new ConcurrentHashMap<>();

    @Value("${tn-scada.hmi.clock-message-interval-s}")
    protected int clockIntervalSec;

    private final ScheduledExecutorService executor = Executors.newScheduledThreadPool(1);
    protected final DataServiceV2 dataService;

    protected final TagInfoService tagInfoService;

    public HotlinkWebSocketHandlerBase(Evo evo, DataServiceV2 dataService,
                                       TagInfoService tagInfoService) {
        this.evo = evo;
        this.dataService = dataService;
        this.tagInfoService = tagInfoService;
    }

    @PostConstruct
    public void init() {
        log.info("clock-message-interval-s: {}", clockIntervalSec);
        if (clockIntervalSec > 0) {
            executor.scheduleWithFixedDelay(this::tickClock, 0, clockIntervalSec, TimeUnit.SECONDS);
        }
    }

    protected abstract TSession constructSession(WebSocketSession webSocketSession);

    private void tickClock(){
        sessions.values().forEach(TSession::sendTimeStateToSession);
    }

    protected void removeSession(WebSocketSession webSocketSession) {
        var hotlinkSession = sessions.remove(webSocketSession.getId());
        if (hotlinkSession == null) {
            //writeLogWithSessionStat("Попытка удалить незаписанную сессию", webSocketSession);
        } else {
            writeLogWithSessionStat("Удалена сессия", webSocketSession);
            if (hotlinkSession.isOpen()) {
                try {
                    hotlinkSession.close();
                } catch (IOException e) {
                    e.printStackTrace();
                }
            }
        }
    }

    protected void doOnSession(String sessionId, Consumer<TSession> consumer) {
        var session = sessions.get(sessionId);
        if (session == null) {
            return;
        }

        consumer.accept(session);
    }

    protected void doOnOpenSession(String sessionId, Consumer<TSession> consumer) {
        var session = sessions.get(sessionId);
        if (session == null || !session.isOpen()) {
            return;
        }

        consumer.accept(session);
    }

    @SuppressWarnings("resource")
    protected void closeSession(String sessionId, CloseStatus status, String reason) {
        doOnOpenSession(sessionId, session -> {
            try {
                session.close(new CloseStatus(status.getCode(), reason));
                log.info("Closed session {} with status {}", session, status);
            } catch (IOException e) {
                log.error(e.getMessage());
            }
        });
        sessions.remove(sessionId);
    }

    private void writeLogWithSessionStat(String action, WebSocketSession webSocketSession) {
        var currentIP = webSocketSession.getAttributes().get("IP");
        var currentUser = webSocketSession.getAttributes().get("x-user-fullname");
        var statIP = sessions.values().stream()
                .map(hs -> hs.getSessionAttributeAsString("IP"))
                .filter(ip -> ip.equals(currentIP)).count();
        var statUser = sessions.values().stream()
                .map(hs -> hs.getSessionAttributeAsString("x-user-fullname"))
                .filter(ip -> ip.equals(currentUser)).count();
        log.info("{} {}; Для IP '{}' {} сессий; Для учётки '{}' {} сессий; Всего сессий: {}",
                action, webSocketSession.getId(), currentIP, statIP, currentUser, statUser, sessions.size());
    }



    public void wakeUpStaleSessions() {
        if (clientsideWakeSecs < 1) {
            return;
        }
        var curTime = System.currentTimeMillis();
        var deadline = curTime - clientsideWakeSecs * 1000L;
        var idlers = sessions.values().stream()
                .filter(s -> s.getLastClientsideActivity() < deadline).collect(Collectors.toSet());

        if (idlers.size() > 0) {

            var clientsIdleStat = idlers.stream()
                    .map(s -> Math.max(0, curTime - s.getLastClientsideActivity()))
                    .sorted()
                    .collect(Collectors.toList());

            if (clientsIdleStat.size() > 0){
                log.info("Время отсутствия сообщений от клиента, по всем спящим {} сессиям: медиана={}мс, максимум={}мс",
                        sessions.size(),
                        Math.round(median(clientsIdleStat)),
                        clientsIdleStat.get(clientsIdleStat.size()-1));
            }
            log.info("Будим {}шт сессий, по которым не было входящих сообщений более {}с",
                    idlers.size(), clientsideWakeSecs);
            if (log.isDebugEnabled()) {
                log.debug("Список спящих:\n{}", idlers.stream().map(s -> String.format("%s: %sс; %s", s.getId(), (curTime - s.getLastClientsideActivity()) / 1000,
                                adaptForLog(s.getLastCommand(), 60)))
                        .collect(Collectors.joining("\n")));
            }
            idlers.forEach(s -> {
                try {
                    s.sendToSession("Are you alive?");
                } catch (Exception e) {
                    log.error("Не удалось отправить пробуждающее сообщение в сессию {}", s.getId());
                }
            });
        }
    }

    public void killStaleSessions() {
        if (clientsideStaleSecs < 1) {
            return;
        }
        var curTime = System.currentTimeMillis();
        var deadline = curTime - clientsideStaleSecs * 1000L;
        var idlers = sessions.values().stream()
                .filter(s -> s.getLastClientsideActivity() < deadline).collect(Collectors.toSet());
        if (idlers.size() > 0) {
            log.info("Принудительно закрываем {}шт сессий, по которым не было входящих сообщений более {}с",
                    idlers.size(), clientsideStaleSecs);
            if (log.isDebugEnabled()) {
                log.debug("Список на закрытие:\n{}", idlers.stream().map(s -> String.format("%s: %sс; %s", s.getId(), (curTime - s.getLastClientsideActivity()) / 1000,
                                adaptForLog(s.getLastCommand(), 60)))
                        .collect(Collectors.joining("\n")));
            }
            idlers.forEach(s -> {
                try {
                    s.sendErrorToSession(new InterruptedException(
                                String.format(
                                        "Не было ни одного сообщения со стороны клиента в течение %dс; Порог времени простоя %dс",
                                        (curTime - s.getLastClientsideActivity()) / 1000, clientsideStaleSecs)));
                } catch (Exception e) {
                    log.error("Не удалось отправить пояснение о закрытии в завершаемую сессию {}: {}", s.getId(), e.getMessage());
                }
                try {
                    s.close(CloseStatus.SESSION_NOT_RELIABLE);
                } catch (Exception e) {
                    log.error("Не удалось принудительно завершить сессию {}: {}", s.getId(), e.getMessage());
                }
            });
        }
    }

    private double median(List<Long> sorted){
        int middle = sorted.size()/2;
        if (sorted.size() % 2 == 1) {
            return sorted.get(middle);
        } else {
            return (sorted.get(middle-1) + sorted.get(middle)) / 2.0;
        }
    }

    private String adaptForLog(String anyString, int limit) {
        if (anyString == null) {
            return "N/A";
        } else {
            var sanitized = anyString.replaceAll("\r\n", " ").strip();
            if (sanitized.length() <= limit) {
                return sanitized;
            } else {
                return StringUtils.substring(sanitized,0, limit) + "…";
            }
        }
    }

    @Override
    public void afterConnectionEstablished(WebSocketSession session) {
        session.getAttributes().put("msg-buffer", new StringBuilder(session.getTextMessageSizeLimit()));
        try {
            var sessionStored = constructSession(session);
            sessions.put(session.getId(), sessionStored);
        } catch (ApplicationLogicException ae) {
            log.warn("Не приняли websocket-сессию: {}", ae.getMessage());
            try {
                session.close(CloseStatus.NOT_ACCEPTABLE);
            } catch (IOException e) {
                throw new RuntimeException(e);
            }
            return;
        }
        writeLogWithSessionStat("Новая сессия", session);
    }

    @Override
    public void afterConnectionClosed(WebSocketSession session, @NotNull CloseStatus status) {
        log.debug("{} afterConnectionClosed: {}, CloseStatus: {}", getClass().getSimpleName(), session.getId(), status);
        removeSession(session);
    }

    @Override
    public void handleTransportError(WebSocketSession session, Throwable exception) throws Exception {
        StringWriter sw = new StringWriter();
        PrintWriter pw = new PrintWriter(sw);
        pw.write(exception.getClass().getSimpleName() + ": " + exception.getMessage() + "\r\n");
        exception.printStackTrace(pw);

        log.error("Websocket transport error. Session={}, error={}", session.getId(), sw);
        doOnOpenSession(session.getId(), hs -> hs.sendErrorToSession(exception));
    }

    @Override
    public void handleTextMessage(WebSocketSession session, TextMessage message) {
        StringBuilder msgBuilder = (StringBuilder) session.getAttributes().get("msg-buffer");
        var payload = message.getPayload();
        if (!message.isLast()) {
            msgBuilder.append(payload);
        } else {
            if (msgBuilder.length() != 0) {
                msgBuilder.append(payload);
                handleWholeMessage(session, msgBuilder.toString());
                msgBuilder.setLength(0);
                msgBuilder.trimToSize();
            } else {
                handleWholeMessage(session, payload);
            }
        }
    }

    public int getSessionsCount() {
        return sessions.size();
    }

    public List<HotlinkDiagDTO> getMonitoringList() {
        var resultList = new ArrayList<HotlinkDiagDTO>();
        var nowStamp = System.currentTimeMillis();
        sessions.forEach( (id, s) -> {
            try {
                var dto = new HotlinkDiagDTO();
                dto.setId(s.getId());
                dto.setHeaders(s.getMonitorHeaders());
                dto.setUptimeSeconds((nowStamp - s.getSessionStartTimeMillis()) / 1000);
                dto.setIdleSeconds((nowStamp - Math.max(s.getLastTagDataSent(), s.getLastClientsideActivity())) / 1000);
                dto.setSubscriptions(s.getSubscriptionsCount());
                dto.setSince(Instant.ofEpochMilli(s.getSessionStartTimeMillis()));
                dto.setDataStream(s.getActiveDataStreamName());
                dto.setVersion(s.getVersion());
                dto.setCommands(s.getCommandsCount());
                dto.setTotalMessages(s.getSentToClientMessages());
                dto.setMessageRate(SummaryIntervalsStatDTO.of(s.getSendStats()));
                dto.setCommandRate(SummaryIntervalsStatDTO.of(s.getReceiveStats()));
                dto.setTagChangeInternalRate(SummaryIntervalsStatDTO.of(s.getTagChangeInternalStats()));
                dto.setTagChangeSentRate(SummaryIntervalsStatDTO.of(s.getTagChangeSentStats()));
                resultList.add(dto);
            } catch (Throwable t) {
                log.warn("Error while monitor slice for session {}", id, t);
            }
        });
        return resultList;
    }

    private void handleWholeMessage(WebSocketSession session, String payload) {
        log.debug("handleWholeMessage {}", payload);
        doOnSession(session.getId(), hs -> {
            try {
                if(StringUtils.isNotEmpty(payload)) {
                    hs.updateLastClientsideActivity();
                    hs.setLastCommand(payload);
                }
                hs.handlePayload(payload);
            } catch (Throwable t) {
                try {
                    log.error("Request processing error", t);
                    if(hs.isOpen()) {
                        hs.sendErrorToSession(t);
                    }
                } catch (Throwable st) {
                    closeSession(session.getId(), CloseStatus.SERVER_ERROR,
                            st.getClass().getName() + ": " + st.getMessage() + (st.getCause() != null ? ": " +
                                    st.getCause().getMessage() : ""));
                    throw st;
                }
            }
        });
    }

    @Override
    public boolean supportsPartialMessages() {
        return true;
    }
}



