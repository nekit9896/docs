    @PostMapping(path = "/tag-set-and-wait")
    public boolean setAndWait(
            @RequestHeader(value = "X-USER-FULLNAME", required = false) String user,
            @RequestHeader(value = "X-USER-IP", required = false) String userIp,
            @RequestHeader(value = "X-USER-ALLOW-PATTERNS", defaultValue = "[\".*\"]")
            @Schema(format = "Строка, представляющая JSON-массив", defaultValue = "[\".*\"]")
            String allowPatterns,

            @RequestHeader(value = "X-USER-FORBIDDEN-PATTERNS", required = false)
            @Schema(format = "Строка, представляющая JSON-массив", defaultValue = "[]")
            String forbiddenPatterns,

            @RequestBody @Schema(type = "object", example = SETWAIT_VALUE_MESSAGE_EXAMPLE) TagSetAndWaitDTO tagSetAndWaitDTO,
            HttpServletRequest request
    )
            throws InterruptedException, InvalidProtocolBufferException, ApplicationLogicException {
        user = ControllerUtils.getUser(user, request);
        log.debug("set and wait: user={}, tagSetAndWaitDTO={}", user, tagSetAndWaitDTO);
        var tagsWaitFor = parseTagsValueMsg(tagSetAndWaitDTO.getTagsWait());
        if (tagSetAndWaitDTO.getTagWait() != null && !tagSetAndWaitDTO.getTagWait().isNull()) {
            var tagWaitFor = parseTagValueMsg(tagSetAndWaitDTO.getTagWait().toString());
            tagsWaitFor.add(tagWaitFor);
        }
        var tagSet = parseTagValueMsg(tagSetAndWaitDTO.getTagSet().toString());

        Set<String> allowPatternsSet = ControllerUtils.getNullableStringsSet(allowPatterns);
        Set<String> forbiddenPatternsSet = ControllerUtils.getNullableStringsSet(forbiddenPatterns);
        var currentSetTagState = dataService.get(tagSet.getTag(), allowPatternsSet, forbiddenPatternsSet, user);

        var settingSameOldValue = false;
        if (TagValueUtils.tagValueEqual(tagSet, currentSetTagState)) {
            settingSameOldValue = true;
            log.debug("Частный случай, установка актуального значения");
        }
        long waitUntil = System.currentTimeMillis() + tagSetAndWaitDTO.getTimeoutMs();
        long pollInterval = 200;
        Set<String> waitSessions = new HashSet<String>();
        try {
            for (var tagWaitFor : tagsWaitFor) {
                var currentAwaitedTagState = dataService.get(
                        tagWaitFor.getTag(),
                        allowPatternsSet,
                        forbiddenPatternsSet,
                        user
                );
                if ((tagSet.getTag().equals(tagWaitFor.getTag()) && !settingSameOldValue)// ставим то же значение, не придёт в подписку
                        || !TagValueUtils.tagValueEqual(tagWaitFor, currentAwaitedTagState)) {
                    waitSessions.add(hotlinkService.initWaitSession(tagWaitFor));
                }
            }
            dataService.set(user, tagSet, allowPatternsSet, forbiddenPatternsSet,
                            RequestUtils.getClientIpAddr(request), userIp
            );
            while (true) {
                waitSessions = waitSessions.stream()
                        .filter(sessionId -> {
                            if (hotlinkService.getWaitSessionTriggered(sessionId)) {
                                hotlinkService.removeWaitSession(sessionId);
                                return false;
                            } else {
                                return true;
                            }
                        })
                        .collect(Collectors.toSet());

                if (!waitSessions.isEmpty()) {
                    if (System.currentTimeMillis() + pollInterval < waitUntil) {
                        Thread.sleep(pollInterval);
                    } else {
                        var timeoutedTags =
                                waitSessions.stream().map(hotlinkService::getWaitSessionTagName).collect(
                                        Collectors.toSet());
                        throw new ApplicationLogicException(
                                String.format("Не дождались изменения тегов %s за %sмс после изменения тега %s",
                                              timeoutedTags, tagSetAndWaitDTO.getTimeoutMs(), tagSet.getTag()
                                ));
                    }
                } else {
                    return true;
                }

            }
        } finally {
            for (var sessionId : waitSessions) {
                hotlinkService.removeWaitSession(sessionId);
            }
        }
    }

    private static HmiMsg.TagValueMsg parseTagValueMsg(String serialized) throws InvalidProtocolBufferException {
        var waitBuilder = HmiMsg.TagValueMsg.newBuilder();
        JsonFormat.parser().ignoringUnknownFields().merge(serialized, waitBuilder);
        return waitBuilder.build();
    }

    private static Set<HmiMsg.TagValueMsg> parseTagsValueMsg(Set<JsonNode> jsonNodes) throws InvalidProtocolBufferException {
        var result = new HashSet<HmiMsg.TagValueMsg>();
        if (jsonNodes != null) {
            for (JsonNode n : jsonNodes) {
                result.add(parseTagValueMsg(n.toString()));
            }
        }
        return result;
    }
}


