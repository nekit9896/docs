    protected void sendDtoCollection(Collection<AnswerItem> collection) {
        log.debug("SUB_ANSWER: sessionId: {}. Accept {} items", getId(), collection.size());
        StringBuilder sb = new StringBuilder();

        sb.append("{\"message_type\":\"").append(SUB_ANSWER).append("\",\"message\":[");

        int successCount = 0;
        var first = true;

        if (collection != null) {
            for (AnswerItem item : collection) {
                if (item == null) {
                    continue;
                }

                String itemJson;
                try {
                    itemJson = objectMapper.writeValueAsString(item);
                    successCount++;

                } catch (JsonProcessingException e) {
                    log.error("Failed to serialize AnswerItem for tag {}", item.getTag(), e);
                    try {
                        itemJson = objectMapper.writeValueAsString(new AnswerItem(item.getTag(), null, "Failed to serialize AnswerItem"));
                    } catch (JsonProcessingException ex) {
                        throw new RuntimeException(ex);
                    }
                }

                if (!first) {
                    sb.append(",");
                }
                first = false;

                sb.append(itemJson);
            }
        }

        sb.append("]}");

        try {
            String summary = HotlinkMessageLogger.isLoggingEnabled()
                    ? HotlinkMessageLogger.summarizeAnswerItems(collection)
                    : null;
            sendToSession(sb.toString(), SUB_ANSWER, null, summary);
            tagChangeSentTick(successCount);

        } catch (Exception e) {
            log.error("Error while sending answer to session", e);
        }
    }

