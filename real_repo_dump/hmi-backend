    private static <T> Stream<T> paginate(Stream<T> stream, Integer page, Integer size) {
        page = page == null || page < 0 ? 0 : page;
        size = size == null || size <= 0 ? DEFAULT_PAGE_SIZE : size;

        return stream.skip((long) page * size).limit(size);
    }

    @GetMapping("/v1/configurator/project")
    @Operation(
            summary = "Список проектов",
            description = "Предоставляет список проектов",
