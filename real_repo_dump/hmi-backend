@Slf4j
public class HistoryDataStreamProvider implements DataStreamProvider {
    private static final long MIN_MILLIS_PER_TICK = 50L;
    private static final long MAX_MILLIS_PER_TICK = 10000L;
    private static final long DEFAULT_TIMEBUCKET_MILLIS = 1000L;

    private static final int VALUE_HANDLER = 0;

    private static final int ALARM_HANDLER = 1;

    private final List<HistoryStreamHandler<?>> handlers = new ArrayList<>();


    private ScheduledFuture<?> ticker;

    private final ScheduledExecutorService intervalExecutor = Executors.newScheduledThreadPool(1);

    private final long tickDelayMillis = 1000;

    private long tickWindowMilliseconds;

    private Instant startTime;

    private Instant finishTime;

    private long cursorLast = 0;

    private final UUID id = UUID.randomUUID();

    public HistoryDataStreamProvider(
            Evo evo,
            DataCallback<TagValue> valueCallback,
            DataCallback<TagAlarm> alarmCallback,
            AttributeCallback<?> ignored) {
        handlers.add(new TagValueStreamHandler(evo, valueCallback));
        handlers.add(new TagAlarmStreamHandler(evo, alarmCallback));
    }

    public void initStream(Instant start, Instant finish, Long speedMillisPerTick) {
        log.info("Initiating {} {} {}", start, finish, speedMillisPerTick);
        startTime = start;
        finishTime = finish;
        if (speedMillisPerTick == null || speedMillisPerTick < 50) {
            log.info("fixing speedMillisPerTick from {} to {}", speedMillisPerTick, DEFAULT_TIMEBUCKET_MILLIS);
            speedMillisPerTick = DEFAULT_TIMEBUCKET_MILLIS;
        }
        setSpeed(speedMillisPerTick);
        handlers.forEach(h -> h.initStream(start, finish));
        setCursorAt(startTime.toEpochMilli());
    }

    public void initStream(Long sessionId) {
        throw new ApplicationLogicException("Вызван неподдерживаемый метод инициации исторического потока данных");
    }

    public void setSpeed(long millis) {
        if (millis < MIN_MILLIS_PER_TICK) {
            log.warn("Tried to set too slow speed: {} ms per tick with limit {}", millis, MIN_MILLIS_PER_TICK);
            millis = MIN_MILLIS_PER_TICK;
        } else if (millis > MAX_MILLIS_PER_TICK) {
            log.warn("Tried to set too fast speed: {} ms per tick with limit {}", millis, MAX_MILLIS_PER_TICK);
            millis = MAX_MILLIS_PER_TICK;
        }
        log.info("Setting speed {} ms per tick", millis);
        if (tickWindowMilliseconds > 0) {
            if (millis < tickWindowMilliseconds) {
                log.info("slowing down --");
            } else if (millis > tickWindowMilliseconds) {
                log.info("speeding up ++");
            }
        }
        tickWindowMilliseconds = millis;
        handlers.forEach(h -> h.setTickWindowMillis(tickWindowMilliseconds));
    }

    @Override
    public void setActive(boolean active) {
        if(!active) {
            stop();
        }

        handlers.forEach(h -> h.setActive(active));
    }

    public void play() {
        if(!isPlaying()) {
            handlers.forEach(HistoryStreamHandler::startSubplayer);
            ticker = intervalExecutor.scheduleAtFixedRate(() -> {
                AtomicBoolean tickDataWasReady = new AtomicBoolean(true);
                handlers.forEach(s -> {
                    if (!s.tick()) {
                        tickDataWasReady.set(false);
                    }
                });
                if (!tickDataWasReady.get()) {
                    return;
                }
                setCursorLast(cursorLast + tickWindowMilliseconds);
                if (cursorLast > finishTime.toEpochMilli()) {
                    cursorLast = finishTime.toEpochMilli();
                    stop();
                }
            }, 0, tickDelayMillis, TimeUnit.MILLISECONDS);
            log.info("Started playing");
        } else {
            log.info("Was already playing");
        }
    }

    public void stop() {
        if (isPlaying()) {
            ticker.cancel(true);
            ticker = null;
            log.info("Stopped at {} {}", cursorLast, Instant.ofEpochMilli(cursorLast));
            handlers.forEach(HistoryStreamHandler::stopSubplayer);
        } else {
            log.debug("Was not playing");
        }
    }

    @Override
    public void seek(Instant datetime) {
        setCursorAt(datetime.toEpochMilli());
    }

    @Override
    public Instant getTime() {
        return Instant.ofEpochMilli(cursorLast);
    }

    @Override
    public boolean isPausedTillUpload() {
        return isPlaying() && handlers.stream().anyMatch(HistoryStreamHandler::isPausedTillUpload);
    }

    @Override
    public void valueSubscribe(Set<Pair<Tag, Attributes>> tags) {
        handlers.get(VALUE_HANDLER).subscribe(tags.stream().map(Pair::getKey).collect(Collectors.toSet()));
    }

    @Override
    public void alarmSubscribe(Set<Pair<Tag, Attributes>> tags) {
        handlers.get(ALARM_HANDLER).subscribe(tags.stream().map(Pair::getKey).collect(Collectors.toSet()));
    }

    @Override
    public void attributeSubscribe(Set<Pair<Tag, Attributes>> tags) {
    }

    @Override
    public void unsubscribeAll() {
        handlers.forEach(HistoryStreamHandler::unsubscribeAll);
    }

    @Override
    public void valueUnsubscribe(Set<Pair<Tag, Attributes>> tags) {
        handlers.get(VALUE_HANDLER).unsubscribe(tags.stream().map(Pair::getKey).collect(Collectors.toSet()));
    }

    @Override
    public void alarmUnsubscribe(Set<Pair<Tag, Attributes>> tags) {
        handlers.get(ALARM_HANDLER).unsubscribe(tags.stream().map(Pair::getKey).collect(Collectors.toSet()));
    }

    @Override
    public void attributeUnsubscribe(Set<Pair<Tag, Attributes>> tags) {
    }

    @Override
    public void close() throws IOException {
        stop();
        intervalExecutor.shutdown();
        handlers.forEach(h -> h.close());
    }

    @Override
    public Integer[] getTimelineState() {
        val states = handlers.stream().map(HistoryStreamHandler::getTimelineState).toList();
        val maxLen = states.stream().map(a -> a.length).max(Integer::compareTo).orElse(0);
        val minLen = states.stream().map(a -> a.length).min(Integer::compareTo).orElse(0);
        val result = new Integer[maxLen];
        Arrays.fill(result, 0);
        Arrays.fill(result, 0, minLen, 1);

        states.forEach(a -> {
           for(var i = 0; i < a.length; i++) {
               if(a[i] <= 0) {
                   result[i] = 0;
               }
           }
        });

        return result;
    }

    private boolean isPlaying() {
        return ticker != null;
    }

    private void setCursorAt(long millis) {
        log.info("Setting cursor in range {} - {} : {}", startTime, finishTime, Instant.ofEpochMilli(millis));
        if (millis < startTime.toEpochMilli()) {
            log.warn("Tried to set cursor out of bounds at {}, fixing to start time {}", Instant.ofEpochMilli(millis), startTime);
            millis = startTime.toEpochMilli();
        } else if (finishTime.toEpochMilli() < millis) {
            log.warn("Tried to set cursor out of bounds at {}, fixing to finish time {}", Instant.ofEpochMilli(millis), finishTime);
            millis = finishTime.toEpochMilli();
        }
        if (cursorLast > 0) {
            if (millis < cursorLast) {
                log.info("Rewind << by {} ms", cursorLast - millis);
            } else if (millis > cursorLast) {
                log.info("Fast forward >> by {} ms", millis - cursorLast);
            }
        }
        long finalMillis = millis;
        handlers.forEach(h -> h.setForceLoadBoundsFrom(finalMillis));
        setCursorLast(finalMillis);
        handlers.forEach(h -> h.sendSnapshot());
    }

    private void setCursorLast(long cursorLast) {
        this.cursorLast = cursorLast;
        handlers.forEach(h -> h.setCursorLast(cursorLast));
    }

    @Override
    public UUID getId() {
        return id;
    }

    @Override
    public JsonObject getState() {
        var data = new JsonObject();
        data.addProperty("type", "history");
        data.addProperty("id", getId().toString());
        data.addProperty("start_millis", startTime.toEpochMilli());
        data.addProperty("finish_millis", finishTime.toEpochMilli());
        data.addProperty("millis_per_tick", tickWindowMilliseconds);
        data.addProperty("is_playing", isPlaying());
        data.addProperty("paused_till_upload", isPausedTillUpload());
        data.add("timeline_state", JsonUtils.getJsonArray(List.of(getTimelineState())));
        return data;
    }

    @Override
    public Map<String, Integer> getSubscriptionCount() {
        return null;
    }

    @Override
    public Evo getEvo() {
        return null;
    }
