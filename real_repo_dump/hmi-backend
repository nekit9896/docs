    public void set(
            @RequestHeader(value = "X-USER-FULLNAME", required = false) String user,
            @RequestHeader(value = "X-USER-IP", required = false) String userIp,
            @RequestHeader(value = "X-USER-ALLOW-PATTERNS", defaultValue = "[\".*\"]")
            @Schema(format = "Строка, представляющая JSON-массив", defaultValue = "[\".*\"]")
            String allowPatterns,

            @RequestHeader(value = "X-USER-FORBIDDEN-PATTERNS", required = false)
            @Schema(format = "Строка, представляющая JSON-массив", defaultValue = "[]")
            String forbiddenPatterns,

            @RequestBody @Schema(type = "object", example = VALUE_MESSAGE_EXAMPLE) TagSetRequest item,
