import java.util.concurrent.atomic.AtomicInteger;
import java.util.stream.Collectors;
import java.util.stream.IntStream;

//Запускаем вручную
@Disabled
public class LoadTest {
    private static final String WS_URI = "ws://localhost:19900/hotlink";
    private static final int CONCURRENT_CONNECTIONS = 15;
    private static final int TEST_DURATION_SECONDS = 60000;
    //    private static final int MESSAGES_PER_CLIENT = 50;
    private static final AtomicInteger successfulConnections = new AtomicInteger(0);
    private static final AtomicInteger messagesCount = new AtomicInteger(0);

    @Test
    public void test() throws InterruptedException {
        ExecutorService executorService = Executors.newFixedThreadPool(CONCURRENT_CONNECTIONS);
        var latch = new CountDownLatch(CONCURRENT_CONNECTIONS);
        for (int i = 0; i < CONCURRENT_CONNECTIONS; i++) {
            final int inx = i;
            executorService.submit(() -> {
                connectAndSendMessages(inx*80 + 1, inx*80 + 80);
                latch.countDown();
            });
        }

        latch.await();
        System.out.println("DONE");
    }

    private void connectAndSendMessages(int start, int end) {
        HttpClient httpClient = HttpClient.create().option(ChannelOption.CONNECT_TIMEOUT_MILLIS, 10000)
                .doOnConnected(conn -> conn.addHandlerLast(new WebSocketFrameAggregator(10 * 1024 * 1024)));
        WebSocketClient client = new ReactorNettyWebSocketClient(httpClient);

        var tags = IntStream.range(start, end)
                .mapToObj(operand -> "TEST_" + operand)
                .flatMap(s -> IntStream.range(1, 50).mapToObj(i -> s + ".Value" + i))
                .collect(Collectors.joining(" "));
        client.execute(
                        URI.create(WS_URI),
                        session -> {
                            Mono<Void> sendSubscription = session.send(
                                    Mono.just(session.textMessage("SUBSCRIBE " + tags))
                                            .doOnSubscribe(s -> System.out.println("Sending subscription " + start + " - " + end)));

                            Mono<Void> receiveMessages = session.receive()
                                    .map(WebSocketMessage::getPayloadAsText)
                                    .doOnNext(msg -> messagesCount.incrementAndGet())
                                    .take(Duration.ofSeconds(TEST_DURATION_SECONDS))
                                    .then();

                            return sendSubscription.then(receiveMessages);
                        }
                )
                .block(Duration.ofSeconds(TEST_DURATION_SECONDS + 5));
    }

    private void printStatistics(long duration) {
        System.out.println("\n--- Load Test Results ---");
        System.out.println("Successful connections: " + successfulConnections.get() + "/" + CONCURRENT_CONNECTIONS);
        System.out.println("Total messages sent: " + messagesCount.get());
        System.out.println("Test duration: " + duration + " ms");
        System.out.println("Throughput: " + (messagesCount.get() / Math.max(duration / 1000.0, 1)) + " msg/sec");
    }
}



