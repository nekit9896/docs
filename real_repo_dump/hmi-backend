    function insertRow(tableBody, rowData) {
        rowsNumber = rowsNumber + 1;
        let rowNumber = rowsNumber;
        let tagName = rowData.tag.replace(/\s+/g,'');
        let tagLabel = rowData.label;
        if (!skipTableInit) {
            let newRow = tableBody.insertRow();
            newRow.innerHTML = `
                <td id="tag-column-${rowNumber}"
                    class="tag-column"
                    onclick="enableEditing(this)"
                    onkeydown="handleTagInput(this, ${rowNumber}, event)">${tagName}</td>
                <td id="label-column-${rowNumber}" class="label-column">${tagLabel}</td>
                <td id="value-column-${rowNumber}" class="value-column"
                    onclick="enableEditing(this)" onkeydown="handleValueInput(${rowNumber}, event)">${rowData.value}</td>
                <td id="ts-column-${rowNumber}" class="ts-column" onclick="toggleAlt(this)">${rowData.ts}</td>
                <td id="invalid-column-${rowNumber}" class="invalid-column"><input type="checkbox" ${!!rowData.invalid ? "checked" : ""}/></td>
                <td id="status-column-${rowNumber}" class="status-column">${rowData.status}</td>
                <td id="value-type-column-${rowNumber}" class="value-type-column" hidden="hidden">${rowData.valueAttrType}</td>
                <td id="action-column-${rowNumber}" ><button onclick="sendValueForRow(${rowNumber})">Отправить</button></td>
                <td id="service-column-${rowNumber}" >${rowData.service}</td>
                <td id="user-column-${rowNumber}" >${rowData.user}</td>
                <td id="delete-column-${rowNumber}" class="delete-column"><button class="delete-btn">−</button></td>
            `;

            // ============= VALUE CELL (увеличение/уменьшение) =================
            let valueCell = newRow.querySelector(`#value-column-${rowNumber}`);
            valueCell.addEventListener("mousedown", async (e) => {
                if (!e.ctrlKey) return; // только если зажат ctrl
                e.preventDefault();

                let type = rowData.valueAttrType;
                let currentValue = valueCell.textContent.trim();

                if (["intVar", "floatVar", "doubleVar"].includes(type)) {
                    let num = parseFloat(currentValue) || 0;

                    if (e.button === 0) { // левая кнопка
                        num += 1;
                    } else if (e.button === 2) { // правая кнопка
                        num -= 1;
                    }

                    valueCell.textContent = num;
                    await sendValueForRow(rowNumber);

                } else if (type === "boolVar") {
                    let newVal = null;

                    if (e.button === 0) { // левая
                        newVal = true;
                    } else if (e.button === 2) { // правая
                        newVal = false;
                    }

                    if (newVal !== null) {
                        valueCell.textContent = newVal;
                        await sendValueForRow(rowNumber);
                    }
                }
            });

            // отключаем стандартное контекстное меню в ячейке value
            valueCell.addEventListener("contextmenu", (e) => {
                if (e.ctrlKey) e.preventDefault();
            });

            // ============= INVALID CHECKBOX =================
            let invalidCell = newRow.querySelector(`#invalid-column-${rowNumber} input[type="checkbox"]`);
            invalidCell.addEventListener("click", async (e) => {
                if (e.ctrlKey) {
                    await sendValueForRow(rowNumber); // при ctrl отправляем сразу при изменении
                }
                // без ctrl только меняем чек бокс
            });
            // ============= DELETE BUTTON =================
            let deleteBtn = newRow.querySelector(`#delete-column-${rowNumber} .delete-btn`);
            deleteBtn.addEventListener("click", () => {
                newRow.remove(); // удаляем строку
            });

            calcHashedBgColor(newRow.querySelector(`#tag-column-${rowNumber}`));
        }

        if (rowData.tag !== "") {
            setValueTypeAndSubscribe(rowNumber, tagName, rowData.valueAttrType);
        }


    }


