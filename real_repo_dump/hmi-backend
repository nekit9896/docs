    public List<ObjectTypeResponse> getObjectTypes(
            @RequestParam(required = false) Integer projectId,
            @RequestParam(required = false) Integer page,
            @RequestParam(required = false) Integer size) {

        return paginate(store.getTypes()
                    .filter(t -> projectId == null || Objects.equals(t.getProject().getId(), projectId))
                    .sorted(Comparator.comparing(ObjectTypeIdentifier::getName)), page, size)
                .map(ot -> new ObjectTypeResponse(
                        projectId == null ? 0 : projectId,
                        ot.getId(),
                        ot.getName(false),
                        ot.getParameterNameMap().get("").getLabel()))
                .toList();
    }

