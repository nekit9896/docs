import tnt.evoscada.api.data.TagValueType;
import tnt.evoscada.manager.data.TagImpl;
import tnt.tnscada.hmi.utils.RequireServerReady;

import java.util.List;
import java.util.Set;

@RestController
@Tag(name = "TagInfoControllerV2", description = "Справочник по тегам и ИО")
@CrossOrigin(origins = "#{'${server.ALLOWED_ORIGINS}'}")
@RequiredArgsConstructor
@Slf4j
@RequestMapping("/v2")
@RequireServerReady
public class TagInfoControllerV2 {
    private final Evo evo;

    @Operation(summary = "Найти список тегов")
    @GetMapping("/tag-names")
    @Cacheable(value = "tagNamesV2")
    @WithSpan
    public List<String> tagNames(
            @RequestParam @Schema(description = "Шаблон искомых объектов", example = ".*")
            String objectPattern,
            @RequestParam @Schema(description = "Шаблон искомых параметров", example = ".*")
            String parameterPattern,
            @RequestParam(name = "types", required = false) @Schema(description = "Типы тегов", type = "array")
            Set<String> types,
            @RequestParam(defaultValue = "false", required = false) @Schema(description = "Не включать в выдачу тэги типа FOLDER")
            boolean skipFolders,
            @RequestParam(required = false) @Schema(description = "Ограничение выводимых записей", example = "50")
            Integer limit
    ) {
        var start = System.currentTimeMillis();

        var p = parameterPattern;
        val normalized = TagImpl.normalizeTagName(p);
        if(normalized.getValue() != Attributes.Value) {
            p = normalized.getKey();
        }
        val effectiveParameterPattern = p;

        var queryBuilder = Query.newBuilder()
                .setObjectPattern(objectPattern)
                .setParameterPattern(effectiveParameterPattern);

        var logInfo = new StringBuilder("types: ");
        if(types != null && !types.isEmpty()) {
            types.forEach(queryBuilder::addObjectTypeName);
            logInfo.append(types);
        }

        logInfo.append("; limit: ");
        if (limit != null && limit >= 0) {
            logInfo.append(limit);
            queryBuilder.setLimit(limit);
        }

        var query = queryBuilder.build();
        List<String> result = evo.tagNames(query);
        if (skipFolders) {
            result = result
                    .stream()
                    .filter(name -> evo.findTag(name).getValueType() != TagValueType.FOLDER)
                    .toList();
            logInfo.append("; skipFolders: ");
        }

        if (normalized.getValue() != Attributes.Value) {
            result = result.stream().map(s -> s + ":" + normalized.getValue()).toList();
        }

        log.info(
                "tagNames: time={}ms, records={}, info={}",
                System.currentTimeMillis() - start,
                result.size(),
                logInfo
        );
        return result;
    }


    @CacheEvict(value = {"tagNamesV2"}, allEntries = true)
    @Scheduled(fixedDelayString = "${tn-scada.hmi-backend.cache.tag-names.evict-interval:60000}")
    public void clearCache() {
    }
}



