package tnt.tnscada.hmi.hotlink;

import lombok.extern.slf4j.Slf4j;
import org.apache.commons.lang3.StringUtils;
import tnt.tnscada.core.message.protobuf.HmiMsg;
import tnt.tnscada.hmi.hotlink.dto.AnswerItem;
import tnt.tnscada.hmi.hotlink.dto.TagSetRequest;

import java.time.Instant;
import java.util.Collection;
import java.util.stream.Collectors;

/**
 * Логирование всех входящих и исходящих WebSocket сообщений v1 и v2.
 * - При уровне DEBUG в логах отображаются время, ID, тип сообщения и общая информация о теле (summary).
 * - При уровне TRACE в логах отображается полное тело сообщения.
 * Во всех методах проверяется доступность требуемого уровня логирования перед выполнением вычислений.
 */
@Slf4j
public final class HotlinkMessageLogger {

    private HotlinkMessageLogger() {
    }

    public static boolean isLoggingEnabled() {
        return log.isDebugEnabled() || log.isTraceEnabled();
    }

    public static void logIncoming(int version, String sessionId, String msgId, String msgType, String bodySummary, String fullPayload) {
        if (!isLoggingEnabled()) {
            return;
        }
        String time = Instant.now().toString();
        String idStr = formatId(sessionId, msgId);
        String summary = StringUtils.isNotEmpty(bodySummary) ? bodySummary : "none";

        if (log.isTraceEnabled()) {
            log.trace("Hotlink IN [v{}]: time={}, id={}, type={}, summary={}, body={}", version, time, idStr, msgType, summary, fullPayload);
        } else if (log.isDebugEnabled()) {
            log.debug("Hotlink IN [v{}]: time={}, id={}, type={}, summary={}", version, time, idStr, msgType, summary);
        }
    }

    public static void logOutgoing(int version, String sessionId, String msgId, String msgType, String bodySummary, String fullPayload) {
        if (!isLoggingEnabled()) {
            return;
        }
        String time = Instant.now().toString();
        String type = StringUtils.isNotEmpty(msgType) ? msgType : inferMessageType(fullPayload);
        String id = StringUtils.isNotEmpty(msgId) ? msgId : inferMsgId(fullPayload);
        String idStr = formatId(sessionId, id);
        String summary = StringUtils.isNotEmpty(bodySummary) ? bodySummary : inferSummary(fullPayload, type);

        if (log.isTraceEnabled()) {
            log.trace("Hotlink OUT [v{}]: time={}, id={}, type={}, summary={}, body={}", version, time, idStr, type, summary, fullPayload);
        } else if (log.isDebugEnabled()) {
            log.debug("Hotlink OUT [v{}]: time={}, id={}, type={}, summary={}", version, time, idStr, type, summary);
        }
    }

    public static String formatId(String sessionId, String msgId) {
        if (StringUtils.isNotEmpty(msgId)) {
            return String.format("[msgId=%s, sessionId=%s]", msgId, sessionId);
        }
        return String.format("[sessionId=%s]", sessionId);
    }

    public static String summarizeCollection(Collection<?> items, int maxItems) {
        if (items == null || items.isEmpty()) {
            return "[]";
        }
        var sample = items.stream().limit(maxItems).map(Object::toString).collect(Collectors.joining(", "));
        if (items.size() > maxItems) {
            return "[" + sample + ", ... (" + items.size() + " total)]";
        }
        return "[" + sample + "]";
    }

    public static String summarizeAnswerItems(Collection<AnswerItem> collection) {
        if (collection == null || collection.isEmpty()) {
            return "itemsCount=0";
        }
        var tagsSample = collection.stream()
                .filter(item -> item != null && item.getTag() != null)
                .limit(3)
                .map(AnswerItem::getTag)
                .collect(Collectors.joining(", "));
        return String.format("itemsCount=%d, tagsSample=[%s%s]",
                collection.size(), tagsSample, collection.size() > 3 ? ", ..." : "");
    }

    public static String summarizeTagValueMsgs(Collection<HmiMsg.TagValueMsg> collection) {
        if (collection == null || collection.isEmpty()) {
            return "itemsCount=0";
        }
        var tagsSample = collection.stream()
                .filter(msg -> msg != null && msg.getTag() != null)
                .limit(3)
                .map(HmiMsg.TagValueMsg::getTag)
                .collect(Collectors.joining(", "));
        return String.format("itemsCount=%d, tagsSample=[%s%s]",
                collection.size(), tagsSample, collection.size() > 3 ? ", ..." : "");
    }

    public static String summarizeTagSetRequests(Collection<TagSetRequest> items) {
        if (items == null || items.isEmpty()) {
            return "itemsCount=0";
        }
        var tagsSample = items.stream()
                .filter(req -> req != null && req.getTag() != null)
                .limit(3)
                .map(TagSetRequest::getTag)
                .collect(Collectors.joining(", "));
        return String.format("itemsCount=%d, tagsSample=[%s%s]",
                items.size(), tagsSample, items.size() > 3 ? ", ..." : "");
    }

    public static String summarizeCallResult(Object data) {
        if (data == null) {
            return "null";
        }
        if (data instanceof Collection<?> c) {
            return "itemsCount=" + c.size() + ", sample=" + summarizeCollection(c, 3);
        }
        if (data instanceof Boolean || data instanceof Number || data instanceof String) {
            return String.valueOf(data);
        }
        return "type=" + data.getClass().getSimpleName();
    }

    private static String inferMessageType(String msg) {
        if (StringUtils.isEmpty(msg)) {
            return "EMPTY";
        }
        if (msg.startsWith("Are you alive?")) {
            return "HEARTBEAT";
        }
        int idx = msg.indexOf("\"message_type\"");
        if (idx >= 0) {
            int colon = msg.indexOf(':', idx);
            if (colon >= 0) {
                int quote1 = msg.indexOf('"', colon);
                if (quote1 >= 0) {
                    int quote2 = msg.indexOf('"', quote1 + 1);
                    if (quote2 >= 0) {
                        return msg.substring(quote1 + 1, quote2);
                    }
                }
            }
        }
        if (msg.contains("\"tagValueBatch\"")) {
            return "TAG_VALUE_BATCH";
        }
        return "UNKNOWN";
    }

    private static String inferMsgId(String msg) {
        if (StringUtils.isEmpty(msg)) {
            return null;
        }
        int idx = msg.indexOf("\"id\"");
        if (idx >= 0) {
            int colon = msg.indexOf(':', idx);
            if (colon >= 0) {
                int quote1 = msg.indexOf('"', colon);
                if (quote1 >= 0) {
                    int quote2 = msg.indexOf('"', quote1 + 1);
                    if (quote2 >= 0) {
                        return msg.substring(quote1 + 1, quote2);
                    }
                }
            }
        }
        int pingIdx = msg.indexOf("\"pingId\"");
        if (pingIdx >= 0) {
            int colon = msg.indexOf(':', pingIdx);
            if (colon >= 0) {
                int quote1 = msg.indexOf('"', colon);
                if (quote1 >= 0) {
                    int quote2 = msg.indexOf('"', quote1 + 1);
                    if (quote2 >= 0) {
                        return msg.substring(quote1 + 1, quote2);
                    }
                }
            }
        }
        return null;
    }

    private static String inferSummary(String msg, String msgType) {
        if (StringUtils.isEmpty(msg)) {
            return "empty";
        }
        if ("HEARTBEAT".equals(msgType)) {
            return "heartbeat";
        }
        return "length=" + msg.length();
    }
}



