        let isLive = historyDataState.finish.getTime() > new Date().getTime();
        let isLiveText = isLive?"<b>Окончание интервала в будущем</b>":"";
        let canFetch = isLive || !historyDataState.loadedAll;
        document.getElementById("historyDataLoadPart").disabled = !canFetch;
        document.getElementById("historyDataExport").disabled = false;
        document.getElementById("historyDataState").innerHTML = `Интервал с <b>${dateToReadable(historyDataState.start)}</b>
 по <b>${dateToReadable(historyDataState.finish)}</b>;
 Шаг получения данных <b>${plural(historyDataState.step, ["запись", "записи", "записей"])}</b>;
 Запрос для <b>${plural(historyDataState.tags.length, ["тега", "тегов", "тегов"])}</b>;
 В интервале ${Date.daysBetween(historyDataState.start, historyDataState.finish)};
${isLiveText}`;


        let chunksCountToShow = 3;
        let lastInitiatedChunksNum = historyDataState.loadedDataByChunks.length - 1;
        let dropChunksTillNum = lastInitiatedChunksNum - chunksCountToShow;

        let tbl = document.createElement('table');
        const headersRow = tbl.createTHead().insertRow();
        headersRow.insertCell().innerHTML = "Тег";
        headersRow.insertCell().innerHTML = "Значение";
        headersRow.insertCell().innerHTML = "Невалидно";
        headersRow.insertCell().innerHTML = "Качество";
        headersRow.insertCell().innerHTML = "Timestamp";
        headersRow.insertCell().innerHTML = "Timestamp second";
        headersRow.insertCell().innerHTML = "Timestamp history";
        headersRow.insertCell().innerHTML = "Смещение";
        headersRow.insertCell().innerHTML = "Сервис";

        let tbody = tbl.createTBody();
        let droppedChunksCount = 0;
        for (const chunkNum in historyDataState.loadedDataByChunks) {
            if (chunkNum <= dropChunksTillNum) {
                historyDataState.loadedDataByChunks[chunkNum] = [];
                droppedChunksCount++;
                continue;
            } else {
                if (droppedChunksCount > 0) {
                    let row = tbody.insertRow();
                    let reportCell = row.insertCell();
                    reportCell.colSpan = headersRow.cells.length;
                    reportCell.innerHTML = `Выгрузили из памяти ${plural(droppedChunksCount, ["порцию", "порции", "порций"])} данных на ${plural(droppedChunksCount*historyDataState.step, ["строку", "строки", "строк"])}`
                    droppedChunksCount = 0;
                }
            }
            for (const recordId in historyDataState.loadedDataByChunks[chunkNum]) {
                let record = historyDataState.loadedDataByChunks[chunkNum][recordId];
                let row = tbody.insertRow();
                row.insertCell().innerHTML = record.n;
                row.insertCell().innerHTML = record.v;
                row.insertCell().innerHTML = !!record.i?"<span class='errVal'>Да</span>":" - ";
                row.insertCell().innerHTML = record.q;
                row.insertCell().innerHTML = timestampToReadable(record.t);
                row.insertCell().innerHTML = timestampToReadable(record.t2);
                row.insertCell().innerHTML = timestampToReadable(record.t3);
                row.insertCell().innerHTML = record.o;
                row.insertCell().innerHTML = record.s==null?" - ":record.s;
            }
        }
        let rowFloor = tbody.insertRow();
        let reportCellFloor = rowFloor.insertCell();
        reportCellFloor.colSpan = headersRow.cells.length;
        reportCellFloor.innerHTML = `Получено: ${plural(historyDataState.loadedDataByChunks.length, ["порция", "порции", "порций"])}, ${historyDataState.loadedAll?"всё получено":"ещё не конец"};
${isLiveText}`


        let elem = document.getElementById("historyDataOutput");
        elem.innerHTML = "";
        elem.appendChild(tbl);

