import java.util.concurrent.ScheduledFuture;
import java.util.concurrent.TimeUnit;

@Service
public class Minuteman {
    private final HotlinkWebSocketHandler hotlinkHandler;
    private final HotlinkWebSocketHandlerV2 hotlinkHandlerV2;
    private final int INTERVAL_S = 30;
    private final ScheduledExecutorService executor = Executors.newScheduledThreadPool(1);
    public Minuteman(HotlinkWebSocketHandler hotlinkHandler, HotlinkWebSocketHandlerV2 hotlinkHandlerV2) {
        this.hotlinkHandler = hotlinkHandler;
        this.hotlinkHandlerV2 = hotlinkHandlerV2;
        ScheduledFuture<?> future = executor.scheduleWithFixedDelay(() -> perform(),
                0, INTERVAL_S, TimeUnit.SECONDS);
    }

    private void perform() {
        hotlinkHandler.wakeUpStaleSessions();
        hotlinkHandlerV2.wakeUpStaleSessions();
        hotlinkHandler.killStaleSessions();
        hotlinkHandlerV2.killStaleSessions();
    }
}



