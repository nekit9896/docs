        this.kafkaManagerProperties.setSender(kafkaManagerProperties.getSender());
        this.kafkaManagerProperties.setAlarm(kafkaManagerProperties.getAlarm());
        var listenerProps  = new KafkaManagerProperties.ListenerProperties();
        listenerProps.setGroupId(kafkaManagerProperties.getListener().getGroupId());
        listenerProps.setCompactEnabled(false);
        listenerProps.setSeekToEnd(false);
        this.kafkaManagerProperties.setListener(listenerProps);
    }

    public Evo getEvo(SessionToServiceDTO dto) {
        if (!multitoneEvo.containsKey(dto.getSessionId())) {
            log.info("Не нашли сущность EvoCore для модельной сессии {}", dto.getSessionId());
        }
        return multitoneEvo.computeIfAbsent(dto.getSessionId(), sId -> initEvoForModelSession(dto)).getFirst();
    }

    private Pair<Evo, Runnable> initEvoForModelSession(SessionToServiceDTO dto) {
        var modelSessionId = dto.getSessionId();
        log.info("Создаём новую сущность EvoCore для модельной сессии {}", modelSessionId);
        String sessionTopicValue = dto.getValueTopic();
        String sessionTopicAlarm = dto.getAlarmTopic();
        var producer = producerFactory.copyWithConfigurationOverride(Map.of()).createProducer();
        var kafkaTnMsgSender = new ModellingKafkaTnMsgSender(
                sessionTopicValue, producer, false);
        var kafkaManager = new KafkaManager(kafkaListenerContainerFactory, kafkaTnMsgSender, kafkaManagerProperties);
        var kafkaServiceForValue = new KafkaServiceImpl(kafkaManager);
        var lastValueService = new FlatLastValueServiceImpl();
        var valueSubscriptionManager = new KafkaSubscriptionManager<>(
                k -> k,
                tags -> Set.of(sessionTopicValue),
                true,
                kafkaServiceForValue,
                lastValueService,
                tagInfoStore,
                0,
                List.of(sessionTopicValue),
                false
        );

        AlarmKafkaService alarmKafkaService = getAlarmKafkaService();
        var lastAlarmService = new FlatLastValueServiceImpl();
        var alarmSubscriptionManager = new KafkaSubscriptionManager<>(
                k -> k,
                ignored -> {
                    return Set.of(sessionTopicAlarm);
                },
                false,
                alarmKafkaService,
                lastAlarmService,
                tagInfoStore,
                evoManagerProperties.getSubscription().getTopicUnsubscribeDelay(),
                evoManagerProperties.getAlarmSubscription().isPreSubscribe() ? List.of(sessionTopicAlarm) : List.of(),
                false
        );

        DirectOutputService dosForValue = getDirectOutputServiceForValue(kafkaServiceForValue);
        var evoCore = new EvoCore(
                //версия с переопределением топика
                valueSubscriptionManager,
                //версия с переопределением топика
                alarmSubscriptionManager,
                //версия с переопределением топика
                dosForValue,
                lastValueService,
                //Скорее всего не потребуется для ближайших задач
                new DataManagerMetadataWrapper(new MockedDataManagerService(new MockedTagInfoStore()), metadataService),
                //Лазить в иторию из истории - отчасти необязательная фича для Алгоритмов, или для плеера в плеере, что тоже пока не требуется
                new MockedValueHistoryService(1000),
                new MockedAlarmHistoryService(),
                //Нужен будет тот, кто сможет по-особому общаться с аларм-сервисом
                new MockAlarmService(),
                environment,
                consensusService,
                //версия с переопределением топика
                dosForValue,
                new MockEvoHealth()
        );
        return Pair.of(new EvoCoreDelegated(evoCore, dto), () -> {
            log.info("Освобождаем ресурсы сессии [{}]", modelSessionId);
            var totalSteps = 5;
            var step = 0;
            log.info("[{}] {}/{}  directOutputService", modelSessionId, ++step, totalSteps);
            dosForValue.stop();
            log.info("[{}] {}/{}  valueSubscriptionManager", modelSessionId, ++step, totalSteps);
            valueSubscriptionManager.destroy();
            log.info("[{}] {}/{}  kafkaService", modelSessionId, ++step, totalSteps);
            kafkaServiceForValue.stopListener(sessionTopicValue);
            kafkaServiceForValue.stopLastValueListener(sessionTopicValue);
            log.info("[{}] {}/{}  kafkaTnMsgSender", modelSessionId, ++step, totalSteps);
            kafkaTnMsgSender.destroy();
            log.info("[{}] {}/{}  producer", modelSessionId, ++step, totalSteps);
            producer.close(Duration.ofSeconds(0));
            log.info("Освободили ресурсы сессии [{}]", modelSessionId);
        });
    }

    @NotNull
    private AlarmKafkaService getAlarmKafkaService() {
        var alarmKafkaManager = new AlarmKafkaManager(kafkaAlarmListenerContainerFactory, kafkaManagerProperties);
        var alarmKafkaService = new AlarmKafkaService(alarmKafkaManager);
        return alarmKafkaService;
    }

    @NotNull
    private DirectOutputService getDirectOutputServiceForValue(KafkaServiceImpl kafkaServiceForValue) {
        var kafkaSender = new KafkaSender(kafkaServiceForValue);
        var dos = new DirectOutputService(meterRegistry, List.of(kafkaSender), this.defaultWriteErrorStrategy, this.retryInterval);
        return dos;
    }


    public Set<Long> getExistingSessionIds() {
