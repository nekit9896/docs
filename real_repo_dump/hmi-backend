public class TagValueUtils {

    public static boolean tagValueEqual(HmiMsg.TagValueMsg a, HmiMsg.TagValueMsg b) {
        if (!a.getTag().equals(b.getTag())) {}
        else if (a.getValue().getInvalid() != b.getValue().getInvalid()) {}
        else if (TagValueUtils.valueEqual(a.getValue(), b.getValue())) {
            return true;
        }
        return false;
    }

    private static boolean valueEqual(TnMsg.ValueMsg a, TnMsg.ValueMsg b) {
        if (a.getValueCase() != b.getValueCase()) {
            return false;
        }
        return switch (a.getValueCase()) {
            case VALUE_NOT_SET -> true;

            case INTVAR -> Objects.equals(a.getIntVar(), b.getIntVar());
            case BOOLVAR -> Objects.equals(a.getBoolVar(), b.getBoolVar());
            case STRINGVAR -> Objects.equals(a.getStringVar(), b.getStringVar());
            case LONGVAR -> Objects.equals(a.getLongVar(), b.getLongVar());
            case TIMEVAR -> Objects.equals(a.getTimeVar(), b.getTimeVar());
            case BYTESVAR -> Objects.equals(a.getBytesVar(), b.getBytesVar());

            case DOUBLEVAR -> Double.compare(a.getDoubleVar(), b.getDoubleVar()) == 0;
            case FLOATVAR -> Float.compare(a.getFloatVar(), b.getFloatVar()) == 0;

            case DYNINTVAR -> Objects.equals(a.getDynIntVar(), b.getDynIntVar());
            case DYNBOOLVAR -> Objects.equals(a.getDynBoolVar(), b.getDynBoolVar());
            case DYNLONGVAR -> Objects.equals(a.getDynLongVar(), b.getDynLongVar());
            case DYNTIMEVAR -> Objects.equals(a.getDynTimeVar(), b.getDynTimeVar());
            case DYNBYTESVAR -> Objects.equals(a.getDynBytesVar(), b.getDynBytesVar());
            case DYNSTRINGVAR -> Objects.equals(a.getDynStringVar(), b.getDynStringVar());

            case DYNDOUBLEVAR -> Objects.equals(a.getDynDoubleVar(), b.getDynDoubleVar());
            case DYNFLOATVAR -> Objects.equals(a.getDynFloatVar(), b.getDynFloatVar());

            default -> {
                log.warn("Тип данных не поддерживается: " + a.getValueCase());
                yield false;
            }
        };
    }

    public static boolean isPlotable(TagValueType a) {
        return switch (a) {
            case FLOAT, INT, DOUBLE, BOOL, LONG  -> true;
            default -> false;
        };
    }

    public static HmiMsg.TagValueMsg mapToHmiTagValueMsg(TagValue tagValue) {
        TnMsg.Msg msg = ((ProtoTagValueImpl) tagValue).getMsg();
        if (msg == null) {
            return getEmptyHmiTagValueMsg(tagValue.getTag().getTagName());
        } else {
            TnMsg.ValueMsg valueMessage = msg.getValueMsg();
            var tagValueMsgBuilder = HmiMsg.TagValueMsg.newBuilder()
                    .setTs(tagValue.getTimestamp().getTime())
                    .setTs2(tagValue.getSecondTimestamp().getTime())
                    .setTag(tagValue.getTag().getTagName())
                    .setValue(valueMessage);

            if(!tagValue.getService().isBlank()) {
                tagValueMsgBuilder.setService(tagValue.getService());
            }

            if(!tagValue.getUser().isBlank()) {
                tagValueMsgBuilder.setUser(tagValue.getUser());
            }

            return tagValueMsgBuilder.build();
        }
    }

    public static HmiMsg.TagValueMsg getEmptyHmiTagValueMsg(String tagName){
        return HmiMsg.TagValueMsg.newBuilder()
                .setTag(tagName)
                .setValue(TnMsg.ValueMsg.newBuilder().setInvalid(true))
                .build();
    }

    public static TagValue toTagValue(Tag tag, TnMsg.Msg msg) {
        return new ProtoTagValueImpl((TagImpl) tag, msg);
    }
}



