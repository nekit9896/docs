package tnt.tnscada.hmi.modelling;

import java.time.Instant;
import java.util.Date;
import java.util.concurrent.atomic.AtomicReference;

import lombok.experimental.Delegate;
import lombok.extern.slf4j.Slf4j;
import tnt.evoscada.api.Evo;
import tnt.evoscada.api.data.TagValue;
import tnt.evoscada.api.dto.AlarmDto;
import tnt.evoscada.manager.data.ProtoTagValueImpl;
import tnt.evoscada.manager.data.TagImpl;
import tnt.tnscada.hmi.modelling.dto.SessionToServiceDTO;
import tnt.tnscada.hmi.errors.ApplicationLogicException;

@Slf4j
public class EvoCoreDelegated implements Evo {
    @Delegate
    private final Evo evoCore;
    private final AtomicReference<Instant> wallclockRef = new AtomicReference<>();
    private Instant startMark;
    private boolean writeAllowed;

    public EvoCoreDelegated(Evo evoCore, SessionToServiceDTO dto) {
        startMark = dto.getStartTime().toInstant().minusSeconds(1);
        wallclockRef.set(startMark);
        this.evoCore = evoCore;
        this.writeAllowed = !dto.getMode().toLowerCase().contains("histor");
        if (dto.getTimeTag() != null && !dto.getTimeTag().isEmpty()) {
            try {
                evoCore.tagSubscribe((tagValues -> {
                    tagValues.forEach(tv -> updateWallclock(tv.getTimestamp().toInstant()));
                }), true, findTag(dto.getTimeTag()));
            } catch (Exception e) {
                throw new ApplicationLogicException("Не удалось подписаться на сигнал рассылки времени плеера сессии " + dto.getTimeTag() +": "
                        + e.getMessage());
            }
        }
    }

    public Instant getWallclock() {
        return wallclockRef.get();
    }

    public void updateWallclock(Instant time) {
        wallclockRef.set(time);
    }

    @Override
    public void tagSet(TagValue tagValue, boolean forceSet) {
        if (!writeAllowed) {
            throw new ApplicationLogicException("Сессия в режиме только для чтения");
        }
        var tagValueImpl = (ProtoTagValueImpl) tagValue;
        var msgData =  tagValueImpl.getMsg().getMsgData();
        TagValue updated = new ProtoTagValueImpl((TagImpl)tagValueImpl.getTag(), tagValueImpl.getMsg().toBuilder().setMsgData(
                msgData.toBuilder().setTimeStamp(getWallclock().toEpochMilli()).build()).build());
        evoCore.tagSet(updated, forceSet);
    }
    @Override
    public void tagSet(String tagName, Object value) {
        tagSet(tagName, value, false);
    }

    @Override
    public void tagSet(String tagName, Object value, boolean invalid) {
        if (!writeAllowed) {
            throw new ApplicationLogicException("Сессия в режиме только для чтения");
        }
        var ts = Date.from(getWallclock());
        evoCore.tagSet(tagName, value, invalid, ts);
    }

    @Override
    public void makeAlarm(AlarmDto alarmDto) {
        if (!writeAllowed) {
            throw new ApplicationLogicException("Сессия в режиме только для чтения");
        }
        var updatedDto = new AlarmDto(alarmDto.getTag(), alarmDto.getAlertClassName(), alarmDto.getText(), alarmDto.getText0(), alarmDto.getValue(),
                Date.from(getWallclock()));
        evoCore.makeAlarm(updatedDto);
    }
}


