    async function getTagListByPattern(objectPattern, parameterPattern, limit, types) {
        console.log(objectPattern, parameterPattern);

        const params = new URLSearchParams();
        if(objectPattern !== undefined && objectPattern !== null && objectPattern !== '') {
            params.append("objectPattern", objectPattern);
        }
        if(parameterPattern !== undefined && parameterPattern !== null && parameterPattern !== '') {
            params.append("parameterPattern", parameterPattern);
        }
        if(limit !== undefined && limit !== null && limit > 0) {
            params.append("limit", limit);
        }
        if(types !== undefined && types !== null && types !== '') {
            params.append("types", types);
        }

        let url = `${wsUrl.value}/v2/tag-names`;
        if([...params].length > 0) {
            url += `?${params.toString()}`;
        }

        let tags = await fetch(url, {
            method: 'GET',
            headers: getHeadersObject()
        })
            .then(response => response.json())
            .then(tags => {
                tags.sort();
                return tags;
            })
            .catch(reason => {
                console.log(reason);
                let elem = document.getElementById("query");
                elem.title = reason;
                elem.classList.add("errVal");
            });

        if (tags === undefined) {
            let elem = document.getElementById("query");
            let msg = "Не удалось получить ответ по адресу "+url;
            elem.title = msg;
            elem.classList.add("errVal");
            throw new Error(msg);
        } else {
            let elem = document.getElementById("query");
            elem.title = "";
            elem.classList.remove("errVal");
        }

        return tags;
    }

