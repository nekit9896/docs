                let record = historyDataState.loadedDataByChunks[chunkNum][recordId];
                rows.push([record.n,record.v,
                    !!record.i?true:'',record.q,
                    timestampToExport(record.t),timestampToExport(record.t2),timestampToExport(record.t3),
                    record.o,record.s==null?"":record.s]);
            }
