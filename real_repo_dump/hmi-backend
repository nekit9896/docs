 */
@Slf4j
public class HotlinkSession extends HotlinkSessionBase<HmiMsg.TagValueMsg> {
    private final static String CMD_SUBSCRIBE = "SUBSCRIBE ";
    private final static String CMD_UNSUBSCRIBE = "UNSUBSCRIBE ";
    private final static String CMD_UNSUBSCRIBE_ALL = "UNSUBSCRIBE_ALL";
    private final static String CMD_STREAM_SWITCH_HISTORY = "STREAM SWITCH HISTORY";
    private final static String CMD_STREAM_SWITCH_LIVE = "STREAM SWITCH LIVE";
    private final static String CMD_MILLIS_PER_TICK = "MILLIS PER TICK";
    private final static String CMD_SEEK = "SEEK";
    private final static String CMD_CONTROL_OTHER_HISTORY  = "CONTROL OTHER HISTORY";
    private final static String CMD_PING  = "PING";

    private Map<String, AtomicLong> commandsCount = new HashMap<>();

    public HotlinkSession(
            WebSocketSession webSocketSession,
            Evo evo,
            Integer sampleTime) {
        super(webSocketSession, evo, sampleTime);
